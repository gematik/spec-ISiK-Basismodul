import re
from collections import defaultdict

# This script highlights duplicate ANF-CON tags in a markdown file and saves the output to a new file. It is used for the ISiK Connect IG

def highlight_anf_duplicates(input_file, output_file):
    # Read input markdown
    with open(input_file, 'r', encoding='utf-8') as f:
        markdown_text = f.read()

    # Regex pattern: ANF-CON-<number>
    pattern = r'\bANF-CON-\d+\b'
    matches = re.findall(pattern, markdown_text)

    # Count occurrences
    count_map = defaultdict(int)
    for match in matches:
        count_map[match] += 1

    # Get duplicates
    duplicates = {item for item, count in count_map.items() if count > 1}

    # Report
    if duplicates:
        print("🔁 Duplicate ANF-CON tags found:")
        for dup in duplicates:
            print(f" - {dup}")
    else:
        print("✅ all ok - no duplicates")

    # Highlight duplicates in output
    def replacer(match):
        word = match.group(0)
        if word in duplicates:
            return f'=={word}=='
        return word

    highlighted_text = re.sub(pattern, replacer, markdown_text)

    with open(output_file, 'w', encoding='utf-8') as f:
        f.write(highlighted_text)

    print(f"\n📄 Highlighted output saved to: {output_file}")

# Example usage
if __name__ == "__main__":
    input_path = "ImplementationGuide\markdown\Anforderungsuebersicht.md"
    output_path = "highlighted_output.md"
    highlight_anf_duplicates(input_path, output_path)
