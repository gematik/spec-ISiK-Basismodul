        "path": "Procedure.performed[x]",
        "sliceName": "performedDateTime",
        "definition": "Durchführungsdatum der Prozedur.",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "dateTime"
          }
        ]
      },
      {
        "id": "Procedure.performed[x]:performedPeriod",
        "path": "Procedure.performed[x]",
        "sliceName": "performedPeriod",
        "short": "Durchführungszeitraum",
