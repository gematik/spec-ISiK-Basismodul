  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "Location" ] ;
       fhir:path [ fhir:v "Location" ]
     ] [
       fhir:id [ fhir:v "Location.id" ] ;
       fhir:path [ fhir:v "Location.id" ] ;
       fhir:short [ fhir:v "serverseitige, interne ID des Datensatzes" ] ;
       fhir:comment [ fhir:v "**bedingtes Pflichtfeld/bedingtes MS:** Alle von einem Server bereitgestellten Ressourcen MÜSSEN über eine `id` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `id`verfügen. " ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Location.meta.versionId" ] ;
       fhir:path [ fhir:v "Location.meta.versionId" ] ;
       fhir:short [ fhir:v "Eindeutiger Name der serverseitigen Version des Datensatzes" ] ;
       fhir:comment [ fhir:v "Alle von einem Server bereitgestellten Ressourcen SOLLEN über eine `versionID` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `versionID`verfügen. " ]
     ] [
       fhir:id [ fhir:v "Location.meta.lastUpdated" ] ;
       fhir:path [ fhir:v "Location.meta.lastUpdated" ] ;
       fhir:short [ fhir:v "Zeitpunkt der letzten Änderung" ] ;
       fhir:comment [ fhir:v "Alle von einem Server bereitgestellten Ressourcen SOLLEN über ein `lastUpdate` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über ein `lastUpdate`verfügen. " ]
     ] [
       fhir:id [ fhir:v "Location.identifier" ] ;
       fhir:path [ fhir:v "Location.identifier" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "pattern" ] ;
           fhir:path [ fhir:v "$this" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:short [ fhir:v "Eindeutiger Identifier des Standorts" ] ;
       fhir:comment [ fhir:v "Motivation: entspricht https://simplifier.net/medizininformatikinitiative-modulstrukturdaten/sd_mii_struktur_location" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Location.identifier:standortnummer-dkg" ] ;
       fhir:path [ fhir:v "Location.identifier" ] ;
       fhir:sliceName [ fhir:v "standortnummer-dkg" ] ;
       fhir:short [ fhir:v "Standortnummer nach DKG" ] ;
       fhir:comment [ fhir:v "Motivation : Entsprechend der Festlegung der DKG laut Basisprofile-DE 1.5.0 (https://simplifier.net/packages/de.basisprofil.r4/) " ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Identifier"^^xsd:anyURI ;
           fhir:l fhir:Identifier
         ] ;
         fhir:profile ( [
           fhir:v "http://fhir.de/StructureDefinition/identifier-standortnummer"^^xsd:anyURI ;
           fhir:l <http://fhir.de/StructureDefinition/identifier-standortnummer>
         ] )
       ] ) ;
       fhir:pattern [
         a fhir:Identifier ;
         fhir:system [
           fhir:v "http://fhir.de/sid/dkgev/standortnummer"^^xsd:anyURI ;
           fhir:l <http://fhir.de/sid/dkgev/standortnummer>
         ]
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Location.name" ] ;
       fhir:path [ fhir:v "Location.name" ] ;
       fhir:short [ fhir:v "Name des Standort" ] ;
       fhir:comment [ fhir:v "Motivation: Kein Name zwingend notwendig (z.B. für ein Zimmer), wenn über .identifier identifizierbar; weicht daher ab von https://simplifier.net/medizininformatikinitiative-modulstrukturdaten/sd_mii_struktur_location" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Location.mode" ] ;
       fhir:path [ fhir:v "Location.mode" ] ;
       fhir:short [ fhir:v "Modus des Standorts" ] ;
       fhir:comment [ fhir:v "Motivation: Die Einschränkung auf \"instance\" erfolgt, da im  ISiK-Kontext ausschließlich konkrete Standorte übertragen werden sollen. Hiermit wird zusätzlich die Kompatibilität zur MII-Spezifikation eines Standortes gewahrt https://simplifier.net/medizininformatikinitiative-modulstrukturdaten/sd_mii_struktur_location" ] ;
       fhir:pattern [
         a fhir:Code ;
         fhir:v "instance"
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Location.type" ] ;
       fhir:path [ fhir:v "Location.type" ] ;
       fhir:short [ fhir:v "Typ des Standorts" ] ;
       fhir:comment [ fhir:v "Motivation: Ein System muss den Typ eines Standorts zum Abruf bereitstellen, sofern diese Information verfügbar ist." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Location.address" ] ;
       fhir:path [ fhir:v "Location.address" ] ;
       fhir:short [ fhir:v "Adresse des Standorts" ] ;
       fhir:comment [ fhir:v "Motivation: Bei Verfügbarkeit einer Adresse muss ein System diese Information bereitstellen. Darüber hinaus muss das abrufende System diese Information verarbeiten können." ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Address"^^xsd:anyURI ;
           fhir:l fhir:Address
         ] ;
         fhir:profile ( [
           fhir:v "http://fhir.de/StructureDefinition/address-de-basis"^^xsd:anyURI ;
           fhir:l <http://fhir.de/StructureDefinition/address-de-basis>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Location.physicalType" ] ;
       fhir:path [ fhir:v "Location.physicalType" ] ;
       fhir:short [ fhir:v "Physikalischer Typ des Standorts" ] ;
       fhir:comment [ fhir:v "Motivation: entspricht der MII Vorgabe -  siehe https://simplifier.net/medizininformatikinitiative-modulstrukturdaten/sd_mii_struktur_location. Ein System muss den physikalischen Typ eines Standorts zum Abruf bereitstellen, da ansonsten der Typus des Standorts nicht maschinenlesbar definiert ist." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Location.position" ] ;
       fhir:path [ fhir:v "Location.position" ] ;
       fhir:short [ fhir:v "Geodaten eines Standorts" ] ;
       fhir:comment [ fhir:v "Motivation: Ein System muss die Geodaten eines Standorts zum Abruf bereitstellen, sofern diese Information verfügbar ist." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Location.managingOrganization" ] ;
       fhir:path [ fhir:v "Location.managingOrganization" ] ;
       fhir:short [ fhir:v "Verwaltende Organisation des Standorts" ] ;
       fhir:comment [ fhir:v "Motivation: entspricht https://simplifier.net/medizininformatikinitiative-modulstrukturdaten/sd_mii_struktur_location" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Location.partOf" ] ;
       fhir:path [ fhir:v "Location.partOf" ] ;
       fhir:short [ fhir:v "Organisationale Zugehörigkeit" ] ;
       fhir:comment [ fhir:v "Motivation: Ein System muss die organisationale Zugehörigkeit eines Standorts zum Abruf bereitstellen, sofern diese Information verfügbar ist." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Location.hoursOfOperation" ] ;
       fhir:path [ fhir:v "Location.hoursOfOperation" ] ;
       fhir:short [ fhir:v "Betriebszeiten des Standorts" ] ;
       fhir:comment [ fhir:v "Motivation: Ein System muss die Betriebszeiten eines Standorts zum Abruf bereitstellen, sofern diese Information verfügbar ist." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] )
  ] . # 

