       fhir:path [ fhir:v "MedicationStatement.dateAsserted" ] ;
       fhir:short [ fhir:v "Datum der Feststellung/des Bekanntwerdens der MedikationsInformation" ] ;
       fhir:comment [ fhir:v "Begründung des Must-Support: Nachvollziehbarkeit" ] ;
