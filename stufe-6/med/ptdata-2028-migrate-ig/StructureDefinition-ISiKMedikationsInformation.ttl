  ] ; # 
  fhir:version [ fhir:v "6.0.0-rc"] ; # 
  fhir:name [ fhir:v "ISiKMedikationsInformation"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:experimental [ fhir:v false] ; # 
