     fhir:v "https://gematik.de/fhir/isik/CapabilityStatement/ISiKCapabilityStatementMedikationInformationAkteur"^^xsd:anyURI ;
     fhir:l <https://gematik.de/fhir/isik/CapabilityStatement/ISiKCapabilityStatementMedikationInformationAkteur>
  ] ; # 
  fhir:version [ fhir:v "6.0.0-rc"] ; # 
  fhir:name [ fhir:v "ISiKCapabilityStatementMedikationInformationAkteurExpanded"] ; # 
  fhir:title [ fhir:v "ISiK CapabilityStatement Medikationsinformation Server Akteur (Expanded)"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:date [ fhir:v "2025-12-17"^^xsd:date] ; # 
