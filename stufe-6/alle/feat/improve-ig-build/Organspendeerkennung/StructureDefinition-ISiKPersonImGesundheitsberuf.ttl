       fhir:path [ fhir:v "Practitioner.address.type" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Practitioner.address:Strassenanschrift.line" ] ;
       fhir:path [ fhir:v "Practitioner.address.line" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
