           fhir:l <http://fhir.de/StructureDefinition/identifier-telematik-id>
         ] )
       ] ) ;
       fhir:pattern [
         a fhir:Identifier ;
         fhir:type [
           fhir:coding ( [
             fhir:system [
               fhir:v "http://terminology.hl7.org/CodeSystem/v2-0203"^^xsd:anyURI ;
               fhir:l <http://terminology.hl7.org/CodeSystem/v2-0203>
             ] ;
             fhir:code [ fhir:v "PRN" ]
           ] )
         ]
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Practitioner.identifier:TelematikId.type" ] ;
       fhir:path [ fhir:v "Practitioner.identifier.type" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] [
       fhir:id [ fhir:v "Practitioner.name" ] ;
       fhir:path [ fhir:v "Practitioner.name" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "pattern" ] ;
           fhir:path [ fhir:v "$this" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:comment [ fhir:v "Namen der Person" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Practitioner.name:Name" ] ;
       fhir:path [ fhir:v "Practitioner.name" ] ;
       fhir:sliceName [ fhir:v "Name" ] ;
       fhir:short [ fhir:v "Vollständiger Name" ] ;
       fhir:comment [ fhir:v "Der Name des Arztes MUSS in konkreten Anwendungen angezeigt werden können. Es MUSS nach dem Namen des Arztes gesucht werden können." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
