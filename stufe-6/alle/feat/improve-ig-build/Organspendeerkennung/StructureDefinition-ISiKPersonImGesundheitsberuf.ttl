       fhir:path [ fhir:v "Practitioner.gender" ] ;
       fhir:short [ fhir:v "Ist das Geschlecht des Arztes bekannt, MUSS es bereitgestellt werden. Eine korrekte Kodierung des Geschlechtseintrags 'divers' MUSS per GenderOtherDE-Extension unterstüzt werden." ] ;
       fhir:comment [ fhir:v "Geschlecht der Person" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
