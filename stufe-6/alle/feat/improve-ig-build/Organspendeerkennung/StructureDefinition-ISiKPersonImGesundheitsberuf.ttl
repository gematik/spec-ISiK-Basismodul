       fhir:path [ fhir:v "Practitioner.address" ] ;
       fhir:sliceName [ fhir:v "Strassenanschrift" ] ;
       fhir:short [ fhir:v "Straßenanschrift" ] ;
       fhir:comment [ fhir:v "Ist die Adresse bekannt, unter der ein Arzt erreichbar ist, MUSS sie bereitgestellt werden. Diese kann zur Unterscheidung von Personen herangezogen werden. Die Ausdifferenzierung der Adresse in die Adressbestandteile erfolgt in Hinblick auf eine einheitliche Verwendung von Adressen." ] ;
