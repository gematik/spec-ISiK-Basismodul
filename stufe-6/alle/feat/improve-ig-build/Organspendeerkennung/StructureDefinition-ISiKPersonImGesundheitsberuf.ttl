       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Practitioner.name:Geburtsname.family" ] ;
       fhir:path [ fhir:v "Practitioner.name.family" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] [
       fhir:id [ fhir:v "Practitioner.name:Geburtsname.given" ] ;
       fhir:path [ fhir:v "Practitioner.name.given" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Practitioner.name:Geburtsname.prefix" ] ;
       fhir:path [ fhir:v "Practitioner.name.prefix" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Practitioner.telecom.system" ] ;
       fhir:path [ fhir:v "Practitioner.telecom.system" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] [
       fhir:id [ fhir:v "Practitioner.telecom.value" ] ;
       fhir:path [ fhir:v "Practitioner.telecom.value" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] [
       fhir:id [ fhir:v "Practitioner.address" ] ;
       fhir:path [ fhir:v "Practitioner.address" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "pattern" ] ;
           fhir:path [ fhir:v "$this" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:comment [ fhir:v "In order to differentiate between post box addresses and physical addresses, street names and house numbers, and to add city district names, vendors can opt to support the extensions as suggested in the German Address Base Profile http://fhir.de/StructureDefinition/address-de-basis.\r\nSuch differentiations are however not required within the scope of this specification." ] ;
