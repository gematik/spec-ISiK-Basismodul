       fhir:path [ fhir:v "Practitioner.name.family" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Practitioner.name:Name.given" ] ;
       fhir:path [ fhir:v "Practitioner.name.given" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Practitioner.name:Name.prefix" ] ;
       fhir:path [ fhir:v "Practitioner.name.prefix" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Practitioner.name:Geburtsname" ] ;
       fhir:path [ fhir:v "Practitioner.name" ] ;
       fhir:sliceName [ fhir:v "Geburtsname" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "HumanName"^^xsd:anyURI ;
           fhir:l fhir:HumanName
         ] ;
         fhir:profile ( [
           fhir:v "http://fhir.de/StructureDefinition/humanname-de-basis"^^xsd:anyURI ;
           fhir:l <http://fhir.de/StructureDefinition/humanname-de-basis>
         ] )
       ] ) ;
       fhir:pattern [
         a fhir:HumanName ;
         fhir:use [ fhir:v "maiden" ]
       ]
     ] [
       fhir:id [ fhir:v "Practitioner.name:Geburtsname.use" ] ;
       fhir:path [ fhir:v "Practitioner.name.use" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:fixed [
         a fhir:Code ;
