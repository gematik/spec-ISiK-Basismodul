     ] [
       fhir:id [ fhir:v "Practitioner.identifier:TelematikId" ] ;
       fhir:path [ fhir:v "Practitioner.identifier" ] ;
       fhir:sliceName [ fhir:v "TelematikId" ] ;
       fhir:short [ fhir:v "Telematik-ID" ] ;
       fhir:comment [ fhir:v "**Begründung MS:** Zur Verknüpfung der Patient Instanz mit Diensten der Telematik Infrastruktur SOLL die ID mit angegeben sein." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
