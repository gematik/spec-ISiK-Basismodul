       fhir:path [ fhir:v "Practitioner.address.postalCode" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Practitioner.address:Strassenanschrift.country" ] ;
       fhir:path [ fhir:v "Practitioner.address.country" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Practitioner.address:Postfach" ] ;
       fhir:path [ fhir:v "Practitioner.address" ] ;
       fhir:sliceName [ fhir:v "Postfach" ] ;
       fhir:short [ fhir:v "Postfachanschrift" ] ;
       fhir:comment [ fhir:v "Ist die Postfachadresse bekannt, unter der ein Arzt erreichbar ist, MUSS sie bereitgestellt werden. Diese kann zur Unterscheidung von Personen herangezogen werden. Die Ausdifferenzierung der Adresse in die Adressbestandteile erfolgt in Hinblick auf eine einheitliche Verwendung von Adressen." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "*" ] ;
       fhir:type ( [
