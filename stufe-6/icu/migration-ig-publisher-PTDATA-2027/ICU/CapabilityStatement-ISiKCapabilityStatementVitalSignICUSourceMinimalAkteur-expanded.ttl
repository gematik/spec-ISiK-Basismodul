  fhir:title [ fhir:v "ISiK CapabilityStatement VitalSign ICU Source Minimal Akteur (Expanded)"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:date [ fhir:v "2025-12-17"^^xsd:date] ; # 
