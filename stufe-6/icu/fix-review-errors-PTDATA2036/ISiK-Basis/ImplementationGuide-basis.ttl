         fhir:reference [ fhir:v "StructureDefinition/ISiKStandortRaum" ]
       ] ;
       fhir:name [ fhir:v "ISiKStandortRaum" ] ;
       fhir:description [ fhir:v "Dieses Profil dient der strukturierten Erfassung von Räumen (als Standorten) eines Krankenhauses." ] ;
       fhir:example [
