       ] ;
       fhir:name [ fhir:v "ISiK MedicationStatementReplaces" ] ;
       fhir:description [ fhir:v "Mit dieser Erweiterung kann festgelegt werden, welche vorherige Medikation durch die aktuelle Verordnung ersetzt wird. Sie erleichtert die Nachverfolgung von Therapieänderungen, sorgt für Transparenz im Medikationsprozess." ] ;
       fhir:example [
