       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "DocumentReference.type.coding:KDL.code" ] ;
       fhir:path [ fhir:v "DocumentReference.type.coding.code" ] ;
       fhir:short [ fhir:v "Code" ] ;
       fhir:comment [ fhir:v "Der KDL-Code" ] ;
