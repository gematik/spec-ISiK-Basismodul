     ] [
       fhir:id [ fhir:v "DocumentReference.type.coding:KDL.display" ] ;
       fhir:path [ fhir:v "DocumentReference.type.coding.display" ] ;
       fhir:short [ fhir:v "Anzeigetext" ] ;
       fhir:comment [ fhir:v "Der Anzeigetext zum KDL-Code" ] ;
