  ] ; # 
  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "DocumentReference" ] ;
       fhir:path [ fhir:v "DocumentReference" ]
     ] [
       fhir:id [ fhir:v "DocumentReference.id" ] ;
       fhir:path [ fhir:v "DocumentReference.id" ] ;
       fhir:short [ fhir:v "serverseitige, interne ID des Datensatzes" ] ;
       fhir:comment [ fhir:v "**bedingtes Pflichtfeld/bedingtes MS:** Alle von einem Server bereitgestellten Ressourcen MÜSSEN über eine `id` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `id`verfügen. " ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "DocumentReference.meta.versionId" ] ;
       fhir:path [ fhir:v "DocumentReference.meta.versionId" ] ;
       fhir:short [ fhir:v "Eindeutiger Name der serverseitigen Version des Datensatzes" ] ;
       fhir:comment [ fhir:v "Alle von einem Server bereitgestellten Ressourcen SOLLEN über eine `versionID` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `versionID`verfügen. " ]
     ] [
       fhir:id [ fhir:v "DocumentReference.meta.lastUpdated" ] ;
       fhir:path [ fhir:v "DocumentReference.meta.lastUpdated" ] ;
       fhir:short [ fhir:v "Zeitpunkt der letzten Änderung" ] ;
       fhir:comment [ fhir:v "Alle von einem Server bereitgestellten Ressourcen SOLLEN über ein `lastUpdate` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über ein `lastUpdate`verfügen. " ]
     ] [
       fhir:id [ fhir:v "DocumentReference.masterIdentifier" ] ;
       fhir:path [ fhir:v "DocumentReference.masterIdentifier" ] ;
       fhir:short [ fhir:v "Versionsspezifische OID des Dokumentes" ] ;
       fhir:comment [ fhir:v "**Begründung Must Support:** Die OID ist erforderlich, um die Version des Dokumentes eindeutig zu identifizieren." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "CompositionDocumentReferenceMapping" ] ;
         fhir:map [ fhir:v "Bundle.identifier" ]
       ] )
     ] [
       fhir:id [ fhir:v "DocumentReference.masterIdentifier.system" ] ;
       fhir:path [ fhir:v "DocumentReference.masterIdentifier.system" ] ;
       fhir:short [ fhir:v "Namensraum des Identifiers" ] ;
       fhir:comment [ fhir:v "Bei OIDs und UUIDs ist hier stets der Wert `urn:ietf:rfc:3986` anzugeben. Weitere Hinweise zur AbbildungVerwendung von MasterIdentifiern und deren Abbildung auf FHIR sind [in IHE-ITI](https://profiles.ihe.net/ITI/TF/Volume2/ch-Z.html#z.9-fhir-data-types) zu finden." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "DocumentReference.masterIdentifier.value" ] ;
       fhir:path [ fhir:v "DocumentReference.masterIdentifier.value" ] ;
       fhir:short [ fhir:v "Wert des Identifiers" ] ;
       fhir:comment [ fhir:v "OID mit URI-Präfix &quot;urn:oid:&quot;. Es sei darauf hingewiesen, dass OIDs auf Basis von UUIDs generiert werden können, ohne einen eigenen Namesraum zu beantragen. Zunächst müssen hierzu alle 128 Bit der UUID in einen Integer-Wert umgerechnet werden. Das Ergebnis muss ohne Bindestriche an die Root-OID '2.25' angehängt werden. Siehe [IHE International - Creating Unique IDs - OID and UUID](https://wiki.ihe.net/index.php/Creating_Unique_IDs_-_OID_and_UUID)." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "DocumentReference.identifier" ] ;
       fhir:path [ fhir:v "DocumentReference.identifier" ] ;
       fhir:short [ fhir:v "Identifier des Dokumentes" ] ;
       fhir:comment [ fhir:v "Abweichend zu MHD V4.0.1 ist die Angabe eines Identifiers in ISiK nicht erforderlich.\nEin solcher kann bei Bedarf (z.B. zur Weitergabe des Dokumentes per XDS) erzeugt werden.\n&#13;[Konsens der Arbeitsgruppe vom 12.11.2021]\n\nUpdate für Stufe 3:\nIn MHD 4.2.0 wurde die Verpflichtung zur Angabe eines Identifiers gelockert, das ISiK-Profil ist damit in diesem Punkt wieder kompatibel zu IHE MHD.\n" ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "CompositionDocumentReferenceMapping" ] ;
         fhir:map [ fhir:v "Composition.identifier" ]
       ] )
     ] [
       fhir:id [ fhir:v "DocumentReference.status" ] ;
       fhir:path [ fhir:v "DocumentReference.status" ] ;
       fhir:short [ fhir:v "Status des Dokumentenmetadatensatzes" ] ;
       fhir:comment [ fhir:v "Der Status des Dokumentes wird in DocumentReference.docStatus gesetzt." ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "CompositionDocumentReferenceMapping" ] ;
         fhir:map [ fhir:v "=current" ]
       ] )
     ] [
       fhir:id [ fhir:v "DocumentReference.docStatus" ] ;
       fhir:path [ fhir:v "DocumentReference.docStatus" ] ;
       fhir:short [ fhir:v "Bearbeitungsstatus des Dokumentes" ] ;
       fhir:comment [ fhir:v "Abweichend zu MHD V4.0.1 ist die Verwendung von docStatus im ISiK-Kontext erlaubt. Die Verwendung von docStatus bleibt jedoch optional,\n  da nicht alle Dokumentenerzeugende Systeme einen expliziten Freigabe-Workflow haben. Dokumentenserver müssen jedoch in der Lage sein, den Dokumentenstatus\n (sofern vorhanden) zu persistieren, anzuzeigen und zu reproduzieren.\n  &#13;[Konsens der Arbeitsgruppe vom 10.12.2021]" ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "CompositionDocumentReferenceMapping" ] ;
         fhir:map [ fhir:v "Composition.status" ]
       ] )
     ] [
       fhir:id [ fhir:v "DocumentReference.type" ] ;
       fhir:path [ fhir:v "DocumentReference.type" ] ;
       fhir:short [ fhir:v "Dokumententyp" ] ;
       fhir:comment [ fhir:v "Im ISiK-Kontext ist die Typisierung eines Dokumentes mit Hilfe eines KDL-Codes *und* des IHE-XDS-Type-Codes erforderlich und ein Server MUSS beide Kodierungen bereitstellen - trotz der Kardinalität DocumentReference.type.coding:XDS 0..1 -, jedoch ist der IHE-XDS-Type-Code bei Übermittlung für Clients nicht verpflichtend (s.u. zu XDS).\n  Während KDL-Codes eine feingranulare Dokumentenklassifikation für die gezielte Suche nach medizinischen und Administrativen Dokumenten ermöglichen,\n  sind IHE-XDS-Type-Codes für den einrichtungsübergreifenden Dokumentenaustausch maßgeblich.\n  Der XDS-Type-Code kann mit Hilfe der bereitgestellten [ConceptMaps](https://simplifier.net/kdl/~resources?category=ConceptMap)\n  aus dem KDL-Code ermittelt werden. Weitere Typisierungen (z.B. nach SNOMED oder LOINC) sind uneingeschränkt erlaubt. [Konsens der Arbeitsgruppe vom 18.02.2022]. Im Falle, dass der Code 'UNK' entsprechend der ConceptMap verwendet werden soll, MUSS das System 'http://terminology.hl7.org/CodeSystem/v3-NullFlavor' verwendet werden." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "DocumentReference.type.coding" ] ;
       fhir:path [ fhir:v "DocumentReference.type.coding" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "pattern" ] ;
           fhir:path [ fhir:v "$this" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] [
       fhir:id [ fhir:v "DocumentReference.type.coding:KDL" ] ;
       fhir:path [ fhir:v "DocumentReference.type.coding" ] ;
       fhir:sliceName [ fhir:v "KDL" ] ;
       fhir:short [ fhir:v "Dokumenttyp gem. KDL-Terminologie" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
