       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:valueSet [
           fhir:v "http://ihe-d.de/ValueSets/IHEXDSclassCode"^^xsd:anyURI ;
           fhir:l <http://ihe-d.de/ValueSets/IHEXDSclassCode>
         ]
       ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "CompositionDocumentReferenceMapping" ] ;
         fhir:map [ fhir:v "Composition.category.coding[XDS]" ] ;
         fhir:comment [ fhir:v "Kann mittels Lookup in den KDL->XDS ConceptMaps anhand des KDL-Type-Codes ermittelt werden" ]
       ] )
     ] [
