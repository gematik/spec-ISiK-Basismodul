       fhir:path [ fhir:v "DocumentReference.category.coding.system" ] ;
       fhir:short [ fhir:v "Kodiersystem" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
