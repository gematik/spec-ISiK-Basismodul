       fhir:id [ fhir:v "DocumentReference.subject.reference" ] ;
       fhir:path [ fhir:v "DocumentReference.subject.reference" ] ;
       fhir:short [ fhir:v "Patienten-Link" ] ;
       fhir:comment [ fhir:v "**Bedingtes Pflichtfeld:** Clients und Server sind verpflichtet, Dokumente stets mit einem Bezug zu einem Patienten zu versehen.  \nLeer bleiben darf dieses Element einzig im Kontext der Dokumentenbereitstellung in Verbindung mit der Patientenzuordnung über logische Referenzen, siehe {{pagelink:Dokumentenbereitstellung text:Interaktion:Dokumentenbereitstellung > Herstellung von Patienten- und Encounterkontext > Option 5}}\n\nDie Verlinkung auf eine Patienten-Ressource dient der technischen Zuordnung der Dokumentation zu einem Patienten und ermöglicht wichtige API-Funktionen wie verkettete Suche, (Reverse-)Include etc.\nIm ISik Kontext MUSS die referenzierte Ressource konform zu [ISiKPatient](https://gematik.de/fhir/isik/StructureDefinition/ISiKPatient) sein.\nJenseits von ISiK KÖNNEN weitere Instanzen mit anderen Profilen referenziert werden." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "DocumentReference.subject.identifier" ] ;
       fhir:path [ fhir:v "DocumentReference.subject.identifier" ] ;
       fhir:short [ fhir:v "Patienten-Link (logische Referenz)" ] ;
       fhir:comment [ fhir:v "**Bedingtes Must Support:** Logische Referenzen KÖNNEN als Alternative zur Verlinkung über `reference`genutzt werden. BITTE HINWEISE BEACHTEN: {{pagelink:Dokumentenbereitstellung text:Interaktion:Dokumentenbereitstellung > Herstellung von Patienten- und Encounterkontext > Option 5}}" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "DocumentReference.subject.identifier.system" ] ;
       fhir:path [ fhir:v "DocumentReference.subject.identifier.system" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "DocumentReference.subject.identifier.value" ] ;
       fhir:path [ fhir:v "DocumentReference.subject.identifier.value" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "DocumentReference.date" ] ;
       fhir:path [ fhir:v "DocumentReference.date" ] ;
       fhir:comment [ fhir:v "Abweichend zu MHD V4.0.1 ist die Verwendung von date im ISiK-Kontext nicht verpflichtend.\nDie Motivation für die verbindliche Verwendung von `date` seitens IHE ist nicht nachvollziehbar.\nEin entsprechender Change Request zur Harmonisierung wurde eingereicht. Das Dokumentendatum wird in attachment.creation gesetzt.\n\nUpdate für Stufe 3:\nIn MHD 4.2.0 wurde die Verpflichtung zur Angabe von date gelockert, das ISiK-Profil ist damit in diesem Punkt wieder kompatibel zu IHE MHD.\n" ]
     ] [
       fhir:id [ fhir:v "DocumentReference.author" ] ;
       fhir:path [ fhir:v "DocumentReference.author" ] ;
       fhir:short [ fhir:v "Autor des Dokumentes" ] ;
       fhir:comment [ fhir:v "In dieser Ausbaustufe ist die Nennung des Namens oder Kürzels des Autors ausreichend.\n  Eine darüber hinaus gehende Verlinkung auf einen Practitioner (auflösbar auf dem Server) ist möglich aber nicht erforderlich." ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "CompositionDocumentReferenceMapping" ] ;
         fhir:map [ fhir:v "Composition.author" ]
       ] )
     ] [
       fhir:id [ fhir:v "DocumentReference.author.display" ] ;
       fhir:path [ fhir:v "DocumentReference.author.display" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "DocumentReference.relatesTo" ] ;
       fhir:path [ fhir:v "DocumentReference.relatesTo" ] ;
       fhir:short [ fhir:v "Beziehung zu anderen Dokumenten" ] ;
       fhir:comment [ fhir:v "Inbesondere relevant im Kontext von Updates. Bei inhaltlichen Updates MUSS eine `replaces`-Relation angegeben werden." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "DocumentReference.relatesTo.code" ] ;
       fhir:path [ fhir:v "DocumentReference.relatesTo.code" ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "CompositionDocumentReferenceMapping" ] ;
         fhir:map [ fhir:v "Composition.relatesTo.code" ]
       ] )
     ] [
       fhir:id [ fhir:v "DocumentReference.relatesTo.target" ] ;
       fhir:path [ fhir:v "DocumentReference.relatesTo.target" ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "CompositionDocumentReferenceMapping" ] ;
         fhir:map [ fhir:v "Lookup Composition.relatesTo.targetReference.resolve().identifier" ] ;
         fhir:comment [ fhir:v "Ermittlung der zu ersetzenden DocumentReference anhand des identifiers der referenzierten Composition erforderlich" ]
       ] )
     ] [
       fhir:id [ fhir:v "DocumentReference.description" ] ;
       fhir:path [ fhir:v "DocumentReference.description" ] ;
       fhir:comment [ fhir:v "Optionaler Freitext zur ergänzenden Beschreibung des Dokumentes. Die eigentliche menschenlesbare Bezeichnung des Dokuments zur Anzeige in Benutzeroberflächen sollte in 'content.attachment.title' angegeben werden.\n\nUpdate für Stufe 5:\nAb dieser Stufe ist für die menschenlesbare Bezeichnung des Dokuments das Element `content.attachment.title` zu verwenden. Die bisherige Nutzung von `DocumentReference.description` entfällt zugunsten einer besseren Angleichung an MHD und die ePA-Spezifikation. Implementierungen sollten daher den Titel des Dokuments ausschließlich in `content.attachment.title` angeben.\n\nDas Element 'description' kann weiterhin verwendet werden, um inhaltliche Hinweise zum Dokument, eine knappe Zusammenfassung oder ergänzende Kommentare bereitzustellen." ]
     ] [
       fhir:id [ fhir:v "DocumentReference.securityLabel" ] ;
       fhir:path [ fhir:v "DocumentReference.securityLabel" ] ;
       fhir:short [ fhir:v "Vertraulichkeit" ] ;
       fhir:comment [ fhir:v "Die Bereitstellung der Vertraulichkeitsinformation durch den Ersteller des Dokumentes ist verpflichtend.\nEbenso sind Dokumentenserver verpflichtet, diese Information zu persistieren und bei der Dokumentenabfrage zu reproduzieren.\nDie ISiK-Spezifikation trifft jedoch keine Annahmen darüber, wie sich einzelne Vertraulichkeitsstufen auf die Zugriffsberechtigungen\nverschiedener benutzer auf ein Dokument auswirken. Im ISiK-Kontext ist die Angabe einer der drei Vertraulichkeitsstufen\nN | R | V verpflichtend, jedoch ohne Einschränkung der Verwendung zusätzlicher Vertraulichkeits-Flags.\n&#13;\n\n[Konsens der Arbeitsgruppe vom 12.11.2021]" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:valueSet [
           fhir:v "https://gematik.de/fhir/isik/ValueSet/ISiKConfidentialityCodes"^^xsd:anyURI ;
           fhir:l <https://gematik.de/fhir/isik/ValueSet/ISiKConfidentialityCodes>
         ]
       ]
     ] [
       fhir:id [ fhir:v "DocumentReference.content" ] ;
       fhir:path [ fhir:v "DocumentReference.content" ] ;
       fhir:short [ fhir:v "Beschreibung des Dokumenteninhaltes" ] ;
       fhir:comment [ fhir:v "Die Kardinalität wurde angepasst, um den Vorgaben von IHE MHD zu ensprechen [Änderung im Zuge der Kommentierung Stufe 3]." ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "DocumentReference.content.attachment" ] ;
       fhir:path [ fhir:v "DocumentReference.content.attachment" ] ;
       fhir:short [ fhir:v "Anhang" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "DocumentReference.content.attachment.contentType" ] ;
       fhir:path [ fhir:v "DocumentReference.content.attachment.contentType" ] ;
       fhir:short [ fhir:v "Mimetype des Dokumentes" ] ;
       fhir:comment [ fhir:v "Mimetype (Dateityp) des Dokumentes (z.B. &quot;application/pdf&quot;)" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "CompositionDocumentReferenceMapping" ] ;
         fhir:map [ fhir:v "`application/html` für den extrahierten Narrative, `application/fhir+xml` oder `application/fhir+json` für das Bundle" ]
       ] )
     ] [
       fhir:id [ fhir:v "DocumentReference.content.attachment.language" ] ;
       fhir:path [ fhir:v "DocumentReference.content.attachment.language" ] ;
       fhir:short [ fhir:v "Sprache, in der das Dokument verfasst wurde." ] ;
       fhir:comment [ fhir:v "Kann bei Systemen, die keine Mehrsprachigkeit unterstützen,\n      fest auf &quot;de&quot; oder &quot;de-DE&quot; gesetzt werden." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "CompositionDocumentReferenceMapping" ] ;
         fhir:map [ fhir:v "=de sofern keine abweichende Angabe in Composition.language" ]
       ] )
     ] [
       fhir:id [ fhir:v "DocumentReference.content.attachment.data" ] ;
       fhir:path [ fhir:v "DocumentReference.content.attachment.data" ] ;
       fhir:short [ fhir:v "Base64-codierte Binärdaten" ] ;
       fhir:comment [ fhir:v "Um die Suche nach Dokumenten effizient zu gestalten, dürfen die Dokumente selbst nicht in die DocumentReference eingebettet werden, \n      sondern müssen als separates Datenobjekt referenziert werden.\n\nUpdate für Stufe 3:\nDie Ausnahme bildet die Interaktion &quot;Dokumentenbereitstellung&quot;, \nbei der die Binärdaten des Dokumentes eingebettet in die DocumentReference an den Server übermittelt und dort dann in eine separate \nRessource ausgelagert und über Attachment.url referenziert werden.\n\nEs ist zu beachten, dass diese base64-codierten Daten wiederum ein FHIR-Bundle (z.B. ein MIO oder ein ISiK Bericht aus einem Subsystem) repräsentieren können. Um eine einheitliche Handhabung der Dokumente für Clients zu ermöglichen werden diese trotz strukturiertem Inhalt per base64 abgebildet." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "DocumentReference.content.attachment.url" ] ;
       fhir:path [ fhir:v "DocumentReference.content.attachment.url" ] ;
       fhir:short [ fhir:v "Referenz auf Dokument" ] ;
       fhir:comment [ fhir:v "Um die Suche nach Dokumenten effizient zu gestalten, dürfen die Dokumente selbst nicht in die DocumentReference eingebettet werden, \n      sondern müssen als separates Datenobjekt referenziert werden. \n\nWird ein separates Datenobjekt im ISIK-Kontext referenziert, so MUSS dieses konform zum Profil [ISIKBinary](https://gematik.de/fhir/isik/v3/Basismodul/StructureDefinition/ISiKBinary) aus dem Basismodul sein.\n      \nUpdate für Stufe 3:\nDie Ausnahme bildet die Interaktion &quot;Dokumentenbereitstellung&quot;, \nbei der die Binärdaten des Dokumentes eingebettet in die DocumentReference an den Server übermittelt und dort dann in eine separate \nRessource ausgelagert und über Attachment.url referenziert werden." ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "CompositionDocumentReferenceMapping" ] ;
         fhir:map [ fhir:v "vom Server festgelegter Speicherort des Bundles/Narratives" ]
       ] )
     ] [
       fhir:id [ fhir:v "DocumentReference.content.attachment.title" ] ;
       fhir:path [ fhir:v "DocumentReference.content.attachment.title" ] ;
       fhir:short [ fhir:v "Bezeichnung des Dokuments" ] ;
       fhir:comment [ fhir:v "Menschenlesbare Bezeichnung des Dokuments zur Anzeige in Benutzeroberflächen, z.B. als Titel in einer Dokumentenliste ('Lungenfunktionstest vom 18.02.2022').\n\nUpdate für Stufe 5:\nAb dieser Stufe ist für die menschenlesbare Bezeichnung des Dokuments das Element `content.attachment.title` zu verwenden. Die bisherige Nutzung von `DocumentReference.description` entfällt zugunsten einer besseren Angleichung an MHD und die ePA-Spezifikation. Implementierungen sollten daher den Titel des Dokuments ausschließlich in `content.attachment.title` angeben." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "CompositionDocumentReferenceMapping" ] ;
         fhir:map [ fhir:v "Composition.title" ]
       ] )
     ] [
       fhir:id [ fhir:v "DocumentReference.content.attachment.creation" ] ;
       fhir:path [ fhir:v "DocumentReference.content.attachment.creation" ] ;
       fhir:short [ fhir:v "Dokumentendatum" ] ;
       fhir:comment [ fhir:v "Es obliegt dem erzeugenden System, zu entscheiden,\n      welches Datum als Dokumentendatum geeignet ist, z.B. Datum der Erstellung oder Datum der letzten Änderung" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "CompositionDocumentReferenceMapping" ] ;
         fhir:map [ fhir:v "Composition.date" ]
       ] )
     ] [
       fhir:id [ fhir:v "DocumentReference.content.format" ] ;
       fhir:path [ fhir:v "DocumentReference.content.format" ] ;
       fhir:short [ fhir:v "Format des Dokumentes" ] ;
       fhir:comment [ fhir:v "Sofern das Dokument nicht auf einem standardisierten,\n    strukturierten Austauschformat (z.B. CDA) basiert, für dessen Interpretation ein konkretes Schema herangezogen werden muss,\n    genügt die Angabe des Codes\n    &quot;urn:ihe:iti:xds:2017:mimeTypeSufficient&quot;" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:valueSet [
           fhir:v "http://ihe-d.de/ValueSets/IHEXDSformatCodeDE"^^xsd:anyURI ;
           fhir:l <http://ihe-d.de/ValueSets/IHEXDSformatCodeDE>
         ]
       ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "CompositionDocumentReferenceMapping" ] ;
         fhir:map [ fhir:v "=urn:ihe:iti:xds:2017:mimeTypeSufficient" ]
       ] )
     ] [
       fhir:id [ fhir:v "DocumentReference.context" ] ;
       fhir:path [ fhir:v "DocumentReference.context" ] ;
       fhir:short [ fhir:v "Kontextinformationen zum Dokument" ] ;
       fhir:comment [ fhir:v "**Begründung Must Support:** Kontextinformationen sind erforderlich, um die Relevanz und den Bezug des Dokuments zu verstehen." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "DocumentReference.context.encounter" ] ;
       fhir:path [ fhir:v "DocumentReference.context.encounter" ] ;
       fhir:short [ fhir:v "Aufenthaltsbezug" ] ;
       fhir:comment [ fhir:v "**Hinweis Kompatibilität:** In MHD 4.2.0 wurde das Verbot der Angabe einer Encounter-Referenz gelockert, das ISiK-Profil ist damit in diesem Punkt wieder kompatibel zu IHE MHD." ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "CompositionDocumentReferenceMapping" ] ;
         fhir:map [ fhir:v "Lookup Composition.encounter.resolve().identifier" ] ;
         fhir:comment [ fhir:v "Ermittlung des korrekten Encounters auf dem Server anhand des Identifiers(Fallnummer) und/oder weiterer Kriterien erforderlich" ]
       ] )
     ] [
       fhir:id [ fhir:v "DocumentReference.context.encounter.reference" ] ;
       fhir:path [ fhir:v "DocumentReference.context.encounter.reference" ] ;
       fhir:short [ fhir:v "Encounter-Link" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Die Verlinkung auf eine Encounter-Ressource dient der technischen Zuordnung der Dokumentation zu einem Aufenthalt und ermöglicht wichtige API-Funktionen wie verkettete Suche, (Reverse-)Include etc.\nIm ISik Kontext MUSS die referenzierte Ressource konform zu [ISiKKontaktGesundheitseinrichtung](https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung) sein.\nJenseits von ISiK KÖNNEN weitere Instanzen mit anderen Profilen referenziert werden." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "DocumentReference.context.event" ] ;
       fhir:path [ fhir:v "DocumentReference.context.event" ] ;
       fhir:comment [ fhir:v "Binding auf IHE-DE Terminologie hinzugefügt" ] ;
       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:valueSet [
           fhir:v "http://ihe-d.de/ValueSets/IHEXDSeventCodeList"^^xsd:anyURI ;
           fhir:l <http://ihe-d.de/ValueSets/IHEXDSeventCodeList>
         ]
       ]
     ] [
       fhir:id [ fhir:v "DocumentReference.context.event.coding" ] ;
       fhir:path [ fhir:v "DocumentReference.context.event.coding" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ]
     ] [
       fhir:id [ fhir:v "DocumentReference.context.event.coding.system" ] ;
       fhir:path [ fhir:v "DocumentReference.context.event.coding.system" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] [
       fhir:id [ fhir:v "DocumentReference.context.event.coding.code" ] ;
       fhir:path [ fhir:v "DocumentReference.context.event.coding.code" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ]
     ] [
       fhir:id [ fhir:v "DocumentReference.context.facilityType" ] ;
       fhir:path [ fhir:v "DocumentReference.context.facilityType" ] ;
       fhir:short [ fhir:v "Art der Einrichtung, aus der das Dokument stammt" ] ;
       fhir:comment [ fhir:v "Kann, sofern keine abweichende Information bekannt ist auf &quot;KHS&quot; gesetzt werden." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:valueSet [
           fhir:v "http://ihe-d.de/ValueSets/IHEXDShealthcareFacilityTypeCode"^^xsd:anyURI ;
           fhir:l <http://ihe-d.de/ValueSets/IHEXDShealthcareFacilityTypeCode>
         ]
       ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "CompositionDocumentReferenceMapping" ] ;
         fhir:map [ fhir:v "=KHS, sofern nichts anderes bekannt" ]
       ] )
     ] [
       fhir:id [ fhir:v "DocumentReference.context.practiceSetting" ] ;
       fhir:path [ fhir:v "DocumentReference.context.practiceSetting" ] ;
       fhir:comment [ fhir:v "Binding auf IHE-DE Terminologie hinzugefügt" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:valueSet [
           fhir:v "http://ihe-d.de/ValueSets/IHEXDSpracticeSettingCode"^^xsd:anyURI ;
           fhir:l <http://ihe-d.de/ValueSets/IHEXDSpracticeSettingCode>
         ]
       ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "CompositionDocumentReferenceMapping" ] ;
         fhir:map [ fhir:v "Lookup Composition.encounter.resolve().serviceType" ] ;
         fhir:comment [ fhir:v "Mapping per https://wiki.hl7.de/index.php?title=Ihevs:DocumentEntry.PracticeSettingCode von Fachabteilungsschlüssel auf PracticeSetting erforderlich." ]
       ] )
     ] )
  ] . # 

