     ] )
  ] ) ; # 
  fhir:description [ fhir:v "### Beispiel-Questionnaire mit automatischer Vorbelegung von demografischen Patientendaten \nDer Patientenkontext wird mittels der [SDC-LaunchContexts](https://build.fhir.org/ig/HL7/sdc/StructureDefinition-sdc-questionnaire-launchContext.html)-Extension hergestellt.  \nDie Vorbelegung erfolgt über die [SDC-InitialExpression](https://build.fhir.org/ig/HL7/sdc/StructureDefinition-sdc-questionnaire-initialExpression.html)-Extension"] ; # 
  fhir:item ( [
     fhir:linkId [ fhir:v "1" ] ;
     fhir:text [ fhir:v "Demografische Patientendaten" ] ;
     fhir:type [ fhir:v "group" ] ;
     fhir:required [ fhir:v true ] ;
     fhir:item ( [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression>
         ] ;
         fhir:value [
           a fhir:Expression ;
           fhir:description [ fhir:v "Selektion des ersten Vornamens des Patienten. Präferiert aus dem offiziellem Namen, alternativ erster gefundener Name" ] ;
           fhir:language [ fhir:v "text/fhirpath" ] ;
           fhir:expression [ fhir:v "(%patient.name.where(use = 'official').given[0] | %patient.name[0].given[0]).first()" ]
         ]
       ] ) ;
       fhir:linkId [ fhir:v "1.1" ] ;
       fhir:text [ fhir:v "Vorname:" ] ;
       fhir:type [ fhir:v "string" ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression>
         ] ;
         fhir:value [
           a fhir:Expression ;
           fhir:description [ fhir:v "Selektion des Nachnamens des Patienten. Präferiert aus dem offiziellem Namen, alternativ erster gefundener Name" ] ;
           fhir:language [ fhir:v "text/fhirpath" ] ;
           fhir:expression [ fhir:v "(%patient.name.where(use = 'official').family | %patient.name[0].family).first()" ]
         ]
       ] ) ;
       fhir:linkId [ fhir:v "1.2" ] ;
       fhir:text [ fhir:v "Nachname:" ] ;
       fhir:type [ fhir:v "string" ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression>
         ] ;
         fhir:value [
           a fhir:Expression ;
           fhir:description [ fhir:v "Versichertennnummer(KVID) des Patienten" ] ;
           fhir:language [ fhir:v "text/fhirpath" ] ;
           fhir:expression [ fhir:v "%patient.identifier.where(system='http://fhir.de/sid/gkv/kvid-10').value" ]
         ]
       ] ) ;
       fhir:linkId [ fhir:v "1.4" ] ;
       fhir:text [ fhir:v "Versichertennummer:" ] ;
       fhir:type [ fhir:v "string" ]
     ] )
  ] [
     fhir:linkId [ fhir:v "2" ] ;
     fhir:text [ fhir:v "Fallinformationen" ] ;
     fhir:type [ fhir:v "group" ] ;
     fhir:item ( [
       fhir:extension ( [
