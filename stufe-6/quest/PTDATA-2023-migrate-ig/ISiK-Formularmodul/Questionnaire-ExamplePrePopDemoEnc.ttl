         ] ;
         fhir:value [
           a fhir:Expression ;
           fhir:description [ fhir:v "Selektion der Station" ] ;
           fhir:language [ fhir:v "text/fhirpath" ] ;
           fhir:expression [ fhir:v "%encounter.location.where(physicalType.coding.first().code = 'wa' and status = 'active').location.display" ]
