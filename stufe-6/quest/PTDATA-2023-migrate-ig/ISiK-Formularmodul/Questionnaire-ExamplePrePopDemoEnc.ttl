           fhir:expression [ fhir:v "%encounter.period.end" ]
         ]
       ] ) ;
       fhir:linkId [ fhir:v "2.6" ] ;
       fhir:text [ fhir:v "Bis:" ] ;
       fhir:type [ fhir:v "string" ]
     ] [
