  ] ) ; # 
  fhir:description [ fhir:v "### Beispiel-Questionnaire mit Validierung von Benutzereingaben mittels einer FHIRPath-Expression  \nDie Validierung erfolgt über die [targetConstraint](https://hl7.org/fhir/extensions/StructureDefinition-targetConstraint.html)-Extension"] ; # 
  fhir:item ( [
     fhir:extension ( [
       fhir:extension ( [
         fhir:url [
           fhir:v "key"^^xsd:anyURI ;
           fhir:l fhir:key
         ] ;
         fhir:value [
           a fhir:Id ;
           fhir:v "kvid-1"
         ]
       ] [
         fhir:url [
           fhir:v "severity"^^xsd:anyURI ;
           fhir:l fhir:severity
         ] ;
         fhir:value [
           a fhir:Code ;
           fhir:v "warning"
         ]
       ] [
         fhir:url [
           fhir:v "expression"^^xsd:anyURI ;
           fhir:l fhir:expression
         ] ;
         fhir:value [
           a fhir:Expression ;
           fhir:language [ fhir:v "text/fhirpath" ] ;
           fhir:expression [ fhir:v "matches(^[A-Z][0-9]{9}$)" ]
         ]
       ] [
         fhir:url [
           fhir:v "human"^^xsd:anyURI ;
           fhir:l fhir:human
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "Eine Versichertennummer muss mit einem Großbuchstaben beginnen, gefolgt von 9 Zahlen!"
         ]
