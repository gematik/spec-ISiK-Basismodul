  fhir:description [ fhir:v "### Beispiel-Questionnaire, welches eine MDR-Relevanz ausweist\n* Angabe der MDR-Relevanz mittels [ISiKMDRRelevanzFormular](https://simplifier.net/isik-stufe-5/isikmdrrelevanzformularextension)-Extension\nDisclaimer: Dies ist ein simples fantasie Beispiel und hat keine medizinische Aussagekraft. Das erwartete Verhalten von Systemen, die mit diesem Questionnaire testen wäre, dass das Formular mit einer Fehlermeldung *nicht* rendert!"] ; # 
  fhir:item ( [
     fhir:linkId [ fhir:v "1" ] ;
     fhir:text [ fhir:v "Fragen mit Entscheidungspfad, der MDR-relevant ist" ] ;
     fhir:type [ fhir:v "group" ] ;
     fhir:item ( [
       fhir:linkId [ fhir:v "1.1" ] ;
       fhir:text [ fhir:v "Wie hoch ist dein systolischer Blutdruck (oberer Wert)?" ] ;
       fhir:type [ fhir:v "integer" ]
     ] [
       fhir:linkId [ fhir:v "1.1-Krank" ] ;
       fhir:text [ fhir:v "Du sollst zum Arzt!" ] ;
       fhir:type [ fhir:v "display" ] ;
       fhir:enableWhen ( [
         fhir:question [ fhir:v "1.1" ] ;
         fhir:operator [ fhir:v ">=" ] ;
         fhir:answer [
           a fhir:Integer ;
           fhir:v 90
         ]
       ] )
     ] [
       fhir:linkId [ fhir:v "1.1-Gesund" ] ;
       fhir:text [ fhir:v "Du sollst nicht zum Arzt!" ] ;
       fhir:type [ fhir:v "display" ] ;
       fhir:enableWhen ( [
         fhir:question [ fhir:v "1.1" ] ;
         fhir:operator [ fhir:v "<" ] ;
         fhir:answer [
           a fhir:Integer ;
           fhir:v 90
         ]
       ] )
     ] )
  ] ) . # 

