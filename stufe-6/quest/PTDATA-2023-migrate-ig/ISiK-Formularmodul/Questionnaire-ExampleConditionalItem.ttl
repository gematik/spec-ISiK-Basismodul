  ] ; # 
  fhir:version [ fhir:v "6.0.0-rc"] ; # 
  fhir:name [ fhir:v "ExampleConditionalItem"] ; # 
  fhir:title [ fhir:v "Bedingte Fragestellungen"] ; # 
  fhir:status [ fhir:v "draft"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:subjectType ( [ fhir:v "Patient"] ) ; # 
  fhir:date [ fhir:v "2026-02-03T13:26:37+00:00"^^xsd:dateTime] ; # 
  fhir:publisher [ fhir:v "gematik GmbH"] ; # 
  fhir:contact ( [
     fhir:name [ fhir:v "gematik GmbH" ] ;
     fhir:telecom ( [
       fhir:system [ fhir:v "url" ] ;
       fhir:value [ fhir:v "https://gematik.de" ]
     ] )
  ] ) ; # 
  fhir:description [ fhir:v "### Beispiel-Questionnaire mit bedingten Fragestellungen/Items  \nDie zweite Frage &quot;Was ist denn los?&quot; soll nur gestellt werden, \nwenn die erste Frage &quot;Wie geht's&quot; mit &quot;muss.&quot; beantwortet wurde."] ; # 
  fhir:item ( [
     fhir:linkId [ fhir:v "2" ] ;
     fhir:text [ fhir:v "Fragen mit EnableWhen-Bedingung" ] ;
     fhir:type [ fhir:v "group" ] ;
     fhir:item ( [
       fhir:linkId [ fhir:v "2.1" ] ;
       fhir:text [ fhir:v "Wie geht's?" ] ;
       fhir:type [ fhir:v "choice" ] ;
       fhir:answerOption ( [
         fhir:value [
           a fhir:Coding ;
           fhir:display [ fhir:v "gut." ]
         ]
       ] [
         fhir:value [
           a fhir:Coding ;
           fhir:display [ fhir:v "geht." ]
         ]
       ] [
         fhir:value [
           a fhir:Coding ;
           fhir:display [ fhir:v "muss." ]
         ]
       ] )
     ] [
       fhir:linkId [ fhir:v "2.2" ] ;
       fhir:text [ fhir:v "Was ist denn los?" ] ;
       fhir:type [ fhir:v "choice" ] ;
       fhir:enableWhen ( [
         fhir:question [ fhir:v "2.1" ] ;
         fhir:operator [ fhir:v "=" ] ;
         fhir:answer [
           a fhir:Coding ;
           fhir:display [ fhir:v "muss." ]
         ]
       ] ) ;
       fhir:answerOption ( [
         fhir:value [
           a fhir:Coding ;
           fhir:display [ fhir:v "Nix." ]
         ]
       ] [
         fhir:value [
           a fhir:Coding ;
           fhir:display [ fhir:v "Frag nicht!" ]
         ]
       ] )
     ] )
  ] ) . # 

