       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "QuestionnaireResponse.item.linkId" ] ;
       fhir:path [ fhir:v "QuestionnaireResponse.item.linkId" ] ;
       fhir:short [ fhir:v "Eindeutige ID des Formularelement" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:**\n    Die LinkId ordnet die Information der Antwort einer Frage in der FormularDefinition zu und ist aus dem Grund zur Interpretation der Antwort unablässig." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
