       fhir:path [ fhir:v "QuestionnaireResponse.item.answer" ] ;
       fhir:short [ fhir:v "Antwort" ] ;
       fhir:comment [ fhir:v "**Begründung MS:**\n    Die erfasste Antwort MUSS stets vorhanden sein." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
