       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "QuestionnaireResponse.status" ] ;
       fhir:path [ fhir:v "QuestionnaireResponse.status" ] ;
       fhir:short [ fhir:v "Status" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:**\n  Bei der Verarbeitung von FormularDaten ist es wichtig, den Status zu beachten. Falls die Instanz noch nicht `completed` ist, sollte von einer Weiterverarbeitung abgesehen werden." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "QuestionnaireResponse.subject" ] ;
       fhir:path [ fhir:v "QuestionnaireResponse.subject" ] ;
       fhir:short [ fhir:v "Subject (Patient), über das in diesem Formular berichtet wird." ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:**  \n  Zur Vereinfachung des Workflows werden zunächst nur Formulare mit Patientenbezug zugelassen.  \n  Diese Anforderung kann in künftigen Ausbaustufen gelockert werden." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "QuestionnaireResponse.subject.reference" ] ;
       fhir:path [ fhir:v "QuestionnaireResponse.subject.reference" ] ;
       fhir:short [ fhir:v "Patienten-Link" ] ;
       fhir:comment [ fhir:v "**Begründung MS:** Die Verlinkung auf eine Patienten-Ressource dient der technischen Zuordnung der Dokumentation zu einem Patienten und ermöglicht wichtige API-Funktionen wie verkettete Suche, (Reverse-)Include etc.\nIm ISik Kontext MUSS die referenzierte Ressource konform zu [ISiKPatient](https://gematik.de/fhir/isik/StructureDefinition/ISiKPatient) sein.\nJenseits von ISiK KÖNNEN weitere Instanzen mit anderen Profilen referenziert werden." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "QuestionnaireResponse.authored" ] ;
       fhir:path [ fhir:v "QuestionnaireResponse.authored" ] ;
       fhir:short [ fhir:v "Datum der FormularDaten" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** \n  Relevant für die Suche und zeitliche Einordnung der FormularDaten" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "QuestionnaireResponse.author" ] ;
       fhir:path [ fhir:v "QuestionnaireResponse.author" ] ;
       fhir:short [ fhir:v "Ersteller des Fromulars" ] ;
       fhir:comment [ fhir:v "Auch wenn hier keine Einschränkung vorgenommen wurde, ist zu empfehlen, hier die ausfüllende Person (Patient/Practitioner) zu referenzieren und nicht nur die Software (Device), mit der das Formular ausgefüllt wurde.\n  **Begründung MS:**\n  In den meisten Fällen ist relevant, wer Formulardaten erfasst hat." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
