  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "QuestionnaireResponse" ] ;
       fhir:path [ fhir:v "QuestionnaireResponse" ] ;
       fhir:constraint ( [
         fhir:extension ( [
           fhir:url [
             fhir:v "http://hl7.org/fhir/StructureDefinition/elementdefinition-bestpractice"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/StructureDefinition/elementdefinition-bestpractice>
           ] ;
           fhir:value [
             a fhir:Boolean ;
             fhir:v true
           ]
         ] ) ;
         fhir:key [ fhir:v "sdcqr-1" ] ;
         fhir:severity [ fhir:v "warning" ] ;
         fhir:human [ fhir:v "Subject SHOULD be present (searching is difficult without subject).  Almost all QuestionnaireResponses should be with respect to some sort of subject." ] ;
         fhir:expression [ fhir:v "subject.exists()" ] ;
         fhir:xpath [ fhir:v "exists(f:subject)" ] ;
         fhir:source [
           fhir:v "https://gematik.de/fhir/isik/StructureDefinition/ISiKFormularDaten"^^xsd:anyURI ;
           fhir:l <https://gematik.de/fhir/isik/StructureDefinition/ISiKFormularDaten>
         ]
       ] [
         fhir:extension ( [
           fhir:url [
             fhir:v "http://hl7.org/fhir/StructureDefinition/elementdefinition-bestpractice"^^xsd:anyURI ;
             fhir:l <http://hl7.org/fhir/StructureDefinition/elementdefinition-bestpractice>
           ] ;
           fhir:value [
             a fhir:Boolean ;
             fhir:v true
           ]
         ] ) ;
         fhir:key [ fhir:v "sdcqr-2" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "When repeats=true for a group, it'll be represented with multiple items with the same linkId in the QuestionnaireResponse.  For a question, it'll be represented by a single item with that linkId with multiple answers." ] ;
         fhir:expression [ fhir:v "(QuestionnaireResponse|repeat(answer|item)).select(item.where(answer.value.exists()).linkId.isDistinct()).allTrue()" ] ;
         fhir:xpath [ fhir:v "not(exists(for $item in descendant::f:item[f:answer] return $item/preceding-sibling::f:item[f:linkId/@value=$item/f:linkId/@value]))" ] ;
         fhir:source [
           fhir:v "https://gematik.de/fhir/isik/StructureDefinition/ISiKFormularDaten"^^xsd:anyURI ;
           fhir:l <https://gematik.de/fhir/isik/StructureDefinition/ISiKFormularDaten>
         ]
       ] )
     ] [
       fhir:id [ fhir:v "QuestionnaireResponse.id" ] ;
       fhir:path [ fhir:v "QuestionnaireResponse.id" ] ;
       fhir:short [ fhir:v "serverseitige, interne ID des Datensatzes" ] ;
       fhir:comment [ fhir:v "**bedingtes Pflichtfeld/bedingtes MS:** Alle von einem Server bereitgestellten Ressourcen MÜSSEN über eine `id` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `id`verfügen. " ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
