       fhir:sliceName [ fhir:v "MDR-Relevant" ] ;
       fhir:short [ fhir:v "MPG-Relevanz der Formulardaten" ] ;
       fhir:comment [ fhir:v "**Begründung MS:**\n  In dieser Extension wird angegeben, dass die Formulardaten MDR-relevant sind. Für die Erhebung und/oder Darstellung müssen ggf. bestimmte Voraussetzungen erfüllt sein. Ist die Extension nicht vorhanden, liegt keine MDR-relevanmt vor." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
