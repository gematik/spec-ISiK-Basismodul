       fhir:path [ fhir:v "QuestionnaireResponse.meta.versionId" ] ;
       fhir:short [ fhir:v "Eindeutiger Name der serverseitigen Version des Datensatzes" ] ;
       fhir:comment [ fhir:v "Alle von einem Server bereitgestellten Ressourcen SOLLEN über eine `versionID` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `versionID`verfügen. " ]
     ] [
       fhir:id [ fhir:v "QuestionnaireResponse.meta.lastUpdated" ] ;
       fhir:path [ fhir:v "QuestionnaireResponse.meta.lastUpdated" ] ;
       fhir:short [ fhir:v "Zeitpunkt der letzten Änderung" ] ;
       fhir:comment [ fhir:v "Alle von einem Server bereitgestellten Ressourcen SOLLEN über ein `lastUpdate` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über ein `lastUpdate`verfügen. " ]
     ] [
       fhir:id [ fhir:v "QuestionnaireResponse.modifierExtension" ] ;
       fhir:path [ fhir:v "QuestionnaireResponse.modifierExtension" ] ;
       fhir:slicing [
