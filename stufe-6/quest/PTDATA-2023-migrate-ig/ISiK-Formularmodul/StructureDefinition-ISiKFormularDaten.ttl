       fhir:path [ fhir:v "QuestionnaireResponse.item.answer.value[x]" ] ;
       fhir:short [ fhir:v "Inhalt der Antwort" ] ;
       fhir:comment [ fhir:v "**Begründung MS:**\n      Der Inhalt der jeweilig erfassten Antwort MUSS stehts vorhanden sein." ] ;
