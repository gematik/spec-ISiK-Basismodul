         fhir:reference [ fhir:v "StructureDefinition/ISiKFormularDefinition" ]
       ] ;
       fhir:name [ fhir:v "ISiKFormularDefinition" ] ;
       fhir:description [ fhir:v "Im Profil `ISiKFormularDefinition` sind Mindestanforderungen an ISiK kompatible Formulare definiert.\nDie verwendbaren Extensions sind nicht mit profiliert, sondern im IG unter Spezifikationen->Extensions beschrieben." ]
