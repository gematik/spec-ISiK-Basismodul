        "mustSupport": true
      },
      {
        "id": "Procedure.category",
        "path": "Procedure.category",
        "short": "Kategorie",
        "mustSupport": true
      },
      {
        "id": "Procedure.category.coding",
        "path": "Procedure.category.coding",
        "slicing": {
          "discriminator": [
