       ] ;
       fhir:name [ fhir:v "ISiKSubscriptionTopic ValueSet" ] ;
       fhir:description [ fhir:v "ValueSet, das alle Codes des ISiKSubscriptionTopic CodeSystems enthält" ]
     ] [
