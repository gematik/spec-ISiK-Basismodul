  fhir:name [ fhir:v "ISiKCapabilityStatementKlinischeRolle"] ; # 
  fhir:title [ fhir:v "CapabilityStatement für Rolle &quot;ISiKCapabilityStatementKlinischeRolle&quot;"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:date [ fhir:v "2025-10-23"^^xsd:date] ; # 
  fhir:contact ( [
     fhir:telecom ( [
