         fhir:l <https://gematik.de/fhir/isik/StructureDefinition/ExtensionISiKMedicationRequestReplaces> ;
         fhir:reference [ fhir:v "StructureDefinition/ExtensionISiKMedicationRequestReplaces" ]
       ] ;
       fhir:name [ fhir:v "ISiK MedicationRequestReplaces" ] ;
       fhir:description [ fhir:v "Extension zur Verlinkung der Medikationsverordnung die ersetzt wurde" ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
