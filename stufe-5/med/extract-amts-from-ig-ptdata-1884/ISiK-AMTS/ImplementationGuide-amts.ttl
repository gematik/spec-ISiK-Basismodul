         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "CodeSystem"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <https://gematik.de/fhir/isik/CodeSystem/ISiKMedikationsartCS> ;
         fhir:reference [ fhir:v "CodeSystem/ISiKMedikationsartCS" ]
       ] ;
       fhir:name [ fhir:v "ISiK Medikationsart" ] ;
       fhir:description [ fhir:v "ISiK Therapiearten für Medikation" ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v false
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
