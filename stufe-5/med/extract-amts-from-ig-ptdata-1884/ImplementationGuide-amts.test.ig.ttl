         fhir:reference [ fhir:v "StructureDefinition/ISiKLaboruntersuchungCRP" ]
       ] ;
       fhir:name [ fhir:v "ISiKLaboruntersuchungCRP" ] ;
       fhir:description [ fhir:v "Dieses Profil ermöglicht die Abbildung der Laboruntersuchung CRP eines Patienten in ISiK Szenarien." ]
     ] [
