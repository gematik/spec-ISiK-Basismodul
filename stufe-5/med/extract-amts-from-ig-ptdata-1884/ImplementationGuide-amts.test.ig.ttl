       fhir:reference [
         fhir:l <http://example.org/fhir/test-amts-ig/StructureDefinition/ISiKLaboruntersuchungTroponin> ;
         fhir:reference [ fhir:v "StructureDefinition/ISiKLaboruntersuchungTroponin" ]
       ] ;
