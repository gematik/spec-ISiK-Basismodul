         fhir:reference [ fhir:v "StructureDefinition/ISiKLaboruntersuchungThrombozyten" ]
       ] ;
       fhir:name [ fhir:v "ISiKLaboruntersuchungThrombozyten" ] ;
       fhir:description [ fhir:v "Dieses Profil ermöglicht die Abbildung der Laboruntersuchung Thrombozyten eines Patienten in ISiK Szenarien." ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
