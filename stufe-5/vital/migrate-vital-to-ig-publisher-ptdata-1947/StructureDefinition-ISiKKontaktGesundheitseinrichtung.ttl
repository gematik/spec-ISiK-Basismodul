       fhir:sliceName [ fhir:v "RehaEntlassung" ] ;
       fhir:short [ fhir:v "Entlassungsgrund Reha" ] ;
       fhir:comment [ fhir:v "Entlassungsgrund nach §301 (Abs. 4 und 4a) SGB V  \n      **Einschränkung MS:** Der Entlassungsgrund Reha muss nur implementiert werden,\n        wenn das bestätigungsrelevante System in der Reha-Versorgung eingesetzt wird" ] ;
