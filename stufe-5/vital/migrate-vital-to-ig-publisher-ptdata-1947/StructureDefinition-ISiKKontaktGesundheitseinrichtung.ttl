           fhir:v "http://hl7.org/fhir/StructureDefinition/Encounter|4.0.1"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Encounter?version=4.0.1>
         ] )
       ] ) ;
       fhir:constraint ( [
         fhir:key [ fhir:v "ele-1" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "All FHIR elements must have a @value or children" ] ;
         fhir:expression [ fhir:v "hasValue() or (children().count() > id.count())" ] ;
         fhir:xpath [ fhir:v "@value|f:*|h:div" ] ;
         fhir:source [
           fhir:v "http://hl7.org/fhir/StructureDefinition/Element"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/Element>
         ]
       ] ) ;
       fhir:isModifier [ fhir:v false ] ;
       fhir:isSummary [ fhir:v false ] ;
       fhir:mapping ( [
         fhir:identity [ fhir:v "workflow" ] ;
         fhir:map [ fhir:v "Event.partOf" ]
       ] [
         fhir:identity [ fhir:v "rim" ] ;
         fhir:map [ fhir:v ".inboundRelationship[typeCode=COMP].source[classCode=COMP, moodCode=EVN]" ]
       ] )
     ] )
  ] ; # 
  fhir:differential [
     fhir:element ( [
       fhir:id [ fhir:v "Encounter" ] ;
       fhir:path [ fhir:v "Encounter" ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "ISiK-enc-1" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Abgeschlossene, ambulante Kontakte sollten einen Start-Zeitpunkt angeben" ] ;
         fhir:expression [ fhir:v "status = 'finished' and class = 'AMB' implies period.start.exists()" ] ;
         fhir:source [
           fhir:v "https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung"^^xsd:anyURI ;
           fhir:l <https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung>
         ]
       ] [
         fhir:key [ fhir:v "ISiK-enc-2" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Abgeschlossene, stationäre Kontakte sollten einen Start- und End-Zeitpunkt angeben" ] ;
         fhir:expression [ fhir:v "status = 'finished' and class = 'IMP' implies period.start.exists() and period.end.exists()" ] ;
         fhir:source [
           fhir:v "https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung"^^xsd:anyURI ;
           fhir:l <https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung>
         ]
       ] [
         fhir:key [ fhir:v "ISiK-enc-3" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Geplante Kontakte sollten keinen Start- oder End-Zeitpunkt angeben" ] ;
         fhir:expression [ fhir:v "status = 'planned' implies period.exists().not()" ] ;
         fhir:source [
           fhir:v "https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung"^^xsd:anyURI ;
           fhir:l <https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung>
         ]
       ] [
         fhir:key [ fhir:v "ISiK-enc-4" ] ;
         fhir:severity [ fhir:v "warning" ] ;
         fhir:human [ fhir:v "Geplante Kontakte sollten die Extensions für den geplanten Start- oder End-Zeitpunkt verwenden" ] ;
         fhir:expression [ fhir:v "status = 'planned' implies extension.where(url = 'http://hl7.org/fhir/5.0/StructureDefinition/extension-Encounter.plannedStartDate').exists()" ] ;
         fhir:source [
           fhir:v "https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung"^^xsd:anyURI ;
           fhir:l <https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung>
         ]
       ] [
         fhir:key [ fhir:v "ISiK-enc-5" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "In-Durchführung befindliche Kontakte sollten einen Start-Zeitpunkt angeben" ] ;
         fhir:expression [ fhir:v "status = 'in-progress' implies period.start.exists()" ] ;
         fhir:source [
           fhir:v "https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung"^^xsd:anyURI ;
           fhir:l <https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung>
         ]
       ] [
         fhir:key [ fhir:v "ISiK-enc-6" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Kontakte mit Abwesenheitsstatus sollten einen Start-Zeitpunkt angeben" ] ;
         fhir:expression [ fhir:v "status = 'onleave' implies period.start.exists()" ] ;
         fhir:source [
           fhir:v "https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung"^^xsd:anyURI ;
           fhir:l <https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung>
         ]
       ] [
         fhir:key [ fhir:v "ISiK-enc-7" ] ;
         fhir:severity [ fhir:v "warning" ] ;
         fhir:human [ fhir:v "Kontakte mit unbekannten Status sollten einen Start-Zeitpunkt angeben" ] ;
         fhir:expression [ fhir:v "status = 'unknown' implies period.start.exists()" ] ;
         fhir:source [
           fhir:v "https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung"^^xsd:anyURI ;
           fhir:l <https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung>
         ]
       ] [
         fhir:key [ fhir:v "ISiK-enc-8" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Die Rolle der assoziierten Diagnose(n) darf nicht 'Billing' sein" ] ;
         fhir:expression [ fhir:v "diagnosis.use.all(coding.code != 'billing')" ] ;
         fhir:source [
           fhir:v "https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung"^^xsd:anyURI ;
           fhir:l <https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung>
         ]
       ] )
     ] [
       fhir:id [ fhir:v "Encounter.id" ] ;
       fhir:path [ fhir:v "Encounter.id" ] ;
       fhir:short [ fhir:v "serverseitige, interne ID des Datensatzes" ] ;
       fhir:comment [ fhir:v "**bedingtes Pflichtfeld/bedingtes MS:** Alle von einem Server bereitgestellten Ressourcen MÜSSEN über eine `id` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `id`verfügen. " ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.meta.versionId" ] ;
       fhir:path [ fhir:v "Encounter.meta.versionId" ] ;
       fhir:short [ fhir:v "Eindeutiger Name der serverseitigen Version des Datensatzes" ] ;
       fhir:comment [ fhir:v "Alle von einem Server bereitgestellten Ressourcen SOLLEN über eine `versionID` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `versionID`verfügen. " ]
     ] [
       fhir:id [ fhir:v "Encounter.meta.lastUpdated" ] ;
       fhir:path [ fhir:v "Encounter.meta.lastUpdated" ] ;
       fhir:short [ fhir:v "Zeitpunkt der letzten Änderung" ] ;
       fhir:comment [ fhir:v "Alle von einem Server bereitgestellten Ressourcen SOLLEN über ein `lastUpdate` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über ein `lastUpdate`verfügen. " ]
     ] [
       fhir:id [ fhir:v "Encounter.extension" ] ;
       fhir:path [ fhir:v "Encounter.extension" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "value" ] ;
           fhir:path [ fhir:v "url" ]
         ] ) ;
         fhir:ordered [ fhir:v false ] ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.extension:Aufnahmegrund" ] ;
       fhir:path [ fhir:v "Encounter.extension" ] ;
       fhir:sliceName [ fhir:v "Aufnahmegrund" ] ;
       fhir:short [ fhir:v "Aufnahmegrund" ] ;
       fhir:comment [ fhir:v "Aufnahmegrund nach § 301 Abs. 3 SGB V. Dieser gehört zu den 'Medizinischen Daten des Behandlungsfalls' entsprechend der Definitionen für die Datenübermittlung\nnach § 301 Abs. 3 SGB V. Somit sind diese über den Kontakt und nicht über den Abrechnungsfall zu dokumentieren. Diese Extension SOLL am ersten Abteilungskontakt, der die stationäre Aufnahme repräsentiert, dokumentiert werden. Wird durch den Encounter ein Einrichtungskontakt repräsentiert, SOLL dort zusätzlich zu dem Abteilungskontakt der Aufnahmegrund dokumentiert werden." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Extension"^^xsd:anyURI ;
           fhir:l fhir:Extension
         ] ;
         fhir:profile ( [
           fhir:v "http://fhir.de/StructureDefinition/Aufnahmegrund"^^xsd:anyURI ;
           fhir:l <http://fhir.de/StructureDefinition/Aufnahmegrund>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.extension:Aufnahmegrund.extension:ErsteUndZweiteStelle" ] ;
       fhir:path [ fhir:v "Encounter.extension.extension" ] ;
       fhir:sliceName [ fhir:v "ErsteUndZweiteStelle" ] ;
       fhir:short [ fhir:v "Aufnahmegrund: 1. & 2. Stelle" ] ;
       fhir:comment [ fhir:v "1. und 2. Stelle des Aufnahmegrunds nach § 301 Abs. 3 SGB V." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.extension:Aufnahmegrund.extension:DritteStelle" ] ;
       fhir:path [ fhir:v "Encounter.extension.extension" ] ;
       fhir:sliceName [ fhir:v "DritteStelle" ] ;
       fhir:short [ fhir:v "Aufnahmegrund: 3. Stelle" ] ;
       fhir:comment [ fhir:v "3. Stelle des Aufnahmegrunds nach § 301 Abs. 3 SGB V." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.extension:Aufnahmegrund.extension:VierteStelle" ] ;
       fhir:path [ fhir:v "Encounter.extension.extension" ] ;
       fhir:sliceName [ fhir:v "VierteStelle" ] ;
       fhir:short [ fhir:v "Aufnahmegrund: 4. Stelle" ] ;
       fhir:comment [ fhir:v "4. Stelle des Aufnahmegrunds nach § 301 Abs. 3 SGB V." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.extension:plannedStartDate" ] ;
       fhir:path [ fhir:v "Encounter.extension" ] ;
       fhir:sliceName [ fhir:v "plannedStartDate" ] ;
       fhir:short [ fhir:v "geplantes Aufnahmedatum" ] ;
       fhir:comment [ fhir:v "**Begründung MS:** Im Falle einer geplanten Aufnahme ist das Datum mittels dieser Extension anzugeben." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Extension"^^xsd:anyURI ;
           fhir:l fhir:Extension
         ] ;
         fhir:profile ( [
           fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Encounter.plannedStartDate"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/5.0/StructureDefinition/extension-Encounter.plannedStartDate>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.extension:plannedEndDate" ] ;
       fhir:path [ fhir:v "Encounter.extension" ] ;
       fhir:sliceName [ fhir:v "plannedEndDate" ] ;
       fhir:short [ fhir:v "geplantes Entlassdatum" ] ;
       fhir:comment [ fhir:v "**Begründung MS:** Im Falle der Dokumentation eines geplanten Entlassdatums ist diese Extension zu befüllen." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Extension"^^xsd:anyURI ;
           fhir:l fhir:Extension
         ] ;
         fhir:profile ( [
           fhir:v "http://hl7.org/fhir/5.0/StructureDefinition/extension-Encounter.plannedEndDate"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/5.0/StructureDefinition/extension-Encounter.plannedEndDate>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.identifier" ] ;
       fhir:path [ fhir:v "Encounter.identifier" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "pattern" ] ;
           fhir:path [ fhir:v "$this" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:comment [ fhir:v "Eindeutiger Identifier des Encounter" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.identifier:Aufnahmenummer" ] ;
       fhir:path [ fhir:v "Encounter.identifier" ] ;
       fhir:sliceName [ fhir:v "Aufnahmenummer" ] ;
       fhir:short [ fhir:v "Aufnahmenummer" ] ;
       fhir:comment [ fhir:v "**Begründung MS:** Die Aufnahmenummer ist nicht die 'Fallnummer', welche sich auf den kompletten Abrechnungsfall bezieht. Hier wird ein Identifier angegeben, der den Kontakt eindeutig identifiziert." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:pattern [
         a fhir:Identifier ;
         fhir:type [
           fhir:coding ( [
             fhir:system [
               fhir:v "http://terminology.hl7.org/CodeSystem/v2-0203"^^xsd:anyURI ;
               fhir:l <http://terminology.hl7.org/CodeSystem/v2-0203>
             ] ;
             fhir:code [ fhir:v "VN" ]
           ] )
         ]
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.identifier:Aufnahmenummer.type" ] ;
       fhir:path [ fhir:v "Encounter.identifier.type" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.identifier:Aufnahmenummer.type.coding" ] ;
       fhir:path [ fhir:v "Encounter.identifier.type.coding" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "pattern" ] ;
           fhir:path [ fhir:v "$this" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.identifier:Aufnahmenummer.type.coding:vn-type" ] ;
       fhir:path [ fhir:v "Encounter.identifier.type.coding" ] ;
       fhir:sliceName [ fhir:v "vn-type" ] ;
       fhir:short [ fhir:v "Codierte Darstellung des Identifier-Typs" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:pattern [
         a fhir:Coding ;
         fhir:system [
           fhir:v "http://terminology.hl7.org/CodeSystem/v2-0203"^^xsd:anyURI ;
           fhir:l <http://terminology.hl7.org/CodeSystem/v2-0203>
         ] ;
         fhir:code [ fhir:v "VN" ]
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.identifier:Aufnahmenummer.type.coding:vn-type.system" ] ;
       fhir:path [ fhir:v "Encounter.identifier.type.coding.system" ] ;
       fhir:short [ fhir:v "Codier-Schema" ] ;
       fhir:comment [ fhir:v "Hier ist stets der Wert `http://terminology.hl7.org/CodeSystem/v2-0203` anzugeben." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.identifier:Aufnahmenummer.type.coding:vn-type.code" ] ;
       fhir:path [ fhir:v "Encounter.identifier.type.coding.code" ] ;
       fhir:short [ fhir:v "Code" ] ;
       fhir:comment [ fhir:v "Hier ist stets der Wert `VN` anzugeben." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.identifier:Aufnahmenummer.system" ] ;
       fhir:path [ fhir:v "Encounter.identifier.system" ] ;
       fhir:short [ fhir:v "Namensraum des Identifiers" ] ;
       fhir:comment [ fhir:v "Hier ist stets der eindeutige Name (URL) des Namensraums anzugeben, \n    aus dem der Identifier stammt. \n    Hinweise zur Festlegung der URLs für lokale Namensräume sind in den \n    [Deutschen Basisprofilen](https://simplifier.net/guide/leitfaden-de-basis-r4/ig-markdown-Terminologie-Namensraeume?version=current) beschrieben.  \n    **Begründung Pflichtfeld:** `system` stellt in Kombination mit `value` die Eindeutigkeit eines Identifiers sicher." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.identifier:Aufnahmenummer.value" ] ;
       fhir:path [ fhir:v "Encounter.identifier.value" ] ;
       fhir:comment [ fhir:v "Enthält den eigentlichen Wert des Identifiers.  \n    **Begründung Pflichtfeld:** Ist der Wert nicht bekannt, sollte der gesamte Slice weggelassen werden." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.status" ] ;
       fhir:path [ fhir:v "Encounter.status" ] ;
       fhir:short [ fhir:v "Status" ] ;
       fhir:comment [ fhir:v "Zeigt den aktuellen Status der Ressource an.     \n  **WICHTIGER Hinweis für Implementierer:**    \n  * Alle server-seitigen Implementierungen MÜSSEN in der Lage sein, \n  die systemintern möglichen Statuswerte korrekt in FHIR abzubilden, mindestens jedoch die Werte `in-progress`, `finished` und `cancelled`.\n  * Alle client-seitigen Implementierungen MÜSSEN in der Lage sein, sämtliche Status-Codes zu interpretieren und dem Anwender in angemessener Form darstellen zu können, \n  beispielsweise durch Ausblenden/Durchstreichen von Ressourcen mit dem status `entered-in-error` und Ausgrauen von Ressourcen, die einen Plan- oder Entwurfs-Status haben.  \n  **Historie:** Die Reduktion der zulässigen Status-Werte im Vergleich zur FHIR-Kernspezifikation \n  erfolgt im Vorgriff auf eine entsprechende Anpassung in FHIR R5." ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:description [ fhir:v "Eingeschränkter Status vgl. FHIR R5" ] ;
         fhir:valueSet [
           fhir:v "http://fhir.de/ValueSet/EncounterStatusDe"^^xsd:anyURI ;
           fhir:l <http://fhir.de/ValueSet/EncounterStatusDe>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Encounter.class" ] ;
       fhir:path [ fhir:v "Encounter.class" ] ;
       fhir:short [ fhir:v "Fallart" ] ;
       fhir:comment [ fhir:v "Die Klassifikation von Encountern nach Fallarten folgt den internationalen Vorgaben und \n  dient der groben Unterscheidung von Besuchen mit und ohne Bettendisposition (ambulant/stationär). \n  Die in Deutschland übliche Fallklassifikation anhand von unterschiedlichen \n  regulatorischen und abrechnungrelevanten Rahmenbedingungen, erfolgt in `type`.  \n  Für ein korrektes Mapping der in Deutschland gebräuchlichen Fallarten auf `class` siehe [Deutsche Basisprofile](https://simplifier.net/guide/leitfaden-de-basis-r4/ig-markdown-Ressourcen-AmbulanterStationaererFall?version=current)" ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:valueSet [
           fhir:v "http://fhir.de/ValueSet/EncounterClassDE"^^xsd:anyURI ;
           fhir:l <http://fhir.de/ValueSet/EncounterClassDE>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Encounter.type" ] ;
       fhir:path [ fhir:v "Encounter.type" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "pattern" ] ;
           fhir:path [ fhir:v "$this" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:comment [ fhir:v "Typ des Encounter" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.type:Kontaktebene" ] ;
       fhir:path [ fhir:v "Encounter.type" ] ;
       fhir:sliceName [ fhir:v "Kontaktebene" ] ;
       fhir:short [ fhir:v "Kontaktebene" ] ;
       fhir:comment [ fhir:v "  **Begründung Pflichtfeld:** Die Abteilungsebene muss aus Kompatibilitätsgründen angegeben werden.\n  \n    **Hinweis bei Abbildung von Versorgungsstellenkontakten:**\n  Es ist ein üblicher Fall, dass die Dauer eines Versorgungsstellenkontaktes in der Versorgung die eines Abteilungskontaktes übersteigt. Ein Beispiel hierfür: Ein Patient bleibt im Bett (Versorgungsstellenkontakt), aber ein Fachabteilungswechsel geschieht, da die Diagnose über eine Fachabteilung (Onkologie) läuft, dann aber der Wechsel zur Fachabteilung Chirurgie (neuer Abteilungskontakt) notwendig wird.\n  Für einen solchen Fall gilt auf Ebene der FHIR-Instanzen (z.B. entgegen des tatsächliche Aufenthaltes im gleichen Bett): Im Falle eines Fachabteilungswechsels legt ein System einen neuen Abteilungskontakt an. Bestehende Versorgungsstellenkontakt SOLLEN NICHT in ihrer Relation (.partOf) zum Abteilungskontakt modifiziert werden. Hingegen SOLL das System einen oder mehrere Versorgungsstellenkontakte erzeugen und mit dem neu angelegten Abteilungskontakt in Verbindung setzen.\n\n  Hintergrund: Das Konzept der 'Kontaktebene' stammt aus dem Fallmodell der Medizininformatik-Initiative, \n    das bei Encountern zwischen 'Einrichtungskontakten', 'Fachabteilungskontakten' und 'Versorgungsstellenkontakten' unterscheidet.\n    Im Kontext dieses Moduls werden lediglich Encounter der Ebene 'Fachabteilungskontakt' abgebildet.\n  \n  " ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:pattern [
         a fhir:CodeableConcept ;
         fhir:coding ( [
           fhir:system [
             fhir:v "http://fhir.de/CodeSystem/Kontaktebene"^^xsd:anyURI ;
             fhir:l <http://fhir.de/CodeSystem/Kontaktebene>
           ] ;
           fhir:code [ fhir:v "abteilungskontakt" ]
         ] )
       ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:description [ fhir:v "Kontaktebene" ] ;
         fhir:valueSet [
           fhir:v "http://fhir.de/ValueSet/kontaktebene-de"^^xsd:anyURI ;
           fhir:l <http://fhir.de/ValueSet/kontaktebene-de>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Encounter.type:Kontaktebene.coding" ] ;
       fhir:path [ fhir:v "Encounter.type.coding" ] ;
       fhir:short [ fhir:v "Codierte Darstellung der Kontaktebene" ]
     ] [
       fhir:id [ fhir:v "Encounter.type:Kontaktebene.coding.system" ] ;
       fhir:path [ fhir:v "Encounter.type.coding.system" ] ;
       fhir:short [ fhir:v "Codier-Schema" ] ;
       fhir:comment [ fhir:v "Hier ist stets der Wert `http://fhir.de/CodeSystem/Kontaktebene` anzugeben." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.type:Kontaktebene.coding.code" ] ;
       fhir:path [ fhir:v "Encounter.type.coding.code" ] ;
       fhir:short [ fhir:v "Code" ] ;
       fhir:comment [ fhir:v "Hier ist stets der Wert `abteilungskontakt` anzugeben." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.type:KontaktArt" ] ;
       fhir:path [ fhir:v "Encounter.type" ] ;
       fhir:sliceName [ fhir:v "KontaktArt" ] ;
       fhir:short [ fhir:v "Kontaktart" ] ;
       fhir:comment [ fhir:v "Die Kontaktart dient der feingranularen Differenzierung unterschiedlicher stationärer \n  und ambulanter Fallarten gemäß der in Deutschland üblichen regulatorischen \n  und abrechnungsrelevanten Rahmenbedingungen.  \n  Für ein korrektes Mapping der in Deutschland gebräuchlichen Fallarten auf `type` siehe [Deutsche Basisprofile](https://simplifier.net/guide/leitfaden-de-basis-r4/ig-markdown-Ressourcen-AmbulanterStationaererFall?version=current)" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:pattern [
         a fhir:CodeableConcept ;
         fhir:coding ( [
           fhir:system [
             fhir:v "http://fhir.de/CodeSystem/kontaktart-de"^^xsd:anyURI ;
             fhir:l <http://fhir.de/CodeSystem/kontaktart-de>
           ]
         ] )
       ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:valueSet [
           fhir:v "http://fhir.de/ValueSet/kontaktart-de"^^xsd:anyURI ;
           fhir:l <http://fhir.de/ValueSet/kontaktart-de>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Encounter.type:KontaktArt.coding" ] ;
       fhir:path [ fhir:v "Encounter.type.coding" ] ;
       fhir:short [ fhir:v "Codierte Darstellung der Kontaktart" ]
     ] [
       fhir:id [ fhir:v "Encounter.type:KontaktArt.coding.system" ] ;
       fhir:path [ fhir:v "Encounter.type.coding.system" ] ;
       fhir:short [ fhir:v "Codier-Schema" ] ;
       fhir:comment [ fhir:v "Hier ist stets der Wert `http://fhir.de/CodeSystem/kontaktart-de` anzugeben." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.type:KontaktArt.coding.code" ] ;
       fhir:path [ fhir:v "Encounter.type.coding.code" ] ;
       fhir:short [ fhir:v "Code" ] ;
       fhir:comment [ fhir:v "vorstationaer | nachstationaer | begleitperson | tagesklinik | +" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.serviceType" ] ;
       fhir:path [ fhir:v "Encounter.serviceType" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.serviceType.coding" ] ;
       fhir:path [ fhir:v "Encounter.serviceType.coding" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "pattern" ] ;
           fhir:path [ fhir:v "$this" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.serviceType.coding:Fachabteilungsschluessel" ] ;
       fhir:path [ fhir:v "Encounter.serviceType.coding" ] ;
       fhir:sliceName [ fhir:v "Fachabteilungsschluessel" ] ;
       fhir:short [ fhir:v "Fachabteilungsschlüssel" ] ;
       fhir:comment [ fhir:v "Fachabteilungen gemäß Anhang 1 der BPflV" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:pattern [
         a fhir:Coding ;
         fhir:system [
           fhir:v "http://fhir.de/CodeSystem/dkgev/Fachabteilungsschluessel"^^xsd:anyURI ;
           fhir:l <http://fhir.de/CodeSystem/dkgev/Fachabteilungsschluessel>
         ]
       ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:valueSet [
           fhir:v "http://fhir.de/ValueSet/dkgev/Fachabteilungsschluessel"^^xsd:anyURI ;
           fhir:l <http://fhir.de/ValueSet/dkgev/Fachabteilungsschluessel>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Encounter.serviceType.coding:ErweiterterFachabteilungsschluessel" ] ;
       fhir:path [ fhir:v "Encounter.serviceType.coding" ] ;
       fhir:sliceName [ fhir:v "ErweiterterFachabteilungsschluessel" ] ;
       fhir:short [ fhir:v "Fachabteilungsschlüssel" ] ;
       fhir:comment [ fhir:v "Fachabteilungen gemäß Anhang 1 der BPflV inkl. Spezialisierungen" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:pattern [
         a fhir:Coding ;
         fhir:system [
           fhir:v "http://fhir.de/CodeSystem/dkgev/Fachabteilungsschluessel-erweitert"^^xsd:anyURI ;
           fhir:l <http://fhir.de/CodeSystem/dkgev/Fachabteilungsschluessel-erweitert>
         ]
       ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:valueSet [
           fhir:v "http://fhir.de/ValueSet/dkgev/Fachabteilungsschluessel-erweitert"^^xsd:anyURI ;
           fhir:l <http://fhir.de/ValueSet/dkgev/Fachabteilungsschluessel-erweitert>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Encounter.subject" ] ;
       fhir:path [ fhir:v "Encounter.subject" ] ;
       fhir:short [ fhir:v "Patientenbezug" ] ;
       fhir:comment [ fhir:v "**Begründung Must-Support:** Ein Patientenbezug des Kontakt MUSS stets zum Zwecke der Nachvollziehbarkeit und Datenintegrität vorliegen." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.subject.reference" ] ;
       fhir:path [ fhir:v "Encounter.subject.reference" ] ;
       fhir:short [ fhir:v "Patienten-Link" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Die Verlinkung auf eine Patienten-Ressource dient der technischen Zuordnung der Dokumentation zu einem Patienten \n      und ermöglicht wichtige API-Funktionen wie verkettete Suche, (Reverse-)Include etc." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.appointment" ] ;
       fhir:path [ fhir:v "Encounter.appointment" ] ;
       fhir:short [ fhir:v "Verknüpfung mit einem Termin" ] ;
       fhir:comment [ fhir:v "\n  \n**Begründung und Einschränkung des Must Support**: Dieses Element dient der Verknüpfung mit einem Termin (Appointment) aus dem entsprechenden ISiK Modul und - darauf aufbauend - der Dokumentenkommunikation. Das Element 'appointment' SOLL für den im Folgenden geschilderten Fall implementiert werden. Andernfalls KANN es entfallen. \n\nDie Anforderung einer Verknüpfung mit einem Appointment stammt aus dem Szenario der Dokumentenübertragung zwischen Patientenportal und krankenhaus-internem Primärsystem (z.B. KIS) im Kontext einer Terminbuchung: Dokumente liegen bei Terminbuchung erst im Patientenportal (im Appointment) vor und werden erst mit Anlage des Encounters in das KIS (etc.) übermittelt. Dazu SOLL ein Primärsystem zu Beginn des Termins das Appointment mit dem neu angelegten Encounter verknüpfen, um die Dokumente aus dem Patientenportal darüber vermittelt zuordnen zu können (ausgenommen hiervon sind Termine, die nicht stattfinden, da für diese in der Regel keine Encounter angelegt werden).\n\nÜber die Referenz auf Appointment KÖNNEN Patientenportale den Fallbezug aus dem Termin ermitteln und Dokumente an ein KIS senden.\n\nHieraus folgt, dass das Element nur relevant ist, falls das bestätigungsrelevante System zusätzlich zum vorliegenden Profil (Encounter) das Profil ISiKTermin (Appointment) implementiert.\n\n**Hinweis:**  Zur Umsetzung der Funktionalität zum Dokumentenaustausch gemäß ISiK ist der entsprechende [Implementation Guide zum Modul Dokumentenaustausch](https://simplifier.net/guide/isik-dokumentenaustausch-stufe-5) zu beachten." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.period" ] ;
       fhir:path [ fhir:v "Encounter.period" ] ;
       fhir:short [ fhir:v "Aufenthaltszeitraum" ] ;
       fhir:comment [ fhir:v "**WICHTIGER Hinweis für Implementierer:** \n  * Das Aufnahmedatum  MUSS angegeben werden, \n  wenn der `status` des Encounters impliziert, dass dieser bereits begonnen hat.\n  * Das Entlassdatum MUSS angegeben werden, \n  wenn der `status` des Encounters impliziert, dass dieser beendet ist.  \n  Siehe hierzu die Übersicht der Invarianten in diesem Profil. " ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.period.start" ] ;
       fhir:path [ fhir:v "Encounter.period.start" ] ;
       fhir:short [ fhir:v "Aufnahmedatum" ] ;
       fhir:comment [ fhir:v "Hier ist stets das *tatsächliche* Aufnahmedatum anzugeben.\n    *Geplante* Aufnahmedaten müssen über die Extension `plannedStartDate` erfasst werden." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.period.end" ] ;
       fhir:path [ fhir:v "Encounter.period.end" ] ;
       fhir:short [ fhir:v "Entlassdatum" ] ;
       fhir:comment [ fhir:v "Hier ist stets das *tatsächliche* Entlassdatum anzugeben.\n    *Geplante* Entlassdaten müssen über die Extension `plannedEndDate` erfasst werden." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.diagnosis" ] ;
       fhir:path [ fhir:v "Encounter.diagnosis" ] ;
       fhir:short [ fhir:v "Falldiagnosen/-prozeduren" ] ;
       fhir:comment [ fhir:v "Verweis auf Diagnosen/Prozeduren, die eine besondere Rolle im Kontext eines Encounters einnehmen, z.B. &quot;Aufnahmediagnose&quot;   \n  **WICHTIGER Hinweis für Implementierer:**   Der Fallbezug von Diagnosen und Prozeduren wird über das jeweilige `encounter`-Element \n  der Condition bzw. Procedure-Ressource hinreichend etabliert.  Die *zusätzliche* Rückverlinkung von `Encounter.diagnosis` auf Condition/Procedure wird *nur dann* verwendet, \n  wenn einer Diagnose bzw. Prozedur *im Kontext eines Aufenthaltes* eine besondere Rolle zugewiesen werden soll, z.B. Haupt-/Neben-/Aufnahme- oder Überweisungsdiagnose).  \n  Hier werden Diagnosen und Prozeduren nur nach ihrer *medizinschen* Relevanz bezüglich eines Aufenthaltes qualifiziert. \n  Die Qualifikation von Diagnosen und Prozeduren im Kontext der *Abrechnung* erfolgt in der `Account`-Ressource!" ]
     ] [
       fhir:id [ fhir:v "Encounter.diagnosis.condition" ] ;
       fhir:path [ fhir:v "Encounter.diagnosis.condition" ] ;
       fhir:short [ fhir:v "Verweis auf Diagnose/Prozedur" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.diagnosis.condition.reference" ] ;
       fhir:path [ fhir:v "Encounter.diagnosis.condition.reference" ] ;
       fhir:short [ fhir:v "Condition/Procedure-Link" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Die Verlinkung auf die Condition/Procedure-Ressource dient der technischen Zuordnung des Encounters zur Condition/Precedure \n  und ermöglicht wichtige API-Funktionen wie verkettete Suche, (Reverse-)Include etc." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.diagnosis.use" ] ;
       fhir:path [ fhir:v "Encounter.diagnosis.use" ] ;
       fhir:short [ fhir:v "Bedeutung der Diagnose/Prozedur" ] ;
       fhir:comment [ fhir:v "Bedeutung der Diagnose/Prozedur im Encounter-Kontext" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.diagnosis.use.coding" ] ;
       fhir:path [ fhir:v "Encounter.diagnosis.use.coding" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "pattern" ] ;
           fhir:path [ fhir:v "$this" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.diagnosis.use.coding:Diagnosetyp" ] ;
       fhir:path [ fhir:v "Encounter.diagnosis.use.coding" ] ;
       fhir:sliceName [ fhir:v "Diagnosetyp" ] ;
       fhir:short [ fhir:v "Diagnosetyp" ] ;
       fhir:comment [ fhir:v "International standardisierte, grobgranulare Unterscheidung zwischen extern gestellten Diagnosen (`referral-diagnosis`) und intern gestellten Diagnosen (`treatment-diagnosis`)" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:valueSet [
           fhir:v "http://fhir.de/ValueSet/DiagnoseTyp"^^xsd:anyURI ;
           fhir:l <http://fhir.de/ValueSet/DiagnoseTyp>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Encounter.diagnosis.use.coding:DiagnosesubTyp" ] ;
       fhir:path [ fhir:v "Encounter.diagnosis.use.coding" ] ;
       fhir:sliceName [ fhir:v "DiagnosesubTyp" ] ;
       fhir:short [ fhir:v "Diagnosesubtyp" ] ;
       fhir:comment [ fhir:v "An deutschen Kodierrichtlinien orientierte, feingranulare Unterscheidung von Diagnose-Rollen, \n      z.B. &quot;Fachabteilungshauptdiagnose&quot;, &quot;Todesursache&quot; etc." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "*" ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:valueSet [
           fhir:v "http://fhir.de/ValueSet/Diagnosesubtyp"^^xsd:anyURI ;
           fhir:l <http://fhir.de/ValueSet/Diagnosesubtyp>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Encounter.diagnosis.rank" ] ;
       fhir:path [ fhir:v "Encounter.diagnosis.rank" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.account" ] ;
       fhir:path [ fhir:v "Encounter.account" ] ;
       fhir:short [ fhir:v "Abrechnungskontext" ] ;
       fhir:comment [ fhir:v "Der Bezug zu einem Account stellt den Abrechnungskontext für einen oder mehrere Encounter her.\n  Mittels der Account-Referenz können zum Beispiel ein vorstationärer, ein stationärer \n  und ein nachstationärer Besuch zu einem 'DRG-Fall' zusammengefasst werden.  \n  **WICHTIGER Hinweis für Implementierer:** Im Deutschen Sprachgebrauch ist unter dem Begriff 'Fall' \n  meist der Abrechnungskontext gemeint, nicht der einzelne Besuch. Die 'Fallnummer' ist daher nicht der Identifier des Encounters, \n  sondern der des Accounts auf den der Encounter referenziert. \n  Auf diesem Wege können mehrere Besuche einer Fallnummer zugeordnet werden.  \n  Da die Fallnummer ein häufig verwendetes Suchkriterium darstellt, \n  ist diese hier als logische Referenz (`account.identifier`) zu hinterlegen.\n  Damit wird sichergestellt, dass diese als Suchparameter für die Suche nach Encountern zur Verfügung steht, \n  auch wenn einzelne Systeme kein Chaining unterstützen oder einzelne Benutzer keine Sichtberechtigung auf Abrechnungsdaten haben,\n  im Versorgunskontext aber dennoch Encounter anhand der assoziierten Fallnummer suchen möchten." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.account.reference" ] ;
       fhir:path [ fhir:v "Encounter.account.reference" ] ;
       fhir:short [ fhir:v "Account-Link" ] ;
       fhir:comment [ fhir:v "**Begründung MS:** Die Verlinkung auf eine Account-Ressource dient der technischen Zuordnung des Besuchs zu einem Abrechnungskontext \n  und ermöglicht wichtige API-Funktionen wie verkettete Suche, (Reverse-)Include etc." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.account.identifier" ] ;
       fhir:path [ fhir:v "Encounter.account.identifier" ] ;
       fhir:short [ fhir:v "(Abrechnungs-)Fallnummer" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.account.identifier.system" ] ;
       fhir:path [ fhir:v "Encounter.account.identifier.system" ] ;
       fhir:short [ fhir:v "Namensraum des Identifiers" ] ;
       fhir:comment [ fhir:v "Hier ist stets der eindeutige Name (URL) des Namensraums anzugeben, \n      aus dem der Identifier stammt. \n      Hinweise zur Festlegung der URLs für lokale Namensräume sind in den \n      [Deutschen Basisprofilen](https://simplifier.net/guide/leitfaden-de-basis-r4/ig-markdown-Terminologie-Namensraeume?version=current) beschrieben.  \n      **Begründung Pflichtfeld:** `system` stellt in Kombination mit `value` die Eindeutigkeit eines Identifiers sicher." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.account.identifier.value" ] ;
       fhir:path [ fhir:v "Encounter.account.identifier.value" ] ;
       fhir:comment [ fhir:v "Enthält den eigentlichen Wert des Identifiers.  \n        **Begründung Pflichtfeld:** Ist der Wert nicht bekannt, sollte der gesamte Slice weggelassen werden." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.hospitalization" ] ;
       fhir:path [ fhir:v "Encounter.hospitalization" ] ;
       fhir:short [ fhir:v "Details zum Aufenthalt" ] ;
       fhir:comment [ fhir:v "Details zu einem stationären Aufenthalt" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.hospitalization.extension" ] ;
       fhir:path [ fhir:v "Encounter.hospitalization.extension" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "value" ] ;
           fhir:path [ fhir:v "url" ]
         ] ) ;
         fhir:ordered [ fhir:v false ] ;
         fhir:rules [ fhir:v "open" ]
       ]
     ] [
       fhir:id [ fhir:v "Encounter.hospitalization.extension:Wahlleistung" ] ;
       fhir:path [ fhir:v "Encounter.hospitalization.extension" ] ;
       fhir:sliceName [ fhir:v "Wahlleistung" ] ;
       fhir:short [ fhir:v "Wahlleistung" ] ;
       fhir:comment [ fhir:v "**Begründung MS:**  Vom Patienten gebuchte Wahlleistungen (z.B. Chefarztbehandlung, Einzelzimmer) \n    sind häufig system- und abteilungsübergreifend zu beachten und sollten daher über die Schnittstelle kommuniziert werden können." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "*" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Extension"^^xsd:anyURI ;
           fhir:l fhir:Extension
         ] ;
         fhir:profile ( [
           fhir:v "http://fhir.de/StructureDefinition/Wahlleistung"^^xsd:anyURI ;
           fhir:l <http://fhir.de/StructureDefinition/Wahlleistung>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.hospitalization.admitSource" ] ;
       fhir:path [ fhir:v "Encounter.hospitalization.admitSource" ] ;
       fhir:short [ fhir:v "Aufnahmeanlass" ] ;
       fhir:comment [ fhir:v "Anlass der stationären Aufnahme, z.B. &quot;Einweisung&quot;, &quot;Notfall&quot; etc.  \n      Begründung MS: Zur Harmonisierung den Festlegungen der Medizininformatik-Initiative" ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "extensible" ] ;
         fhir:valueSet [
           fhir:v "http://fhir.de/ValueSet/dgkev/Aufnahmeanlass"^^xsd:anyURI ;
           fhir:l <http://fhir.de/ValueSet/dgkev/Aufnahmeanlass>
         ]
       ]
     ] [
       fhir:id [ fhir:v "Encounter.hospitalization.dischargeDisposition" ] ;
       fhir:path [ fhir:v "Encounter.hospitalization.dischargeDisposition" ] ;
       fhir:short [ fhir:v "Entlassungsart bzw. -grund" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Encounter.hospitalization.dischargeDisposition.extension:Entlassungsgrund" ] ;
       fhir:path [ fhir:v "Encounter.hospitalization.dischargeDisposition.extension" ] ;
       fhir:sliceName [ fhir:v "Entlassungsgrund" ] ;
       fhir:short [ fhir:v "Entlassungsgrund" ] ;
       fhir:comment [ fhir:v "Entlassungsgrund nach § 301 Abs. 3 SGB V  \n        **Einschränkung MS:** Der Entlassungsgrund muss nur implementiert werden,\n         wenn das bestätigungsrelevante System in der Akutversorgung eingesetzt wird." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Extension"^^xsd:anyURI ;
           fhir:l fhir:Extension
         ] ;
         fhir:profile ( [
           fhir:v "http://fhir.de/StructureDefinition/Entlassungsgrund"^^xsd:anyURI ;
           fhir:l <http://fhir.de/StructureDefinition/Entlassungsgrund>
         ] )
