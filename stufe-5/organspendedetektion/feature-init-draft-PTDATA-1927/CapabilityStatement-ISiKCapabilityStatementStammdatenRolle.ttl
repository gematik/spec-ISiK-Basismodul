     fhir:v "https://gematik.de/fhir/isik/CapabilityStatement/ISiKCapabilityStatementStammdatenRolle"^^xsd:anyURI ;
     fhir:l <https://gematik.de/fhir/isik/CapabilityStatement/ISiKCapabilityStatementStammdatenRolle>
  ] ; # 
  fhir:version [ fhir:v "0.0.1"] ; # 
  fhir:name [ fhir:v "ISiKCapabilityStatementStammdatenRolle"] ; # 
  fhir:title [ fhir:v "CapabilityStatement für Rolle &quot;StammdatenRolle&quot;"] ; # 
  fhir:status [ fhir:v "active"] ; # 
  fhir:experimental [ fhir:v false] ; # 
  fhir:date [ fhir:v "2025-12-17"^^xsd:date] ; # 
  fhir:contact ( [
