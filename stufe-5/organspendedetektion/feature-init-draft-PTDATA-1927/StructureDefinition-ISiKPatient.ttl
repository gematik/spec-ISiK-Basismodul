               fhir:l <http://fhir.de/CodeSystem/identifier-type-de-basis>
             ] ;
             fhir:code [ fhir:v "KVZ10" ]
           ] )
         ]
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.identifier:VersichertenId.type" ] ;
       fhir:path [ fhir:v "Patient.identifier.type" ] ;
       fhir:short [ fhir:v "Art des Identifiers" ] ;
       fhir:comment [ fhir:v "Hier ist stets der Code `KVZ10` \n    aus dem CodeSystem `http://fhir.de/CodeSystem/identifier-type-de-basis` anzugeben.  \n    **Begründung Pflichtfeld:** `type` dient der Unterscheidung verschiedener Identifier-Typen" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
