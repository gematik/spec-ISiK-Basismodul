       fhir:path [ fhir:v "Patient.identifier.system" ] ;
       fhir:short [ fhir:v "Namensraum der Versichertennummer" ] ;
       fhir:comment [ fhir:v "Hier ist stets der Wert `http://fhir.de/sid/gkv/kvid-10` anzugeben.  \n    **Begründung Pflichtfeld:** `system` stellt in Kombination mit `value` die Eindeutigkeit eines Identifiers sicher." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.identifier:VersichertenId.value" ] ;
       fhir:path [ fhir:v "Patient.identifier.value" ] ;
       fhir:short [ fhir:v "Lebenslange Krankenversichertennummer" ] ;
       fhir:comment [ fhir:v "Der 10-stellige, unveränderbare Teil der Versichertennummer." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.identifier:VersichertenId-GKV" ] ;
       fhir:path [ fhir:v "Patient.identifier" ] ;
       fhir:sliceName [ fhir:v "VersichertenId-GKV" ] ;
       fhir:short [ fhir:v "Gesetzliche Krankenversichertennummer" ] ;
       fhir:comment [ fhir:v "**WARNUNG**: Die Verwendung der 'GKV'-Kodierung einer Versichertennummer ist abgekündigt,\n  da die lebenslangen Versichertennummer ab 2024 auch für PKV oder Sonderkostenträger eingeführt wird. \n  Bitte statt dessen künftig den 'VersichertenId'-Slice verwenden." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Identifier"^^xsd:anyURI ;
           fhir:l fhir:Identifier
         ] ;
         fhir:profile ( [
           fhir:v "http://fhir.de/StructureDefinition/identifier-kvid-10"^^xsd:anyURI ;
           fhir:l <http://fhir.de/StructureDefinition/identifier-kvid-10>
         ] )
       ] ) ;
