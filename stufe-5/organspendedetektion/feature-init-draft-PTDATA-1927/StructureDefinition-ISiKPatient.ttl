       fhir:path [ fhir:v "Patient.identifier.type" ] ;
       fhir:short [ fhir:v "Art des Identifiers" ] ;
       fhir:comment [ fhir:v "Hier ist stets der Code `PKV` \n    aus dem CodeSystem `http://fhir.de/CodeSystem/identifier-type-de-basis` anzugeben.  \n    **Begründung Pflichtfeld:** `type` dient der Unterscheidung verschiedener Identifier-Typen" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.identifier:Versichertennummer_PKV.value" ] ;
       fhir:path [ fhir:v "Patient.identifier.value" ] ;
       fhir:short [ fhir:v "Private Krankenversichertennummer" ] ;
       fhir:comment [ fhir:v "Enthält den eigentlichen Wert des Identifiers.  \n    **Begründung Pflichtfeld:** Ist der Wert nicht bekannt, sollte der gesamte Slice weggelassen werden." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.identifier:Versichertennummer_PKV.assigner" ] ;
       fhir:path [ fhir:v "Patient.identifier.assigner" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.identifier:Versichertennummer_PKV.assigner.identifier.system" ] ;
       fhir:path [ fhir:v "Patient.identifier.assigner.identifier.system" ] ;
       fhir:short [ fhir:v "Namensraum des Identifiers" ] ;
       fhir:comment [ fhir:v "Hier ist stets der Wert `http://fhir.de/sid/arge-ik/iknr` anzugeben." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.identifier:Versichertennummer_PKV.assigner.identifier.value" ] ;
       fhir:path [ fhir:v "Patient.identifier.assigner.identifier.value" ] ;
       fhir:short [ fhir:v "IK-Nummer des Kostenträgers" ] ;
       fhir:comment [ fhir:v "IK-Nummer des Kostenträgers, aus dessen Nummernkreis die PKV-Nummer stammt." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.identifier:Versichertennummer_PKV.assigner.display" ] ;
       fhir:path [ fhir:v "Patient.identifier.assigner.display" ] ;
       fhir:short [ fhir:v "Name des Kostenträgers" ] ;
       fhir:comment [ fhir:v "Name des Kostenträgers, aus dessen Nummernkreis die PKV-Nummer stammt." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.active" ] ;
       fhir:path [ fhir:v "Patient.active" ] ;
       fhir:short [ fhir:v "Status des Datensatzes" ] ;
       fhir:comment [ fhir:v "\n  `true` = Der Datensatz befindet sich in Verwendung/kann verwendet werden  \n  `false`= Der Datensatz wurde storniert (z.B. bei Dubletten, Merge) oder archiviert  \n  **Einschränkung der übergreifenden MS-Definition:**  \n  Verfügt ein bestätigungsrelevantes System nicht über die Datenstruktur zur Hinterlegung des Aktivitätsstatus einer Patienten-Ressource, \n  so MUSS dieses System die Information NICHT abbilden. \n  Das System SOLL jedoch den Aktivitätsstatus hart kodieren in der Patienteninstanz \n  (Patient.active auf 'true'), sodass Clients nicht missverständlich mit einer inaktiven \n  Patient-Ressource interagieren." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.name" ] ;
       fhir:path [ fhir:v "Patient.name" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "pattern" ] ;
           fhir:path [ fhir:v "$this" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:comment [ fhir:v "Angabe der Namen" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.name:Name" ] ;
       fhir:path [ fhir:v "Patient.name" ] ;
       fhir:sliceName [ fhir:v "Name" ] ;
       fhir:short [ fhir:v "Offizieller Name" ] ;
       fhir:comment [ fhir:v "Offizieller Name des Patienten, wie er z.B. in Ausweis oder Versicherungsdokumenten erscheint. \n  **Begründung Pflichtfeld:** Der offizielle Name des Patienten ist unerlässlich, um Verwechlungen zu vermeiden und den Patienten im Versorgungskontext korrekt anzusprechen.\n  Wenn kein Name vorliegt, MUSS die [data-absent-reason-Extension](https://www.hl7.org/fhir/R4/extension-data-absent-reason.html) eingesetzt werden.   \n  **Weitere Hinweise:** siehe [Deutsche Basisprofile](https://simplifier.net/guide/leitfaden-de-basis-r4/ig-markdown-Ressourcen-Patient?version=current#ig-markdown-Ressourcen-Patient-Name)" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "HumanName"^^xsd:anyURI ;
           fhir:l fhir:HumanName
         ] ;
         fhir:profile ( [
           fhir:v "http://fhir.de/StructureDefinition/humanname-de-basis"^^xsd:anyURI ;
           fhir:l <http://fhir.de/StructureDefinition/humanname-de-basis>
         ] )
       ] ) ;
       fhir:pattern [
         a fhir:HumanName ;
         fhir:use [ fhir:v "official" ]
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.name:Name.use" ] ;
       fhir:path [ fhir:v "Patient.name.use" ] ;
       fhir:short [ fhir:v "Verwendungszweck" ] ;
       fhir:comment [ fhir:v "Hier ist stets der Wert `official` anzugeben.  \n      **Begründung Pflichtfeld:** Dient als Unterscheidungs- und Auswahlkriterium" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.name:Name.family" ] ;
       fhir:path [ fhir:v "Patient.name.family" ] ;
       fhir:short [ fhir:v "Nachname" ] ;
       fhir:comment [ fhir:v "Vollständiger Nachname bzw. Familienname der Person, einschließlich Vor- und Zusätze.  \n      **Begründung Pflichtfeld:** Ein offizieller Name ist nur zulässig, wenn der Nachname und mindestens ein Vorname angegeben sind." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.name:Name.family.extension:namenszusatz" ] ;
       fhir:path [ fhir:v "Patient.name.family.extension" ] ;
       fhir:sliceName [ fhir:v "namenszusatz" ] ;
       fhir:short [ fhir:v "Namenszusatz" ] ;
       fhir:comment [ fhir:v "Enthält ehem. Adelstitel wie z.B. 'Graf', 'Baronesse', 'Freiherr'...  \n        **Begründung MS:** Erforderlich für die verlustfreie Kommunikation von VSDM-Daten." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.name:Name.family.extension:nachname" ] ;
       fhir:path [ fhir:v "Patient.name.family.extension" ] ;
       fhir:sliceName [ fhir:v "nachname" ] ;
       fhir:short [ fhir:v "Nachname" ] ;
       fhir:comment [ fhir:v "Nachname ohne Vor- und Zusätze.  \n        **Begründung MS:** Erforderlich für die verlustfreie Kommunikation von VSDM-Daten." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.name:Name.family.extension:vorsatzwort" ] ;
       fhir:path [ fhir:v "Patient.name.family.extension" ] ;
       fhir:sliceName [ fhir:v "vorsatzwort" ] ;
       fhir:comment [ fhir:v "Enthält Vorsätze, die vor dem Nachnamen stehen, z.B. 'von', 'van', 'zu'...  \n        **Begründung MS:** Erforderlich für die verlustfreie Kommunikation von VSDM-Daten." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.name:Name.given" ] ;
       fhir:path [ fhir:v "Patient.name.given" ] ;
       fhir:comment [ fhir:v "Kann mehrfach verwendet werden, um den Rufnamen sowie weitere Vornamen, Mittelnamen oder Mittel-Initialen abzubilden.\n      **Begründung Pflichtfeld:** Ein offizieller Name ist nur zulässig, wenn der Nachname und mindestens ein Vorname angegeben sind." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.name:Name.prefix" ] ;
       fhir:path [ fhir:v "Patient.name.prefix" ] ;
       fhir:short [ fhir:v "Präfix" ] ;
       fhir:comment [ fhir:v "Präfix, z.B. akademischer Titel od. militärischer Rang" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.name:Name.prefix.extension:prefix-qualifier" ] ;
       fhir:path [ fhir:v "Patient.name.prefix.extension" ] ;
       fhir:sliceName [ fhir:v "prefix-qualifier" ] ;
       fhir:short [ fhir:v "Extension, um das Präfix als akademischen Titel zu qualifizieren" ] ;
       fhir:comment [ fhir:v "Hier ist stets der Wert `AC` anzugeben.  \n        **Begründung MS:** Erforderlich für die verlustfreie Kommunikation von VSDM-Daten." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.name:Name.prefix.extension:prefix-qualifier.value[x]" ] ;
       fhir:path [ fhir:v "Patient.name.prefix.extension.value[x]" ] ;
       fhir:fixed [
         a fhir:Code ;
         fhir:v "AC"
       ]
     ] [
       fhir:id [ fhir:v "Patient.name:Geburtsname" ] ;
       fhir:path [ fhir:v "Patient.name" ] ;
       fhir:sliceName [ fhir:v "Geburtsname" ] ;
       fhir:short [ fhir:v "Geburtsname" ] ;
       fhir:comment [ fhir:v "Familienname zum Zeitpunkt der Geburt, sofern abweichend vom offiziellen Namen." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "HumanName"^^xsd:anyURI ;
           fhir:l fhir:HumanName
         ] ;
         fhir:profile ( [
           fhir:v "http://fhir.de/StructureDefinition/humanname-de-basis"^^xsd:anyURI ;
           fhir:l <http://fhir.de/StructureDefinition/humanname-de-basis>
         ] )
       ] ) ;
       fhir:pattern [
         a fhir:HumanName ;
         fhir:use [ fhir:v "maiden" ]
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.name:Geburtsname.use" ] ;
       fhir:path [ fhir:v "Patient.name.use" ] ;
       fhir:short [ fhir:v "Verwendungszweck" ] ;
       fhir:comment [ fhir:v "Hier ist stets der Wert `maiden` anzugeben.  \n      **Begründung Pflichtfeld:** Dient als Unterscheidungs- und Auswahlkriterium" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.name:Geburtsname.family" ] ;
       fhir:path [ fhir:v "Patient.name.family" ] ;
       fhir:short [ fhir:v "Nachname" ] ;
       fhir:comment [ fhir:v "Vollständiger Nachname bzw. Familienname des Patienten, einschließlich Vor- und Zusätze.  \n      **Begründung Pflichtfeld:** Ist der Nachname zum Zeitpunkt der Geburt nicht bekannt, sollte der gesamte Slice weggelassen werden." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.name:Geburtsname.family.extension:namenszusatz" ] ;
       fhir:path [ fhir:v "Patient.name.family.extension" ] ;
       fhir:sliceName [ fhir:v "namenszusatz" ] ;
       fhir:short [ fhir:v "Namenszusatz" ] ;
       fhir:comment [ fhir:v "Enthält ehem. Adelstitel wie z.B. 'Graf', 'Baronesse', 'Freiherr'...  \n        **Begründung MS:** Erforderlich für die verlustfreie Kommunikation von VSDM-Daten." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.name:Geburtsname.family.extension:nachname" ] ;
       fhir:path [ fhir:v "Patient.name.family.extension" ] ;
       fhir:sliceName [ fhir:v "nachname" ] ;
       fhir:short [ fhir:v "Nachname" ] ;
       fhir:comment [ fhir:v "Nachname ohne Vor- und Zusätze.  \n        **Begründung MS:** Erforderlich für die verlustfreie Kommunikation von VSDM-Daten." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.name:Geburtsname.family.extension:vorsatzwort" ] ;
       fhir:path [ fhir:v "Patient.name.family.extension" ] ;
       fhir:sliceName [ fhir:v "vorsatzwort" ] ;
       fhir:comment [ fhir:v "Enthält Vorsätze, die vor dem Nachnamen stehen, z.B. 'von', 'van', 'zu'...  \n        **Begründung MS:** Erforderlich für die verlustfreie Kommunikation von VSDM-Daten." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.name:Geburtsname.given" ] ;
       fhir:path [ fhir:v "Patient.name.given" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Patient.name:Geburtsname.prefix" ] ;
       fhir:path [ fhir:v "Patient.name.prefix" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Patient.telecom" ] ;
       fhir:path [ fhir:v "Patient.telecom" ] ;
       fhir:short [ fhir:v "Angabe der Kontaktdaten" ] ;
       fhir:comment [ fhir:v "Angabe der Kontaktdaten des Patienten, z.B. Telefonnummer oder E-Mail-Adresse.\n  **Bedingtes MS:** Kontaktdaten sind im Kontext der Terminplanung unerlässlich, z.B. für Terminvereinbarungen oder Rückfragen. Das Must-Support gilt ausschließlich für Systeme, die\n  Kontaktdaten persistieren." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.telecom.system" ] ;
       fhir:path [ fhir:v "Patient.telecom.system" ] ;
       fhir:short [ fhir:v "Art der Kontaktdaten" ] ;
       fhir:comment [ fhir:v "Hier ist der Art der Kontaktdaten anzugeben, z.B. `phone` für Telefonnummer oder `email` für E-Mail-Adresse.  \n      **Begründung Pflichtfeld:** Dient der Unterscheidung verschiedener Kontaktarten" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.telecom.value" ] ;
       fhir:path [ fhir:v "Patient.telecom.value" ] ;
       fhir:short [ fhir:v "Wert der Kontaktdaten" ] ;
       fhir:comment [ fhir:v "Enthält den eigentlichen Wert der Kontaktdaten, z.B. die Telefonnummer oder E-Mail-Adresse.  \n      **Begründung Pflichtfeld:** Ohne diese Angabe sind die Kontaktdaten nicht nutzbar." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.gender" ] ;
       fhir:path [ fhir:v "Patient.gender" ] ;
       fhir:short [ fhir:v "Administratives Geschlecht" ] ;
       fhir:comment [ fhir:v "Für die Geschlechtskennzeichen 'unbestimmt' und 'divers' ist der international vereinbarte code `other` zu verwenden.\n    Zur weiteren Differenzierung kann dann die Extension `Geschlecht-Admnistrativ` verwendet werden.\n    **Begründung Pflichtfeld:** Die Geschlechtsangabe ist für viele Versorgungsprozesse unerlässlich, z.B.  \n* Bettendisposition\n* Ermittlung von Referenzwerten\n* korrekte Anrede des Patienten  \n    **Weitere Hinweise:** siehe [Deutsche Basisprofile](https://simplifier.net/guide/leitfaden-de-basis-r4/ig-markdown-Ressourcen-Patient?version=current#ig-markdown-Ressourcen-Patient-Geschlecht)" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.gender.extension" ] ;
       fhir:path [ fhir:v "Patient.gender.extension" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "value" ] ;
           fhir:path [ fhir:v "url" ]
         ] ) ;
         fhir:ordered [ fhir:v false ] ;
         fhir:rules [ fhir:v "open" ]
       ]
     ] [
       fhir:id [ fhir:v "Patient.gender.extension:Geschlecht-Administrativ" ] ;
       fhir:path [ fhir:v "Patient.gender.extension" ] ;
       fhir:sliceName [ fhir:v "Geschlecht-Administrativ" ] ;
       fhir:short [ fhir:v "Extension zur Differenzierung des Geschlechtskennzeichens" ] ;
       fhir:comment [ fhir:v "Diese Extension darf nur in Verbindung mit dem Geschlechtskennzeichen `other` verwendet werden\n      und dient der Differenzierung zwischen den in Deutschland möglichen Geschlechtskennzeichen `D` (divers) und `X`(unbestimmt)" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Extension"^^xsd:anyURI ;
           fhir:l fhir:Extension
         ] ;
         fhir:profile ( [
           fhir:v "http://fhir.de/StructureDefinition/gender-amtlich-de"^^xsd:anyURI ;
           fhir:l <http://fhir.de/StructureDefinition/gender-amtlich-de>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.birthDate" ] ;
       fhir:path [ fhir:v "Patient.birthDate" ] ;
       fhir:short [ fhir:v "Geburtsdatum" ] ;
       fhir:comment [ fhir:v "Tages-, monats- oder jahresgenaues Geburtsdatum.  \n    **Begründung Pflichtfeld:** Das Geburstdatum dient - in Verbindung mit dem Namen - als wichtiges Such- und Unterscheidungskriterium.  \n    **Weitere Hinweise:** siehe [Deutsche Basisprofile](https://simplifier.net/guide/leitfaden-de-basis-r4/ig-markdown-Ressourcen-Patient?version=current#ig-markdown-Ressourcen-Patient-Geburtsdatum)" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.birthDate.extension" ] ;
       fhir:path [ fhir:v "Patient.birthDate.extension" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "value" ] ;
           fhir:path [ fhir:v "url" ]
         ] ) ;
         fhir:ordered [ fhir:v false ] ;
         fhir:rules [ fhir:v "open" ]
       ]
     ] [
       fhir:id [ fhir:v "Patient.birthDate.extension:Data-Absent-Reason" ] ;
       fhir:path [ fhir:v "Patient.birthDate.extension" ] ;
       fhir:sliceName [ fhir:v "Data-Absent-Reason" ] ;
       fhir:short [ fhir:v "Begründung für fehlende Information" ] ;
       fhir:comment [ fhir:v "ToDo" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Extension"^^xsd:anyURI ;
           fhir:l fhir:Extension
         ] ;
         fhir:profile ( [
           fhir:v "http://hl7.org/fhir/StructureDefinition/data-absent-reason"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/StructureDefinition/data-absent-reason>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.birthDate.extension:Data-Absent-Reason.value[x]" ] ;
       fhir:path [ fhir:v "Patient.birthDate.extension.value[x]" ] ;
       fhir:fixed [
         a fhir:Code ;
         fhir:v "unknown"
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.deceased[x]" ] ;
       fhir:path [ fhir:v "Patient.deceased[x]" ] ;
       fhir:comment [ fhir:v "**Einschränkung der übergreifenden MS-Definition:** Die Implementierung dieses Elements ist für Server optional. Die Kennzeichnung als Must-Support erfolgt, da es sich um ein als Modifier-Element markiertes Feld in der Kernspezifikation handelt. \n  \n    **WICHTIGER Hinweis für Implementierer:**  \n  * Alle server-seitigen Implementierungen SOLLEN in der Lage sein, die systemintern möglichen Statuswerte korrekt in FHIR abzubilden.\n  * Alle client-seitigen Implementierungen SOLLEN in der Lage sein, sämtliche Status-Codes zu interpretieren und dem Anwender in angemessener Form darstellen zu können." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address" ] ;
       fhir:path [ fhir:v "Patient.address" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "pattern" ] ;
           fhir:path [ fhir:v "$this" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:comment [ fhir:v "Angabe der Adressen" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address:Strassenanschrift" ] ;
       fhir:path [ fhir:v "Patient.address" ] ;
       fhir:sliceName [ fhir:v "Strassenanschrift" ] ;
       fhir:short [ fhir:v "Straßenanschrift" ] ;
       fhir:comment [ fhir:v "Wohn- oder Aufenthaltsort des Patienten" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "*" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Address"^^xsd:anyURI ;
           fhir:l fhir:Address
         ] ;
         fhir:profile ( [
           fhir:v "http://fhir.de/StructureDefinition/address-de-basis"^^xsd:anyURI ;
           fhir:l <http://fhir.de/StructureDefinition/address-de-basis>
         ] )
       ] ) ;
       fhir:pattern [
         a fhir:Address ;
         fhir:type [ fhir:v "both" ]
       ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "address-cnt-2or3-char" ] ;
         fhir:severity [ fhir:v "warning" ] ;
         fhir:human [ fhir:v "The content of the country element (if present) SHALL be selected EITHER from ValueSet ISO Country Alpha-2 http://hl7.org/fhir/ValueSet/iso3166-1-2 OR MAY be selected from ISO Country Alpha-3 Value Set http://hl7.org/fhir/ValueSet/iso3166-1-3, IF the country is not specified in value Set ISO Country Alpha-2 http://hl7.org/fhir/ValueSet/iso3166-1-2." ] ;
         fhir:expression [ fhir:v "country.empty() or (country.memberOf('http://hl7.org/fhir/ValueSet/iso3166-1-2') or country.memberOf('http://hl7.org/fhir/ValueSet/iso3166-1-3'))" ] ;
         fhir:source [
           fhir:v "https://gematik.de/fhir/isik/StructureDefinition/ISiKPatient"^^xsd:anyURI ;
           fhir:l <https://gematik.de/fhir/isik/StructureDefinition/ISiKPatient>
         ]
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address:Strassenanschrift.extension:Stadtteil" ] ;
       fhir:path [ fhir:v "Patient.address.extension" ] ;
       fhir:sliceName [ fhir:v "Stadtteil" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address:Strassenanschrift.type" ] ;
       fhir:path [ fhir:v "Patient.address.type" ] ;
       fhir:short [ fhir:v "Adresstyp" ] ;
       fhir:comment [ fhir:v "Hier ist stets der Wert `both` anzugeben.  \n    **Begründung Pflichtfeld:** Dient als Unterscheidungs- und Auswahlkriterium" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address:Strassenanschrift.line" ] ;
       fhir:path [ fhir:v "Patient.address.line" ] ;
       fhir:short [ fhir:v "Adresszeile" ] ;
       fhir:comment [ fhir:v "Diese Komponente kann Straßennamen, Hausnummer, Appartmentnummer, c/o \n    sowie weitere Zustellungshinweise enthalten. \n    Die Informationen können in mehrere line-Komponenten aufgeteilt werden. \n    Bei Verwendung der Extensions, um Straße, Hausnnummer und Postleitzahl strukturiert zu übermitteln, \n    müssen diese Informationen stets vollständig auch in der line-Komponente, \n    die sie erweitern, enthalten sein, um es Systemen, die diese Extensions nicht verwenden zu ermöglichen, \n    auf diese Informationen zugreifen zu können.  \n    **Begründung Pflichtfeld:** Ohne diese Angabe ist die Adresse nicht zustellbar.  \n    **Begründung für Reduktion der max. Kardinalität:** Die maximale Kardinalität wurde in Übereinstimmung mit der \n    DIN-Norm 5008 (Schreib- und Gestaltungsregeln für die Text- und Informationsverarbeitung) auf 3 beschränkt." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address:Strassenanschrift.line.extension:Strasse" ] ;
       fhir:path [ fhir:v "Patient.address.line.extension" ] ;
       fhir:sliceName [ fhir:v "Strasse" ] ;
       fhir:short [ fhir:v "Strassenname" ] ;
       fhir:comment [ fhir:v "Strassenname (ohne Hausnummer).\n        Bei Angabe einer Strasse in dieser Extension muss diese auch in Address.line angegeben werden,\n        um die Interoperabilität mit Systemen zu gewährleisten, die diese Extension nicht verwenden.  \n        **Begründung MS:** Erforderlich für die verlustfreie Kommunikation von VSDM-Daten." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address:Strassenanschrift.line.extension:Hausnummer" ] ;
       fhir:path [ fhir:v "Patient.address.line.extension" ] ;
       fhir:sliceName [ fhir:v "Hausnummer" ] ;
       fhir:comment [ fhir:v "Hausnummer, sowie Zusätze (Appartmentnummer, Etage...). \n        Bei Angabe einer Hausnummer in dieser Extension muss diese auch in Address.line angegeben werden,\n        um die Interoperabilität mit Systemen zu gewährleisten, die diese Extension nicht verwenden.   \n        **Begründung MS:** Erforderlich für die verlustfreie Kommunikation von VSDM-Daten." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address:Strassenanschrift.line.extension:Adresszusatz" ] ;
       fhir:path [ fhir:v "Patient.address.line.extension" ] ;
       fhir:sliceName [ fhir:v "Adresszusatz" ] ;
       fhir:comment [ fhir:v "Zusätzliche Informationen, wie z.B. '3. Etage', 'Appartment C'.\n        Bei Angabe einer Zusatzinformation in dieser Extension muss diese auch in Address.line angegeben werden,\n        um die Interoperabilität mit Systemen zu gewährleisten, die diese Extension nicht verwenden.  \n        **Begründung MS:** Erforderlich für die verlustfreie Kommunikation von VSDM-Daten." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address:Strassenanschrift.line.extension:Postfach" ] ;
       fhir:path [ fhir:v "Patient.address.line.extension" ] ;
       fhir:sliceName [ fhir:v "Postfach" ] ;
       fhir:short [ fhir:v "Postfachnummer" ] ;
       fhir:comment [ fhir:v "Postfach-Adresse. Bei Angabe eines Postfaches in dieser Extension muss das Postfach auch in Address.line angegeben werden,\n        um die Interoperabilität mit Systemen zu gewährleisten, die diese Extension nicht verwenden. \n        Eine Postfach-Adresse darf nicht in Verbindung mit Address.type `physical` oder `both` verwendet werden.  \n        **Begründung MS:** Erforderlich für die verlustfreie Kommunikation von VSDM-Daten." ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Patient.address:Strassenanschrift.city" ] ;
       fhir:path [ fhir:v "Patient.address.city" ] ;
       fhir:short [ fhir:v "Stadt" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Ohne diese Angabe ist die Adresse nicht zustellbar." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address:Strassenanschrift.postalCode" ] ;
       fhir:path [ fhir:v "Patient.address.postalCode" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Ohne diese Angabe ist die Adresse nicht zustellbar." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address:Strassenanschrift.country" ] ;
       fhir:path [ fhir:v "Patient.address.country" ] ;
       fhir:short [ fhir:v "Land" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Ohne diese Angabe ist die Adresse nicht zustellbar." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address:Postfach" ] ;
       fhir:path [ fhir:v "Patient.address" ] ;
       fhir:sliceName [ fhir:v "Postfach" ] ;
       fhir:short [ fhir:v "Postfachadresse" ] ;
       fhir:comment [ fhir:v "Adresse, die nur für postalische Zustellung genutzt werden kann." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "*" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Address"^^xsd:anyURI ;
           fhir:l fhir:Address
         ] ;
         fhir:profile ( [
           fhir:v "http://fhir.de/StructureDefinition/address-de-basis"^^xsd:anyURI ;
           fhir:l <http://fhir.de/StructureDefinition/address-de-basis>
         ] )
       ] ) ;
       fhir:pattern [
         a fhir:Address ;
         fhir:type [ fhir:v "postal" ]
       ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "address-cnt-2or3-char" ] ;
         fhir:severity [ fhir:v "warning" ] ;
         fhir:human [ fhir:v "The content of the country element (if present) SHALL be selected EITHER from ValueSet ISO Country Alpha-2 http://hl7.org/fhir/ValueSet/iso3166-1-2 OR MAY be selected from ISO Country Alpha-3 Value Set http://hl7.org/fhir/ValueSet/iso3166-1-3, IF the country is not specified in value Set ISO Country Alpha-2 http://hl7.org/fhir/ValueSet/iso3166-1-2." ] ;
         fhir:expression [ fhir:v "country.empty() or (country.memberOf('http://hl7.org/fhir/ValueSet/iso3166-1-2') or country.memberOf('http://hl7.org/fhir/ValueSet/iso3166-1-3'))" ] ;
         fhir:source [
           fhir:v "https://gematik.de/fhir/isik/StructureDefinition/ISiKPatient"^^xsd:anyURI ;
           fhir:l <https://gematik.de/fhir/isik/StructureDefinition/ISiKPatient>
         ]
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address:Postfach.type" ] ;
       fhir:path [ fhir:v "Patient.address.type" ] ;
       fhir:short [ fhir:v "Adresstyp" ] ;
       fhir:comment [ fhir:v "Hier ist stets der Wert `postal` anzugeben.  \n    **Begründung Pflichtfeld:** Dient als Unterscheidungs- und Auswahlkriterium" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address:Postfach.line" ] ;
       fhir:path [ fhir:v "Patient.address.line" ] ;
       fhir:short [ fhir:v "Adresszeile" ] ;
       fhir:comment [ fhir:v "Diese Komponente enthält die Postfachadresse als String der Form 'Postfach: 12345'.\n    Bei Verwendung der Postfach-Extension, um die Postfachnummer strukturiert zu übermitteln, \n    müssen diese Informationen stets vollständig auch in der line-Komponente, \n    die sie erweitern, enthalten sein, um es Systemen, die diese Extensions nicht verwenden zu ermöglichen, \n    auf diese Informationen zugreifen zu können.  \n    **Begründung Pflichtfeld:** Ohne diese Angabe ist die Adresse nicht zustellbar.  \n    **Begründung für Reduktion der max. Kardinalität:** Die maximale Kardinalität wurde in Übereinstimmung mit der \n    DIN-Norm 5008 (Schreib- und Gestaltungsregeln für die Text- und Informationsverarbeitung) auf 3 beschränkt." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address:Postfach.line.extension:Strasse" ] ;
       fhir:path [ fhir:v "Patient.address.line.extension" ] ;
       fhir:sliceName [ fhir:v "Strasse" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Patient.address:Postfach.line.extension:Hausnummer" ] ;
       fhir:path [ fhir:v "Patient.address.line.extension" ] ;
       fhir:sliceName [ fhir:v "Hausnummer" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Patient.address:Postfach.line.extension:Adresszusatz" ] ;
       fhir:path [ fhir:v "Patient.address.line.extension" ] ;
       fhir:sliceName [ fhir:v "Adresszusatz" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "Patient.address:Postfach.line.extension:Postfach" ] ;
       fhir:path [ fhir:v "Patient.address.line.extension" ] ;
       fhir:sliceName [ fhir:v "Postfach" ] ;
       fhir:short [ fhir:v "Postfachnummer" ] ;
       fhir:comment [ fhir:v "Postfach-Adresse. Bei Angabe eines Postfaches in dieser Extension muss das Postfach auch in Address.line angegeben werden,\n        um die Interoperabilität mit Systemen zu gewährleisten, die diese Extension nicht verwenden. \n        Eine Postfach-Adresse darf nicht in Verbindung mit Address.type `physical` oder `both` verwendet werden.  \n        **Begründung MS:** Erforderlich für die verlustfreie Kommunikation von VSDM-Daten." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address:Postfach.city" ] ;
       fhir:path [ fhir:v "Patient.address.city" ] ;
       fhir:short [ fhir:v "Stadt" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Ohne diese Angabe ist die Adresse nicht zustellbar." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address:Postfach.postalCode" ] ;
       fhir:path [ fhir:v "Patient.address.postalCode" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Ohne diese Angabe ist die Adresse nicht zustellbar." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.address:Postfach.country" ] ;
       fhir:path [ fhir:v "Patient.address.country" ] ;
       fhir:short [ fhir:v "Land" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Ohne diese Angabe ist die Adresse nicht zustellbar." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.link" ] ;
       fhir:path [ fhir:v "Patient.link" ] ;
       fhir:short [ fhir:v "Link" ] ;
       fhir:comment [ fhir:v "Dieses und untergeordnete Elemente KÖNNEN bei einem erfolgten Patient merge entsprechend der Festlegungen unter {{pagelink:Patient-merge}} befüllt werden. \n  Da das Element der Unterstützung der Patient merge Notification dient, \n  MUSS es im Rahmen des Bestätigungsverfahrens NICHT unterstützt werden (Stand: Stufe 4)." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.link.other" ] ;
       fhir:path [ fhir:v "Patient.link.other" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.link.other.identifier" ] ;
       fhir:path [ fhir:v "Patient.link.other.identifier" ] ;
       fhir:comment [ fhir:v "Logischer Verweis auf Identifier[Patientennummer]" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Patient.link.type" ] ;
       fhir:path [ fhir:v "Patient.link.type" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] )
  ] . # 

