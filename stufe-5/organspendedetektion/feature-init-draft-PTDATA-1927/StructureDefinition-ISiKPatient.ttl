       fhir:constraint ( [
         fhir:key [ fhir:v "isik-pat-1" ] ;
         fhir:severity [ fhir:v "error" ] ;
         fhir:human [ fhir:v "Falls die Geschlechtsangabe 'other' gewählt wird, muss die amtliche Differenzierung per Extension angegeben werden" ] ;
         fhir:expression [ fhir:v "gender.exists() and gender='other' implies gender.extension('http://fhir.de/StructureDefinition/gender-amtlich-de').exists()" ] ;
         fhir:source [
           fhir:v "https://gematik.de/fhir/isik/StructureDefinition/ISiKPatient"^^xsd:anyURI ;
           fhir:l <https://gematik.de/fhir/isik/StructureDefinition/ISiKPatient>
         ]
       ] )
     ] [
       fhir:id [ fhir:v "Patient.id" ] ;
       fhir:path [ fhir:v "Patient.id" ] ;
       fhir:short [ fhir:v "serverseitige, interne ID des Datensatzes" ] ;
       fhir:comment [ fhir:v "**bedingtes Pflichtfeld/bedingtes MS:** Alle von einem Server bereitgestellten Ressourcen MÜSSEN über eine `id` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `id`verfügen. " ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
