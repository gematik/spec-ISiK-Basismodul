         ] )
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Organization.type:ErweiterterFachabteilungsschluessel" ] ;
       fhir:path [ fhir:v "Organization.type" ] ;
       fhir:sliceName [ fhir:v "ErweiterterFachabteilungsschluessel" ] ;
       fhir:short [ fhir:v "Angabe des §301 Fachabteilungsschlüssel" ] ;
       fhir:comment [ fhir:v "Motivation: Das ValueSet muss bindend sein, damit Systemübergreifend der Fachabteilungstyp einheitlich kodiert werden kann. \n  \n  Dieses ValueSet KANN über ein Mapping (siehe Abschnitt https://wiki.hl7.de/index.php?title=IG:Value_Sets_f%C3%BCr_XDS#DocumentEntry.practiceSettingCode) mit dem ValueSet der Fachrichtung verknüpft werden und darüber ggf. die Integration von Systemen erleichtern." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:mustSupport [ fhir:v true ] ;
       fhir:binding [
         fhir:strength [ fhir:v "required" ] ;
         fhir:valueSet [
           fhir:v "http://fhir.de/ValueSet/dkgev/Fachabteilungsschluessel-erweitert"^^xsd:anyURI ;
