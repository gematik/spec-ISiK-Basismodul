       fhir:path [ fhir:v "Organization.address.postalCode" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Organization.address:Postfach.country" ] ;
       fhir:path [ fhir:v "Organization.address.country" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Organization.partOf" ] ;
       fhir:path [ fhir:v "Organization.partOf" ] ;
       fhir:short [ fhir:v "Übergeordnete Organisation" ] ;
       fhir:comment [ fhir:v "Motivation: System muss die Hierarchie einer Organisationseinheit innherhalb einer Organisation zum Abruf bereitstellen, sofern diese Information verfügbar ist." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Organization.contact" ] ;
