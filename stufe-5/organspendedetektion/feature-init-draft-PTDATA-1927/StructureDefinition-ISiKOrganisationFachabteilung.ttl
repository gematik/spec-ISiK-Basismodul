         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:short [ fhir:v "Identifikatoren der Fachabteilung" ] ;
       fhir:comment [ fhir:v "Mindestens ein Identifikator muss für die Fachabteilung angegeben werden." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "Organization.identifier:IKNR" ] ;
       fhir:path [ fhir:v "Organization.identifier" ] ;
