       fhir:l <http://hl7.org/fhir/StructureDefinition/structuredefinition-imposeProfile>
     ] ;
     fhir:value [
       a fhir:Canonical ;
       fhir:v "https://gematik.de/fhir/ti/StructureDefinition/ti-organization|1.1.1"^^xsd:anyURI ;
