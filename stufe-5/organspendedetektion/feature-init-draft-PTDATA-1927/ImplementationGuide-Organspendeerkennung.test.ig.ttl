         fhir:reference [ fhir:v "SearchParameter/Encounter-end-date" ]
       ] ;
       fhir:name [ fhir:v "EndDate" ] ;
       fhir:description [ fhir:v "The actual end date of the Encounter (Backport from R5). The parameter cannot repeat or have multiple values." ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
