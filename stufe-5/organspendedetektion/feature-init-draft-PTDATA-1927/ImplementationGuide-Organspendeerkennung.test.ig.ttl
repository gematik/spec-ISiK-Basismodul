       fhir:reference [
         fhir:l <http://example.org/fhir/test-Organspendeerkennung-ig/StructureDefinition/ISiKSchwangerschaftsstatus> ;
         fhir:reference [ fhir:v "StructureDefinition/ISiKSchwangerschaftsstatus" ]
       ] ;
       fhir:name [ fhir:v "ISiK Schwangerschaftsstatus" ] ;
       fhir:description [ fhir:v "Schwangerschaftsstatus einer Patientin" ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
