           fhir:type [ fhir:v "pattern" ] ;
           fhir:path [ fhir:v "system" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "AllergyIntolerance.reaction.exposureRoute.coding:snomed-ct" ] ;
       fhir:path [ fhir:v "AllergyIntolerance.reaction.exposureRoute.coding" ] ;
       fhir:sliceName [ fhir:v "snomed-ct" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Coding"^^xsd:anyURI ;
           fhir:l fhir:Coding
         ] ;
         fhir:profile ( [
           fhir:v "https://gematik.de/fhir/isik/StructureDefinition/ISiKSnomedCTCoding"^^xsd:anyURI ;
           fhir:l <https://gematik.de/fhir/isik/StructureDefinition/ISiKSnomedCTCoding>
         ] )
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "AllergyIntolerance.reaction.exposureRoute.text" ] ;
       fhir:path [ fhir:v "AllergyIntolerance.reaction.exposureRoute.text" ] ;
