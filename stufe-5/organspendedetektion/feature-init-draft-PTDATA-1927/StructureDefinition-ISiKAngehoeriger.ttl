     ] [
       fhir:id [ fhir:v "RelatedPerson.meta.versionId" ] ;
       fhir:path [ fhir:v "RelatedPerson.meta.versionId" ] ;
       fhir:short [ fhir:v "Eindeutiger Name der serverseitigen Version des Datensatzes" ] ;
       fhir:comment [ fhir:v "Alle von einem Server bereitgestellten Ressourcen SOLLEN über eine `versionID` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `versionID`verfügen. " ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.meta.lastUpdated" ] ;
       fhir:path [ fhir:v "RelatedPerson.meta.lastUpdated" ] ;
       fhir:short [ fhir:v "Zeitpunkt der letzten Änderung" ] ;
       fhir:comment [ fhir:v "Alle von einem Server bereitgestellten Ressourcen SOLLEN über ein `lastUpdate` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über ein `lastUpdate`verfügen. " ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.active" ] ;
       fhir:path [ fhir:v "RelatedPerson.active" ] ;
       fhir:short [ fhir:v "Status des Datensatzes" ] ;
       fhir:comment [ fhir:v "**Einschränkung der übergreifenden MS-Definition:** Die Implementierung dieses Elements ist für Server optional. Die Kennzeichnung als Must-Support erfolgt, da es sich um ein als Modifier-Element markiertes Feld in der Kernspezifikation handelt. \n\n  **Hinweis zur Verwendung:**\n  * `true` = Der Datensatz befindet sich in Verwendung/kann verwendet werden  \n  * `false`= Der Datensatz wurde storniert (z.B. bei Dubletten, Merge) oder archiviert  \n  \n    **WICHTIGER Hinweis für Implementierer:**  \n    * Alle server-seitigen Implementierungen SOLLEN in der Lage sein, die systemintern möglichen Statuswerte korrekt in FHIR abzubilden.\n    * Alle client-seitigen Implementierungen SOLLEN in der Lage sein, sämtliche Status-Codes zu interpretieren und dem Anwender in angemessener Form darstellen zu können." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.patient" ] ;
       fhir:path [ fhir:v "RelatedPerson.patient" ] ;
       fhir:short [ fhir:v "Patientenbezug" ] ;
       fhir:comment [ fhir:v "Motivation Kardinalität und Must-Support: Referenz auf den Patienten, zu dem diese angehörige Person in Beziehung steht. Diese Verlinkung ist essentiell für die Dokumentation der Beziehung zwischen Patient und Angehörigem." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.patient.reference" ] ;
       fhir:path [ fhir:v "RelatedPerson.patient.reference" ] ;
       fhir:short [ fhir:v "Patienten-Link" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Die Verlinkung auf eine Patienten-Ressource dient der technischen Zuordnung der Dokumentation zu einem Patienten und ermöglicht wichtige API-Funktionen wie verkettete Suche, (Reverse-)Include etc.\nIm ISik Kontext MUSS die referenzierte Ressource konform zu [ISiKPatient](https://gematik.de/fhir/isik/StructureDefinition/ISiKPatient) sein.\nJenseits von ISiK KÖNNEN weitere Instanzen mit anderen Profilen referenziert werden." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.relationship" ] ;
       fhir:path [ fhir:v "RelatedPerson.relationship" ] ;
       fhir:short [ fhir:v "Verwandtschaftsverhältnis" ] ;
       fhir:comment [ fhir:v "**Begründung MS:** Harmonisierung mit KBV (KBV_PR_Base_RelatedPerson)" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.name" ] ;
       fhir:path [ fhir:v "RelatedPerson.name" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "pattern" ] ;
           fhir:path [ fhir:v "$this" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:short [ fhir:v "Offizieller Name der angehörigen Person" ] ;
       fhir:comment [ fhir:v "Aufgrund der primären Nutzung von Angehörigen-Informationen im ISiK-Kontext als Brief- und Rechnungsempfänger, \n  ist die Angabe des offiziellen Namens relevant.\n  Wenn kein Name vorliegt, MUSS die [data-absent-reason-Extension](https://www.hl7.org/fhir/R4/extension-data-absent-reason.html) eingesetzt werden.   \n  **Weitere Hinweise:** siehe [Deutsche Basisprofile](https://simplifier.net/guide/leitfaden-de-basis-r4/ig-markdown-Ressourcen-Patient?version=current#ig-markdown-Ressourcen-Patient-Name)" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.name:Name" ] ;
       fhir:path [ fhir:v "RelatedPerson.name" ] ;
       fhir:sliceName [ fhir:v "Name" ] ;
       fhir:short [ fhir:v "Slice für den offiziellen Namen der angehörigen Person" ] ;
       fhir:comment [ fhir:v "Basierend auf dem Pattern .use = official wird dieser Slice gewählt.\n  **Begründung MS:** Siehe untergeordnete Elemente" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "1" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "HumanName"^^xsd:anyURI ;
           fhir:l fhir:HumanName
         ] ;
         fhir:profile ( [
           fhir:v "http://fhir.de/StructureDefinition/humanname-de-basis"^^xsd:anyURI ;
           fhir:l <http://fhir.de/StructureDefinition/humanname-de-basis>
         ] )
       ] ) ;
       fhir:pattern [
         a fhir:HumanName ;
         fhir:use [ fhir:v "official" ]
       ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.name:Name.use" ] ;
       fhir:path [ fhir:v "RelatedPerson.name.use" ] ;
       fhir:short [ fhir:v "Verwendungszweck" ] ;
       fhir:comment [ fhir:v "Verwendungszweck des Namens. Der präferierte Namen für die Brief- und Rechnungszustellung SOLLTE als `official`\n    gekennzeichnet werden und mindestens über einen Vor- und Nachnamen verfügen.    \n    **Begründung MS:** Dient als Unterscheidungs- und Auswahlkriterium" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.name:Name.family" ] ;
       fhir:path [ fhir:v "RelatedPerson.name.family" ] ;
       fhir:short [ fhir:v "Nachname" ] ;
       fhir:comment [ fhir:v "Vollständiger Nachname bzw. Familienname der Person, einschließlich Vor- und Zusätze.  \n      **Begründung Pflichtfeld:** Ein offizieller Name ist nur zulässig, wenn der Nachname und mindestens ein Vorname angegeben sind." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.name:Name.given" ] ;
       fhir:path [ fhir:v "RelatedPerson.name.given" ] ;
       fhir:comment [ fhir:v "Kann mehrfach verwendet werden, um den Rufnamen sowie weitere Vornamen, Mittelnamen oder Mittel-Initialen abzubilden.\n      **Begründung Pflichtfeld:** Ein offizieller Name ist nur zulässig, wenn der Nachname und mindestens ein Vorname angegeben sind." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.name:Name.prefix" ] ;
       fhir:path [ fhir:v "RelatedPerson.name.prefix" ] ;
       fhir:short [ fhir:v "Präfix" ] ;
       fhir:comment [ fhir:v "Präfix, z.B. akademischer Titel od. militärischer Rang" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.telecom" ] ;
       fhir:path [ fhir:v "RelatedPerson.telecom" ] ;
       fhir:short [ fhir:v "Telekommunikationsverbindung" ] ;
       fhir:comment [ fhir:v "Telekommunikationsverbindung (z.B. Telefonnummer, eMail-Adresse)  \n  **Begründung MS:** Harmonisierung mit KBV (KBV_PR_Base_RelatedPerson)" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.telecom.system" ] ;
       fhir:path [ fhir:v "RelatedPerson.telecom.system" ] ;
       fhir:short [ fhir:v "Art der Telekommunikationsverbindung" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Harmonisierung mit KBV (KBV_PR_Base_RelatedPerson)" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.telecom.value" ] ;
       fhir:path [ fhir:v "RelatedPerson.telecom.value" ] ;
       fhir:short [ fhir:v "Telekommunikations-Endpunkt" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Harmonisierung mit KBV (KBV_PR_Base_RelatedPerson)" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address" ] ;
       fhir:path [ fhir:v "RelatedPerson.address" ] ;
       fhir:slicing [
         fhir:discriminator ( [
           fhir:type [ fhir:v "pattern" ] ;
           fhir:path [ fhir:v "$this" ]
         ] ) ;
         fhir:rules [ fhir:v "open" ]
       ] ;
       fhir:short [ fhir:v "Offizielle Adresse der angehörigen Person" ] ;
       fhir:comment [ fhir:v "In order to differentiate between post box addresses and physical addresses, street names and house numbers, and to add city district names, vendors can opt to support the extensions as suggested in the German Address Base Profile http://fhir.de/StructureDefinition/address-de-basis.\r\nSuch differentiations are however not required within the scope of this specification." ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Strassenanschrift" ] ;
       fhir:path [ fhir:v "RelatedPerson.address" ] ;
       fhir:sliceName [ fhir:v "Strassenanschrift" ] ;
       fhir:short [ fhir:v "Straßenanschrift" ] ;
       fhir:comment [ fhir:v "Wohn- oder Aufenthaltsort des Angehörigen" ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "*" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Address"^^xsd:anyURI ;
           fhir:l fhir:Address
         ] ;
         fhir:profile ( [
           fhir:v "http://fhir.de/StructureDefinition/address-de-basis"^^xsd:anyURI ;
           fhir:l <http://fhir.de/StructureDefinition/address-de-basis>
         ] )
       ] ) ;
       fhir:pattern [
         a fhir:Address ;
         fhir:type [ fhir:v "both" ]
       ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "address-cnt-2or3-char" ] ;
         fhir:severity [ fhir:v "warning" ] ;
         fhir:human [ fhir:v "The content of the country element (if present) SHALL be selected EITHER from ValueSet ISO Country Alpha-2 http://hl7.org/fhir/ValueSet/iso3166-1-2 OR MAY be selected from ISO Country Alpha-3 Value Set http://hl7.org/fhir/ValueSet/iso3166-1-3, IF the country is not specified in value Set ISO Country Alpha-2 http://hl7.org/fhir/ValueSet/iso3166-1-2." ] ;
         fhir:expression [ fhir:v "country.empty() or (country.memberOf('http://hl7.org/fhir/ValueSet/iso3166-1-2') or country.memberOf('http://hl7.org/fhir/ValueSet/iso3166-1-3'))" ] ;
         fhir:source [
           fhir:v "https://gematik.de/fhir/isik/StructureDefinition/ISiKAngehoeriger"^^xsd:anyURI ;
           fhir:l <https://gematik.de/fhir/isik/StructureDefinition/ISiKAngehoeriger>
         ]
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Strassenanschrift.extension:Stadtteil" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.extension" ] ;
       fhir:sliceName [ fhir:v "Stadtteil" ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Strassenanschrift.type" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.type" ] ;
       fhir:short [ fhir:v "Adresstyp" ] ;
       fhir:comment [ fhir:v "Hier ist stets der Wert `both` anzugeben.  \n    **Begründung Pflichtfeld:** Dient als Unterscheidungs- und Auswahlkriterium" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Strassenanschrift.line" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.line" ] ;
       fhir:short [ fhir:v "Adresszeile" ] ;
       fhir:comment [ fhir:v "Diese Komponente kann Straßennamen, Hausnummer, Appartmentnummer, c/o \n    sowie weitere Zustellungshinweise enthalten. \n    Die Informationen können in mehrere line-Komponenten aufgeteilt werden. \n    Bei Verwendung der Extensions, um Straße, Hausnnummer und Postleitzahl strukturiert zu übermitteln, \n    müssen diese Informationen stets vollständig auch in der line-Komponente, \n    die sie erweitern, enthalten sein, um es Systemen, die diese Extensions nicht verwenden zu ermöglichen, \n    auf diese Informationen zugreifen zu können.  \n    **Begründung Pflichtfeld:** Ohne diese Angabe ist die Adresse nicht zustellbar.  \n    **Begründung für Reduktion der max. Kardinalität:** Die maximale Kardinalität wurde in Übereinstimmung mit der \n    DIN-Norm 5008 (Schreib- und Gestaltungsregeln für die Text- und Informationsverarbeitung) auf 3 beschränkt." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Strassenanschrift.line.extension:Strasse" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.line.extension" ] ;
       fhir:sliceName [ fhir:v "Strasse" ] ;
       fhir:short [ fhir:v "Strassenname" ] ;
       fhir:comment [ fhir:v "Strassenname (ohne Hausnummer).\n        Bei Angabe einer Strasse in dieser Extension muss diese auch in Address.line angegeben werden,\n        um die Interoperabilität mit Systemen zu gewährleisten, die diese Extension nicht verwenden.  \n        **Begründung MS:** Erforderlich für die verlustfreie Kommunikation von VSDM-Daten." ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Strassenanschrift.line.extension:Hausnummer" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.line.extension" ] ;
       fhir:sliceName [ fhir:v "Hausnummer" ] ;
       fhir:comment [ fhir:v "Hausnummer, sowie Zusätze (Appartmentnummer, Etage...). \n        Bei Angabe einer Hausnummer in dieser Extension muss diese auch in Address.line angegeben werden,\n        um die Interoperabilität mit Systemen zu gewährleisten, die diese Extension nicht verwenden.   \n        **Begründung MS:** Erforderlich für die verlustfreie Kommunikation von VSDM-Daten." ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Strassenanschrift.line.extension:Adresszusatz" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.line.extension" ] ;
       fhir:sliceName [ fhir:v "Adresszusatz" ] ;
       fhir:comment [ fhir:v "Zusätzliche Informationen, wie z.B. '3. Etage', 'Appartment C'.\n        Bei Angabe einer Zusatzinformation in dieser Extension muss diese auch in Address.line angegeben werden,\n        um die Interoperabilität mit Systemen zu gewährleisten, die diese Extension nicht verwenden.  \n        **Begründung MS:** Erforderlich für die verlustfreie Kommunikation von VSDM-Daten." ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Strassenanschrift.line.extension:Postfach" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.line.extension" ] ;
       fhir:sliceName [ fhir:v "Postfach" ] ;
       fhir:short [ fhir:v "Postfachnummer" ] ;
       fhir:comment [ fhir:v "Postfach-Adresse. Bei Angabe eines Postfaches in dieser Extension muss das Postfach auch in Address.line angegeben werden,\n        um die Interoperabilität mit Systemen zu gewährleisten, die diese Extension nicht verwenden. \n        Eine Postfach-Adresse darf nicht in Verbindung mit Address.type `physical` oder `both` verwendet werden.  \n        **Begründung MS:** Erforderlich für die verlustfreie Kommunikation von VSDM-Daten." ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Strassenanschrift.city" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.city" ] ;
       fhir:short [ fhir:v "Stadt" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Ohne diese Angabe ist die Adresse nicht zustellbar." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Strassenanschrift.postalCode" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.postalCode" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Ohne diese Angabe ist die Adresse nicht zustellbar." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Strassenanschrift.country" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.country" ] ;
       fhir:short [ fhir:v "Land" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Ohne diese Angabe ist die Adresse nicht zustellbar." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Postfach" ] ;
       fhir:path [ fhir:v "RelatedPerson.address" ] ;
       fhir:sliceName [ fhir:v "Postfach" ] ;
       fhir:short [ fhir:v "Postfachadresse" ] ;
       fhir:comment [ fhir:v "Adresse, die nur für postalische Zustellung genutzt werden kann." ] ;
       fhir:min [ fhir:v "0"^^xsd:nonNegativeInteger ] ;
       fhir:max [ fhir:v "*" ] ;
       fhir:type ( [
         fhir:code [
           fhir:v "Address"^^xsd:anyURI ;
           fhir:l fhir:Address
         ] ;
         fhir:profile ( [
           fhir:v "http://fhir.de/StructureDefinition/address-de-basis"^^xsd:anyURI ;
           fhir:l <http://fhir.de/StructureDefinition/address-de-basis>
         ] )
       ] ) ;
       fhir:pattern [
         a fhir:Address ;
         fhir:type [ fhir:v "postal" ]
       ] ;
       fhir:constraint ( [
         fhir:key [ fhir:v "address-cnt-2or3-char" ] ;
         fhir:severity [ fhir:v "warning" ] ;
         fhir:human [ fhir:v "The content of the country element (if present) SHALL be selected EITHER from ValueSet ISO Country Alpha-2 http://hl7.org/fhir/ValueSet/iso3166-1-2 OR MAY be selected from ISO Country Alpha-3 Value Set http://hl7.org/fhir/ValueSet/iso3166-1-3, IF the country is not specified in value Set ISO Country Alpha-2 http://hl7.org/fhir/ValueSet/iso3166-1-2." ] ;
         fhir:expression [ fhir:v "country.empty() or (country.memberOf('http://hl7.org/fhir/ValueSet/iso3166-1-2') or country.memberOf('http://hl7.org/fhir/ValueSet/iso3166-1-3'))" ] ;
         fhir:source [
           fhir:v "https://gematik.de/fhir/isik/StructureDefinition/ISiKAngehoeriger"^^xsd:anyURI ;
           fhir:l <https://gematik.de/fhir/isik/StructureDefinition/ISiKAngehoeriger>
         ]
       ] ) ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Postfach.type" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.type" ] ;
       fhir:short [ fhir:v "Adresstyp" ] ;
       fhir:comment [ fhir:v "Hier ist stets der Wert `postal` anzugeben.  \n    **Begründung Pflichtfeld:** Dient als Unterscheidungs- und Auswahlkriterium" ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Postfach.line" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.line" ] ;
       fhir:short [ fhir:v "Adresszeile" ] ;
       fhir:comment [ fhir:v "Diese Komponente enthält die Postfachadresse als String der Form 'Postfach: 12345'.\n    Bei Verwendung der Postfach-Extension, um die Postfachnummer strukturiert zu übermitteln, \n    müssen diese Informationen stets vollständig auch in der line-Komponente, \n    die sie erweitern, enthalten sein, um es Systemen, die diese Extensions nicht verwenden zu ermöglichen, \n    auf diese Informationen zugreifen zu können.  \n    **Begründung Pflichtfeld:** Ohne diese Angabe ist die Adresse nicht zustellbar.  \n    **Begründung für Reduktion der max. Kardinalität:** Die maximale Kardinalität wurde in Übereinstimmung mit der \n    DIN-Norm 5008 (Schreib- und Gestaltungsregeln für die Text- und Informationsverarbeitung) auf 3 beschränkt." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Postfach.line.extension:Strasse" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.line.extension" ] ;
       fhir:sliceName [ fhir:v "Strasse" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Postfach.line.extension:Hausnummer" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.line.extension" ] ;
       fhir:sliceName [ fhir:v "Hausnummer" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Postfach.line.extension:Adresszusatz" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.line.extension" ] ;
       fhir:sliceName [ fhir:v "Adresszusatz" ] ;
       fhir:max [ fhir:v "0" ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Postfach.line.extension:Postfach" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.line.extension" ] ;
       fhir:sliceName [ fhir:v "Postfach" ] ;
       fhir:short [ fhir:v "Postfachnummer" ] ;
       fhir:comment [ fhir:v "Postfach-Adresse. Bei Angabe eines Postfaches in dieser Extension muss das Postfach auch in Address.line angegeben werden,\n        um die Interoperabilität mit Systemen zu gewährleisten, die diese Extension nicht verwenden. \n        Eine Postfach-Adresse darf nicht in Verbindung mit Address.type `physical` oder `both` verwendet werden.  \n        **Begründung MS:** Erforderlich für die verlustfreie Kommunikation von VSDM-Daten." ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Postfach.city" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.city" ] ;
       fhir:short [ fhir:v "Stadt" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Ohne diese Angabe ist die Adresse nicht zustellbar." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Postfach.postalCode" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.postalCode" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Ohne diese Angabe ist die Adresse nicht zustellbar." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] [
       fhir:id [ fhir:v "RelatedPerson.address:Postfach.country" ] ;
       fhir:path [ fhir:v "RelatedPerson.address.country" ] ;
       fhir:short [ fhir:v "Land" ] ;
       fhir:comment [ fhir:v "**Begründung Pflichtfeld:** Ohne diese Angabe ist die Adresse nicht zustellbar." ] ;
       fhir:min [ fhir:v "1"^^xsd:nonNegativeInteger ] ;
       fhir:mustSupport [ fhir:v true ]
     ] )
  ] . # 

