       ] ;
       fhir:ElementDefinition.isModifier [ fhir:value "false"^^xsd:boolean ] ;
       fhir:ElementDefinition.isSummary [ fhir:value "false"^^xsd:boolean ] ;
       fhir:ElementDefinition.mapping [
         fhir:index 0 ;
         fhir:ElementDefinition.mapping.identity [ fhir:value "ical" ] ;
         fhir:ElementDefinition.mapping.map [ fhir:value "COMMENT:(comment) If there is no comment, then the line can be excluded from the iCalendar entry" ]
       ]
     ]
