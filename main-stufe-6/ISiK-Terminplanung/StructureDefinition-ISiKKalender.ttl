  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "Schedule" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule" ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "Schedule.id" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.id" ] ;
       fhir:ElementDefinition.short [ fhir:value "serverseitige, interne ID des Datensatzes" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**bedingtes Pflichtfeld/bedingtes MS:** Alle von einem Server bereitgestellten Ressourcen MÜSSEN über eine `id` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `id`verfügen. " ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "Schedule.meta.versionId" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.meta.versionId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Eindeutiger Name der serverseitigen Version des Datensatzes" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Alle von einem Server bereitgestellten Ressourcen SOLLEN über eine `versionID` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `versionID`verfügen. " ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "Schedule.meta.lastUpdated" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.meta.lastUpdated" ] ;
       fhir:ElementDefinition.short [ fhir:value "Zeitpunkt der letzten Änderung" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Alle von einem Server bereitgestellten Ressourcen SOLLEN über ein `lastUpdate` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über ein `lastUpdate`verfügen. " ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "Schedule.implicitRules" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.implicitRules" ] ;
       fhir:ElementDefinition.short [ fhir:value "Verweis auf die Regeln, nach denen die Ressource erstellt wurde" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung Constraint: In ISiK existiert kein Use-Case für dieses Element. Da es sich um ein Modifying Element handelt, wird es daher ausgeschlossen.\n  Darüber hinaus werden die Regeln als URI vorgehalten. Dies führt dazu, dass sich hinter der URI eine beliebige Menge an Regeln befinden kann; wodurch  nicht sichergestellt werden kann, dass alle Clients die Regeln korrekt interpretieren können." ] ;
       fhir:ElementDefinition.max [ fhir:value "0" ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "Schedule.extension" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.extension" ] ;
       fhir:ElementDefinition.slicing [
         fhir:ElementDefinition.slicing.discriminator [
           fhir:index 0 ;
           fhir:ElementDefinition.slicing.discriminator.type [ fhir:value "value" ] ;
           fhir:ElementDefinition.slicing.discriminator.path [ fhir:value "url" ]
         ] ;
         fhir:ElementDefinition.slicing.ordered [ fhir:value "false"^^xsd:boolean ] ;
         fhir:ElementDefinition.slicing.rules [ fhir:value "open" ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 6 ;
       fhir:Element.id [ fhir:value "Schedule.extension:KalenderName" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.extension" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "KalenderName" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung Must-Support-Flag (MS): Die KalenderName-Extension ermöglicht es einen menschenlesbaren Namen zu definieren, welcher zur Wiedererkennbarkeit des Kalenders im Rahmen der Terminplanung dient." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Extension" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Schedule.name" ;
           fhir:index 0 ;
           fhir:link <http://hl7.org/fhir/5.0/StructureDefinition/extension-Schedule.name>
         ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 7 ;
       fhir:Element.id [ fhir:value "Schedule.extension:KalenderName.extension" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.extension.extension" ] ;
       fhir:ElementDefinition.max [ fhir:value "0" ]
     ], [
       fhir:index 8 ;
       fhir:Element.id [ fhir:value "Schedule.extension:KalenderName.value[x]" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.extension.value[x]" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ]
     ], [
       fhir:index 9 ;
       fhir:Element.id [ fhir:value "Schedule.active" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.active" ] ;
       fhir:ElementDefinition.short [ fhir:value "Gibt an, ob der Kalender aktiv ist" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung Kardinalität und Must-Support-Flag (MS): Die Kardinalität 1..1 und das Must-Support-Flag (MS) für das 'active'-Element stellen sicher, dass jeder Kalender eindeutig als aktiv oder inaktiv gekennzeichnet ist. Dies ist entscheidend für die Ressourcenplanung und Verfügbarkeit von Terminen." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 10 ;
       fhir:Element.id [ fhir:value "Schedule.serviceType" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.serviceType" ] ;
       fhir:ElementDefinition.short [ fhir:value "Die Art der Dienstleistung, die der Kalender abdeckt" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung zu Kardinalität und Must Support: Die Dienstleistungsart eines Termins ist von entscheidender Bedeutung, um die Verfügbarkeit und Planung des Termins zu gewährleisten. Daher ist dieses Feld verpflichtend (1..*) und muss unterstützt werden (MS). Aufgrund der Heterogenität von Dienstleistungen ist eine standardisierte Kodierung nicht zwingend notwendig, eine Freitextbeschreibung ist ausreichend." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 11 ;
       fhir:Element.id [ fhir:value "Schedule.serviceType.text" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.serviceType.text" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 12 ;
       fhir:Element.id [ fhir:value "Schedule.specialty" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.specialty" ] ;
       fhir:ElementDefinition.short [ fhir:value "Die Fachrichtung, die der Kalender abdeckt" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hinweis: Ein Kalender kann für einen Akteur gepflegt werden. Dieser Akteur kann in einer oder mehreren Fachrichtungen agieren. Für die Ressourcenplanung (z.B. welche Akteure sind für einen Termin verfügbar) sollte auch auf die Speciality des Akteurs zurückgegriffen werden für den Fall, dass ein Kalender pro Fachbereich - d.h. Akteur-übergreifend - gepflegt wird. \n  \n  Begründung Kardinalität Must-Support-Flag (MS): Die Kardinalität 1..* und das Must-Support-Flag (MS) für das 'specialty'-Element stellen sicher, dass jeder Kalender mindestens eine Fachrichtung angibt. Dies ist wichtig für die Ressourcenplanung und die Verfügbarkeit von Terminen, sodass angefragte Termine einem Fachbereich zugeordnet werden können.\n\n  Hintergrund: Die Festlegung hat in einer Expertengruppe am 4.6.2024 stattgefunden. Diese war zuvor in einer ISiK Arbeitsgruppe bekanntgegeben worden und stand damit allen Beteiligten offen. \n  " ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 13 ;
       fhir:Element.id [ fhir:value "Schedule.specialty.coding" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.specialty.coding" ] ;
       fhir:ElementDefinition.slicing [
         fhir:ElementDefinition.slicing.discriminator [
           fhir:index 0 ;
           fhir:ElementDefinition.slicing.discriminator.type [ fhir:value "pattern" ] ;
           fhir:ElementDefinition.slicing.discriminator.path [ fhir:value "$this" ]
         ] ;
         fhir:ElementDefinition.slicing.rules [ fhir:value "open" ]
       ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung Kardinalität Fachrichtung: Die Kardinalität der Fachrichtung-Eigenschaft wird auf 1..1 festgelegt, um sicherzustellen, dass genau eine Fachrichtung per IHE-XDS-Kodierung vorhanden ist. Dies ist notwendig, um die Spezialisierung des Kalenders eindeutig zu definieren und eine korrekte Zuordnung zu gewährleisten.\n  \n  Begründung Kardinalität ErweiterterFachabteilungsschluessel: Die Kardinalität der ErweiterterFachabteilungsschluessel-Eigenschaft wird auf 0..1 festgelegt, um sicherzustellen, dass optional ein erweiterter Fachabteilungsschlüssel vorhanden sein kann." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 14 ;
       fhir:Element.id [ fhir:value "Schedule.specialty.coding:Fachrichtung" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.specialty.coding" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "Fachrichtung" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Die Wahl des hinterlegten ValueSets (http://ihe-d.de/ValueSets/IHEXDSpracticeSettingCode) wurde mit einem Mitglied der IHE Deutschland Arbeitsgruppe XDS ValueSets (https://www.ihe-d.de/projekte/xds-value-sets-fuer-deutschland/) sowie mit der KBV abgestimmt (Stand:13.6.2024)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "http://ihe-d.de/ValueSets/IHEXDSpracticeSettingCode" ;
           fhir:link <http://ihe-d.de/ValueSets/IHEXDSpracticeSettingCode>
         ]
       ]
     ], [
       fhir:index 15 ;
       fhir:Element.id [ fhir:value "Schedule.specialty.coding:ErweiterterFachabteilungsschluessel" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.specialty.coding" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "ErweiterterFachabteilungsschluessel" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Dieses CodeSystem KANN über ein Mapping (siehe Abschnitt https://wiki.hl7.de/index.php?title=IG:Value_Sets_f%C3%BCr_XDS#DocumentEntry.practiceSettingCode) mit dem ValueSet der Fachrichtung verknüpft werden und darüber ggf. die Integration von Systemen erleichtern." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.patternCoding [
         fhir:Coding.system [ fhir:value "http://fhir.de/CodeSystem/dkgev/Fachabteilungsschluessel-erweitert" ]
       ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "extensible" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "http://fhir.de/ValueSet/dkgev/Fachabteilungsschluessel-erweitert" ;
           fhir:link <http://fhir.de/ValueSet/dkgev/Fachabteilungsschluessel-erweitert>
         ]
       ]
     ], [
       fhir:index 16 ;
       fhir:Element.id [ fhir:value "Schedule.actor" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.actor" ] ;
       fhir:ElementDefinition.slicing [
         fhir:ElementDefinition.slicing.discriminator [
           fhir:index 0 ;
           fhir:ElementDefinition.slicing.discriminator.type [ fhir:value "type" ] ;
           fhir:ElementDefinition.slicing.discriminator.path [ fhir:value "$this" ]
         ] ;
         fhir:ElementDefinition.slicing.rules [ fhir:value "open" ]
       ] ;
       fhir:ElementDefinition.short [ fhir:value "Der Akteur, der dem Kalender zugeordnet ist" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung Kardinalität und Must-Support-Flag (MS): Die Kardinalität der Akteur-Eigenschaft wird auf 0..1 festgelegt, um sicherzustellen, dass ein  Akteur eindeutig ist, falls dieser vorhanden ist. Durch das MS wird sichergestellt, dass Systeme in der Lage sind, einen Akteur zu unterstützen, wenn er vorhanden ist." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 17 ;
       fhir:Element.id [ fhir:value "Schedule.actor.identifier" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.actor.identifier" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung Must-Support-Flag (MS):\n  Das Must-Support-Flag (MS) für das 'identifier'-Element stellt sicher, dass Systeme in der Lage sind, einen Identifier zu unterstützen, wenn er vorhanden ist. Dies ist wichtig für die eindeutige Identifizierung und Verknüpfung von Akteuren in verschiedenen Systemen. Inbesondere gilt dies für die genaue Identifizierung von Geräten (Device)." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 18 ;
       fhir:Element.id [ fhir:value "Schedule.actor.display" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.actor.display" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hinweis und Begründung zum Must Support: Für alle Target-Ressourcen SOLL ein Displaywert für die Referenz angegeben werden, sodass Systeme eine Übersicht der am Termin beteiligten Akteure anzeigen können, ohne die Referenzen auflösen zu müssen. Somit kann ein Termin-Consumer direkt anzeigen für welche Akteure ein Terminkalender existiert.\n    \n" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 19 ;
       fhir:Element.id [ fhir:value "Schedule.actor:Akteur" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.actor" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "Akteur" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Im ISIK-Kontext MUSS die referenzierte Practitioner-Ressource konform zum [ISiKPersonImGesundheitsberuf](https://gematik.de/fhir/isik/StructureDefinition/ISiKPersonImGesundheitsberuf) des Basismoduls sein. Zudem MUSS die referenzierte Location-Ressource konform zum [ISiKStandort](https://gematik.de/fhir/isik/StructureDefinition/ISiKStandort) des Basismoduls sein. Dieses Element dient dazu, alle Akteure zu gruppieren, sodass für diese Einheit von Terminressourcen ein Terminblock herausgegeben werden kann. Unter 'Akteure' fallen hier auch Standorte und Dienstleistungen." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Reference" ] ;
         fhir:ElementDefinition.type.targetProfile [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Practitioner" ;
           fhir:index 0 ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Practitioner>
         ], [
           fhir:value "http://hl7.org/fhir/StructureDefinition/HealthcareService" ;
           fhir:index 1 ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/HealthcareService>
         ], [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Location" ;
           fhir:index 2 ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Location>
         ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 20 ;
       fhir:Element.id [ fhir:value "Schedule.actor:Akteur.reference" ] ;
       fhir:ElementDefinition.path [ fhir:value "Schedule.actor.reference" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung Kardinalität: Die Kardinalität der Akteur-Eigenschaft wird auf 1..1 festgelegt, um sicherzustellen, dass ein eindeutiger Akteur vorhanden ist." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ]
  ] .

