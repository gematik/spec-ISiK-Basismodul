@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# - resource -------------------------------------------------------------------

<https://gematik.de/fhir/isik/Parameters/exp-params> a fhir:Parameters ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "exp-params"] ;
  fhir:Parameters.parameter [
     fhir:index 0 ;
     fhir:Parameters.parameter.name [ fhir:value "displayLanguage" ] ;
     fhir:Parameters.parameter.valueCode [ fhir:value "de-DE" ]
  ] .

# - ontology header ------------------------------------------------------------

<https://gematik.de/fhir/isik/Parameters/exp-params.ttl> a owl:Ontology ;
  owl:imports fhir:fhir.ttl .

# -------------------------------------------------------------------------------------

