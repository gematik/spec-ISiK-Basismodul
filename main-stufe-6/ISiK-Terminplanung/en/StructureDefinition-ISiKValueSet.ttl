       fhir:ElementDefinition.path [ fhir:value "ValueSet.version" ] ;
       fhir:ElementDefinition.short [ fhir:value "Version des ValueSets" ] ;
       fhir:ElementDefinition.comment [ fhir:value "\n**Bedeutung:** Version des ValueSets\n\n**Hinweise:** Jede Änderung des dazugehörigen CodeSystems MUSS eine Änderung in der Version des CodeSystems und ValueSets nach sich ziehen." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "ValueSet.name" ] ;
       fhir:ElementDefinition.path [ fhir:value "ValueSet.name" ] ;
       fhir:ElementDefinition.short [ fhir:value "Name des ValueSets" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Bedeutung:** Maschinenlesbarer Name des ValueSets\n\n**Hinweise:** Der Constraint [vsd-0](https://www.hl7.org/fhir/R4/valueset.html#invs) ist hierbei zu beachten." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "ValueSet.status" ] ;
       fhir:ElementDefinition.path [ fhir:value "ValueSet.status" ] ;
       fhir:ElementDefinition.short [ fhir:value "Status" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Zeigt den aktuellen Status der Ressource an.     \n  **WICHTIGER Hinweis für Implementierer:**    \n  * Alle server-seitigen Implementierungen MÜSSEN in der Lage sein, \n  die systemintern möglichen Statuswerte korrekt in FHIR abzubilden, mindestens jedoch 'active' und 'retired''.\n  * Alle client-seitigen Implementierungen MÜSSEN in der Lage sein, sämtliche Status-Codes zu interpretieren und dem Anwender in angemessener Form darstellen zu können, \n  beispielsweise durch Ausblenden/Durchstreichen von Ressourcen mit dem status `entered-in-error` und Ausgrauen von Ressourcen, die einen Plan- oder Entwurfs-Status haben." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "ValueSet.useContext" ] ;
       fhir:ElementDefinition.path [ fhir:value "ValueSet.useContext" ] ;
       fhir:ElementDefinition.short [ fhir:value "Datenelement-Relevanz das ValueSet" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Bedeutung:** Angabe für welches Datenelement das ValueSet relevant ist\n\n**Hinweise:** Es muss mindestens ein useContext angegeben werden, in dem der Ressourcen-Typ kodiert wird, in dem das ValueSet in einem Element zur Verwendung kommt." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "ValueSet.useContext.code" ] ;
       fhir:ElementDefinition.path [ fhir:value "ValueSet.useContext.code" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Der Code 'focus' MUSS angegeben werden, um zu kennzeichnen, dass die UsageContext-Angabe sich auf die durch das ValueSet zu kodierenden Konzepte bezieht." ] ;
       fhir:ElementDefinition.patternCoding [
         fhir:Coding.system [ fhir:value "http://terminology.hl7.org/CodeSystem/usage-context-type" ] ;
         fhir:Coding.code [ fhir:value "focus" ]
       ]
     ], [
