       fhir:Element.id [ fhir:value "ValueSet.useContext.value[x]" ] ;
       fhir:ElementDefinition.path [ fhir:value "ValueSet.useContext.value[x]" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Angabe in welchem Ressourcen-Typ das ValueSet verwendet wird." ] ;
       fhir:ElementDefinition.type [
