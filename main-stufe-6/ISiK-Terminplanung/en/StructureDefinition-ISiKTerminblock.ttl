         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Der Endzeitpunkt eines Terminsblocks MUSS nach dem Startzeitpunkt liegen" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "start <= end" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "https://gematik.de/fhir/isik/StructureDefinition/ISiKTerminblock" ;
           fhir:link <https://gematik.de/fhir/isik/StructureDefinition/ISiKTerminblock>
         ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Slot.id" ] ;
       fhir:ElementDefinition.path [ fhir:value "Slot.id" ] ;
       fhir:ElementDefinition.short [ fhir:value "serverseitige, interne ID des Datensatzes" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**bedingtes Pflichtfeld/bedingtes MS:** Alle von einem Server bereitgestellten Ressourcen MÜSSEN über eine `id` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `id`verfügen. " ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Slot.meta.versionId" ] ;
       fhir:ElementDefinition.path [ fhir:value "Slot.meta.versionId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Eindeutiger Name der serverseitigen Version des Datensatzes" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Alle von einem Server bereitgestellten Ressourcen SOLLEN über eine `versionID` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `versionID`verfügen. " ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Slot.meta.lastUpdated" ] ;
       fhir:ElementDefinition.path [ fhir:value "Slot.meta.lastUpdated" ] ;
       fhir:ElementDefinition.short [ fhir:value "Zeitpunkt der letzten Änderung" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Alle von einem Server bereitgestellten Ressourcen SOLLEN über ein `lastUpdate` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über ein `lastUpdate`verfügen. " ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Slot.implicitRules" ] ;
       fhir:ElementDefinition.path [ fhir:value "Slot.implicitRules" ] ;
       fhir:ElementDefinition.short [ fhir:value "Verweis auf die Regeln, nach denen die Ressource erstellt wurde" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung Constraint: In ISiK existiert kein Use-Case für dieses Element. Da es sich um ein Modifying Element handelt, wird es daher ausgeschlossen.\n  Darüber hinaus werden die Regeln als URI vorgehalten. Dies führt dazu, dass sich hinter der URI eine beliebige Menge an Regeln befinden kann; wodurch  nicht sichergestellt werden kann, dass alle Clients die Regeln korrekt interpretieren können." ] ;
       fhir:ElementDefinition.max [ fhir:value "0" ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Slot.schedule" ] ;
       fhir:ElementDefinition.path [ fhir:value "Slot.schedule" ] ;
       fhir:ElementDefinition.short [ fhir:value "Der Kalender dem dieser Terminblock zugeordnet ist" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung Kardinalität und MS: Die Kardinalität der reference-Eigenschaft wird auf 1..* festgelegt, um sicherzustellen, dass ein Kalender eindeutig referenziert und identifiziert werden kann." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Slot.schedule.reference" ] ;
       fhir:ElementDefinition.path [ fhir:value "Slot.schedule.reference" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Slot.status" ] ;
       fhir:ElementDefinition.path [ fhir:value "Slot.status" ] ;
       fhir:ElementDefinition.short [ fhir:value "Der Status des Terminblocks" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung Must Support: Dies ist wichtig, um die Verfügbarkeit von Terminen zu gewährleisten, eine Überbuchung zu verhindern und zudem einem Termin-Requestor die Möglichkeit zu bieten nur freie Termine bei der Terminbuchung anzuzeigen." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Slot.start" ] ;
       fhir:ElementDefinition.path [ fhir:value "Slot.start" ] ;
       fhir:ElementDefinition.short [ fhir:value "Der Startzeitpunkt des Terminblocks" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung Must Support: Dies ist wichtig, um den Zeitpunkt des Termins an einen Termin-Requestor / Termin-Consumer zu kommunizieren." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Slot.end" ] ;
       fhir:ElementDefinition.path [ fhir:value "Slot.end" ] ;
       fhir:ElementDefinition.short [ fhir:value "Der Endzeitpunkt des Terminblocks" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung Must Support: Dies ist wichtig, um die Länge des Termins an einen Termin-Requestor / Termin-Consumer zu kommunizieren." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ]
  ] .

