         fhir:ElementDefinition.binding.valueSet [
           fhir:value "http://ihe-d.de/ValueSets/IHEXDSpracticeSettingCode" ;
           fhir:link <http://ihe-d.de/ValueSets/IHEXDSpracticeSettingCode>
         ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "HealthcareService.specialty.coding:ErweiterterFachabteilungsschluessel" ] ;
       fhir:ElementDefinition.path [ fhir:value "HealthcareService.specialty.coding" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "ErweiterterFachabteilungsschluessel" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Dieses ValueSet KANN über ein Mapping (siehe Abschnitt https://wiki.hl7.de/index.php?title=IG:Value_Sets_f%C3%BCr_XDS#DocumentEntry.practiceSettingCode) mit dem ValueSet der Fachrichtung verknüpft werden und darüber ggf. die Integration von Systemen erleichtern." ] ;
