       fhir:ElementDefinition.path [ fhir:value "Appointment.participant.actor" ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "Reference" ] ;
         fhir:ElementDefinition.type.targetProfile [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Practitioner" ;
           fhir:index -1 ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Practitioner>
         ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.participant:AkteurPersonImGesundheitsberuf.actor.reference" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.participant.actor.reference" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.participant:AkteurMedizinischeBehandlungseinheit" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.participant" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "AkteurMedizinischeBehandlungseinheit" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Im ISIK-Kontext MUSS die referenzierte HealthcareService-Ressource konform zum [ISiKMedizinischeBehandlungseinheit](https://gematik.de/fhir/isik/StructureDefinition/ISiKMedizinischeBehandlungseinheit) des Basismoduls sein.\n  **Begründung MS**: Über die Angabe einer medizinischen Behandlungseinheit, kann dem Termin eine spezifische Dienstleistung zugeordnet werden. " ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.participant:AkteurMedizinischeBehandlungseinheit.actor" ] ;
