       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.status" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.status" ] ;
       fhir:ElementDefinition.short [ fhir:value "Der Status des Termins" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung zu Must Support : Im ISiK Kontext ist der Status eines Termins von entscheidender Bedeutung, um den aktuellen Stand und die Verfügbarkeit des Termins zu kommunizieren." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.cancelationReason" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.cancelationReason" ] ;
       fhir:ElementDefinition.short [ fhir:value "Der Grund für die Absage des Termins" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung zu Must Support: Dieses Feld ist optional (0..1), muss jedoch implementiert werden (MS), um die Möglichkeit zu bieten, einen Grund für die Absage eines Termins zu hinterlegen." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "https://gematik.de/fhir/isik/ValueSet/ISiKTerminCancelationReason" ;
           fhir:link <https://gematik.de/fhir/isik/ValueSet/ISiKTerminCancelationReason>
         ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.serviceType" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.serviceType" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung zu Kardinalität und Must Support: Die Dienstleistungsart eines Termins ist von entscheidender Bedeutung, um die Verfügbarkeit und Planung des Termins zu gewährleisten. Daher ist dieses Feld verpflichtend (1..*) und muss unterstützt werden (MS). Aufgrund der Heterogenität von Dienstleistungen ist eine standardisierte Kodierung nicht zwingend notwendig, eine Freitextbeschreibung ist ausreichend." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.serviceType.text" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.serviceType.text" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.specialty" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.specialty" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Optionale Angabe aller Fachbereiche aus denen ein oder mehrere Akteure für die Durchführung des Termins benötigt werden. \n  \n    **Begründung MS**: KANN auch anhand des Kalenders, in dem ein Termin gebucht wird, ermittelt werden.\n  Die Angabe der Fachbereiche ist optional (0..*), muss jedoch implementiert werden (MS), um die Spezialisierung hinsichtlich der zugeordneten Behandlungseinheit des Termins eindeutig zu definieren und eine korrekte Zuordnung zu gewährleisten.  " ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.specialty.coding" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.specialty.coding" ] ;
       fhir:ElementDefinition.slicing [
         fhir:ElementDefinition.slicing.discriminator [
           fhir:index -1 ;
           fhir:ElementDefinition.slicing.discriminator.type [ fhir:value "pattern" ] ;
           fhir:ElementDefinition.slicing.discriminator.path [ fhir:value "$this" ]
         ] ;
         fhir:ElementDefinition.slicing.rules [ fhir:value "open" ]
       ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.specialty.coding:Fachrichtung" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.specialty.coding" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "Fachrichtung" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung zur Kardinalität: Die Kardinalität der Fachrichtung-Eigenschaft wird auf 1..1 festgelegt, um sicherzustellen, dass genau eine Fachrichtung vorhanden ist. Dies ist notwendig, um die Spezialisierung des Termins eindeutig zu definieren und eine korrekte Zuordnung zu gewährleisten.\n  \n  Hintergrund zur Entscheidung: Die Wahl des hinterlegten ValueSets (http://ihe-d.de/ValueSets/IHEXDSpracticeSettingCode) wurde mit einem Mitglied der IHE Deutschland Arbeitsgruppe XDS ValueSets (https://www.ihe-d.de/projekte/xds-value-sets-fuer-deutschland/) sowie mit der KBV abgestimmt (Stand:13.6.2024)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "http://ihe-d.de/ValueSets/IHEXDSpracticeSettingCode" ;
           fhir:link <http://ihe-d.de/ValueSets/IHEXDSpracticeSettingCode>
         ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.specialty.coding:ErweiterterFachabteilungsschluessel" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.specialty.coding" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "ErweiterterFachabteilungsschluessel" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Dieses ValueSet KANN über ein Mapping (siehe Abschnitt https://wiki.hl7.de/index.php?title=IG:Value_Sets_f%C3%BCr_XDS#DocumentEntry.practiceSettingCode) mit dem ValueSet der Fachrichtung verknüpft werden und darüber ggf. die Integration von Systemen erleichtern." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "http://fhir.de/ValueSet/dkgev/Fachabteilungsschluessel-erweitert" ;
           fhir:link <http://fhir.de/ValueSet/dkgev/Fachabteilungsschluessel-erweitert>
         ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.priority" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.priority" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung Must Support: Die Priorität eines Termins ist von entscheidender Bedeutung, um die Dringlichkeit und Relevanz des Termins zu kommunizieren und zu priorisieren. Eine Priorität ist nicht zwingend erforderlich, muss jedoch implementiert werden (MS), um die Möglichkeit zu bieten, die Dringlichkeit und Relevanz des Termins abzurufen." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.priority.extension" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.priority.extension" ] ;
       fhir:ElementDefinition.slicing [
         fhir:ElementDefinition.slicing.discriminator [
           fhir:index -1 ;
           fhir:ElementDefinition.slicing.discriminator.type [ fhir:value "value" ] ;
           fhir:ElementDefinition.slicing.discriminator.path [ fhir:value "url" ]
         ] ;
         fhir:ElementDefinition.slicing.ordered [ fhir:value "false"^^xsd:boolean ] ;
         fhir:ElementDefinition.slicing.rules [ fhir:value "open" ]
       ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hinweis: In R5 ist die Priority ein CodeableConcept. \n  \n  Begründung zu Must Support: Dieses Element ist optional (0..1), muss jedoch implementiert werden (MS), um besonders einen Notfall als solchen ausweisen zu können." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.priority.extension:Priority" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.priority.extension" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "Priority" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "Extension" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://gematik.de/fhir/isik/StructureDefinition/ISiKTerminPriorityExtension" ;
           fhir:index -1 ;
           fhir:link <https://gematik.de/fhir/isik/StructureDefinition/ISiKTerminPriorityExtension>
         ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.start" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.start" ] ;
       fhir:ElementDefinition.short [ fhir:value "Der Startzeitpunkt des Termins" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung zu Kardinalität und Must Support: Der Startzeitpunkt eines Termins ist von entscheidender Bedeutung, um die Verfügbarkeit und Planung des Termins zu gewährleisten. Daher muss dieses Feld unterstützt werden (MS). Das Feld ist in den meisten Fällen verpflichtend, nur für die Status 'proposed', 'cancelled', 'waitlist' existiert kein Wert." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.end" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.end" ] ;
       fhir:ElementDefinition.short [ fhir:value "Der Endzeitpunkt des Termins" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung zu Kardinalität und Must Support: Der Endzeitpunkt eines Termins ist von entscheidender Bedeutung, um die Verfügbarkeit und Planung des Termins zu gewährleisten. Daher muss dieses Feld unterstützt werden (MS). Das Feld ist in den meisten Fällen verpflichtend, nur für die Status 'proposed', 'cancelled', 'waitlist' existiert kein Wert." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.slot" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.slot" ] ;
       fhir:ElementDefinition.short [ fhir:value "Verweise auf die gebuchten Terminblöcke" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung zu Kardinalität und Must Support: Die Kardinalität der slot-Eigenschaft bleibt 0..*, sodass ein Termin-Requestor bei der Terminbuchung nur einen Termin und ein Verweis auf ein ISiKKalender übergeben kann. Es ist dann die Aufgabe des Termin-Repositories in Abhängigkeit der gebuchten Dienstleistung freie Terminblöcke zu finden. Diese sind im Appointment zu referenzieren." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.slot.reference" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.slot.reference" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.comment" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.comment" ] ;
       fhir:ElementDefinition.short [ fhir:value "Zusätzliche Kommentare zum Termin zwischen Leistungserbringern" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hinweis: Im ISiK Kontext sollte dieses Feld zur internen Kommunikation zwischen Leistungserbringern verwendet werden, z.B. für interne Notizen rund um den Termin.\n\nBegründung zum Must Support: Dieses Feld ist optional (0..1), muss jedoch implementiert werden (MS), um die Möglichkeit zu bieten, zusätzliche Informationen zum Termin zu hinterlegen und abrufen zu können. \n\nEs gilt weiterhin die Semantik des Elements nach FHIR-Kernspezifikation:\n\n'Additional text to aid in facilitating the appointment. For instance, a comment might be, 'patient should proceed immediately to infusion room upon arrival'\n\nWhere this is a planned appointment and the start/end dates are not set then this field can be used to provide additional guidance on the details of the appointment request, including any restrictions on when to book it.'" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.patientInstruction" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.patientInstruction" ] ;
       fhir:ElementDefinition.short [ fhir:value "Anweisungen für den Patienten zum Termin" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hinweis: Dieses Feld sollte im Kontext von ISIK verwendet werden für die Kommunikation im Sinne der Definition der FHIR-Kernspezifikation - sowohl von Systemseite (administrativ) als auch von Seiten des medizinischen Fachpersonals.\n\nBeispiel für eine Nachricht: 'Bitte nüchtern erscheinen' etc.\n\nBegründung zum Must Support: Dieses Feld ist optional (0..1), muss jedoch implementiert werden (MS), um die Möglichkeit zu bieten, zusätzliche Informationen für Patienten zum Termin zu hinterlegen und abrufen zu können. \n\nEs gilt weiterhin der Hinweis der FHIR Kernspezifikation:\n'Note that FHIR strings SHALL NOT exceed 1MB in size'" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.participant" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.participant" ] ;
       fhir:ElementDefinition.slicing [
         fhir:ElementDefinition.slicing.discriminator [
           fhir:index -1 ;
           fhir:ElementDefinition.slicing.discriminator.type [ fhir:value "type" ] ;
           fhir:ElementDefinition.slicing.discriminator.path [ fhir:value "actor.resolve()" ]
         ] ;
         fhir:ElementDefinition.slicing.rules [ fhir:value "open" ]
       ] ;
       fhir:ElementDefinition.short [ fhir:value "Teilnehmer des Termins" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hinweis: Die Kardinalität von actor.display und das MS-Flag von .status wird an die Slices vererbt und diese sind entsprechend zu implementieren.\n\nBegründung zu Kardinalität und Must Support: Die Teilnehmer eines Termins sind von entscheidender Bedeutung, um die Verfügbarkeit und Planung des Termins zu gewährleisten. Daher muss dieses Feld unterstützt werden (MS)." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.participant.actor" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.participant.actor" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.participant.actor.display" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.participant.actor.display" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hinweis: Für alle Target-Ressourcen SOLL ein Displaywert für die Referenz angegeben werden, sodass Systeme eine Übersicht der am Termin beteiligten Akteure anzeigen können ohne die Referenzen auflösen zu müssen. Somit kann ein Termin-Consumer direkt anzeigen welche Akteure für den Termin relevant sind." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.participant.status" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.participant.status" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.participant:AkteurPatient" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.participant" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "AkteurPatient" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hinweis: Im ISIK-Kontext MUSS der referenzierte Patient konform zum [ISIKPatient](https://gematik.de/fhir/isik/StructureDefinition/ISiKPatient) des Basismoduls sein. Ein Sonderfall sind Patienten, über die ein Termin-Requestor oder Termin-Repository nur rudimentäre Informationen verfügt. Diese Patienten-Ressourcen sind bis zur Vervollständigung nur gegen den Kernstandard valide.\n\nBegründung zu Kardinalität und Must Support: Die teilnehmenden Patienten eines Termins sind von entscheidender Bedeutung, um die Verfügbarkeit und Planung des Termins zu gewährleisten. Daher muss dieses Feld unterstützt werden (MS). Hingegen kann die Patienten-Referenz separat in der $book-Operation übergeben werden, sodass hier keine verpflichtende Kardinaltiät gewählt werden kann." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.participant:AkteurPatient.actor" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.participant.actor" ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "Reference" ] ;
         fhir:ElementDefinition.type.targetProfile [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Patient" ;
           fhir:index -1 ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Patient>
         ]
       ]
