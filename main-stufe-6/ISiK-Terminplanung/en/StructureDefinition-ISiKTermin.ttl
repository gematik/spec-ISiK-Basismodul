       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.participant:AkteurPatient.actor.reference" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.participant.actor.reference" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Appointment.participant:AkteurPersonImGesundheitsberuf" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment.participant" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "AkteurPersonImGesundheitsberuf" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Im ISIK-Kontext MUSS die referenzierte RelatedPerson-Ressource konform zum [ISiKAngehoeriger](https://gematik.de/fhir/isik/StructureDefinition/ISiKAngehoeriger) des Basismoduls sein.\n\nBegründung zu Kardinalität und Must Support: Die Angabe eines Angehörigen ist optional, da in vielen Fällen die Referenzierung des Patienten ausreichend ist. Bei Terminen, die durch einen Angehörigen gebucht/verwaltet werden, ist es jedoch wichtig, dass diese Information an das Termin-Repository übermittelt werden kann." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
