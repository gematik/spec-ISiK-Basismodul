     fhir:Narrative.status [ fhir:value "extensions" ] ;
     fhir:Narrative.div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: CapabilityStatement ISiKCapabilityStatementAMTSAkteur</b></p><a name=\"ISiKCapabilityStatementAMTSAkteur\"> </a><a name=\"hcISiKCapabilityStatementAMTSAkteur\"> </a><h2 id=\"title\">ISiK CapabilityStatement AMTS Akteur</h2><ul><li>Implementation Guide Version: 6.0.0 </li><li>FHIR Version: 4.0.1 </li><li>Supported Formats: <code>application/fhir+xml</code>, <code>application/fhir+json</code>, <code>application/fhir+xml</code>, <code>application/fhir+json</code></li><li>Published on: 2026-07-01 </li><li>Published by: gematik GmbH </li></ul><blockquote class=\"impl-note\"><p><strong>Note to Implementers: FHIR Capabilities</strong></p><p>Any FHIR capability may be 'allowed' by the system unless explicitly marked as 'SHALL NOT'. A few items are marked as MAY in the Implementation Guide to highlight their potential relevance to the use case.</p></blockquote><p>This CapabilityStatement imports these CapabilityStatements <a href=\"CapabilityStatement-ISiKCapabilityStatementAMTSRolle.html\">ISiK CapabilityStatement AMTS Rolle</a>, <a href=\"CapabilityStatement-ISiKCapabilityStatementAMTSWRITERolle.html\">ISiK CapabilityStatement AMTS WRITE Rolle</a>, <a href=\"CapabilityStatement-ISiKCapabilityStatementStammdatenRolle.html\">CapabilityStatement für Rolle StammdatenRolle</a>, <a href=\"CapabilityStatement-ISiKCapabilityStatementLeistungserbringerRolle.html\">CapabilityStatement für Rolle LeistungserbringerRolle</a>, <a href=\"CapabilityStatement-ISiKCapabilityStatementKlinischeRolle.html\">CapabilityStatement für Rolle ISiKCapabilityStatementKlinischeRolle</a>, <a href=\"CapabilityStatement-ISiKCapabilityStatementMedikationVerabreichungRolle.html\">ISiK CapabilityStatement Medikationsverabreichung Rolle</a>, <a href=\"CapabilityStatement-ISiKCapabilityStatementMedikationVerabreichungWRITERolle.html\">ISiK CapabilityStatement Medikationsverabreichung WRITE Rolle</a>, <a href=\"CapabilityStatement-ISiKCapabilityStatementMedikationInformationRolle.html\">ISiK CapabilityStatement Medikation Server - Medikationsinformation</a>, <a href=\"CapabilityStatement-ISiKCapabilityStatementMedikationInformationWRITERolle.html\">ISiK CapabilityStatement Medikationsinformation WRITE Rolle</a>, <a href=\"CapabilityStatement-ISiKCapabilityStatementMedikationVerordnungRolle.html\">ISiK CapabilityStatement Medikationsverordnung Rolle</a>, <a href=\"CapabilityStatement-ISiKCapabilityStatementMedikationVerordnungWRITERolle.html\">ISiK CapabilityStatement Medikationsverordnung WRITE Rolle</a>, <a href=\"CapabilityStatement-ISiKCapabilityStatementMedikamentRolle.html\">ISiK CapabilityStatement MedikamentRolle</a>, <a href=\"CapabilityStatement-ISiKCapabilityStatementMedikamentWRITERolle.html\">ISiK CapabilityStatement Medikament WRITE Rolle</a>, <a href=\"CapabilityStatement-ISiKCapabilityStatementLaborMinimalRolle.html\">ISiK CapabilityStatement Labor Minimal Rolle</a>, <a href=\"CapabilityStatement-ISiKCapabilityStatementGesundheitsstatusRolle.html\">CapabilityStatement für Rolle ISiKCapabilityStatementGesundheitsstatusRolle</a></p><h2 id=\"rest\">FHIR RESTful Capabilities</h2><div class=\"panel panel-default\"><div class=\"panel-heading\"><h3 id=\"mode1\" class=\"panel-title\">Mode: <code>server</code></h3></div><div class=\"panel-body\"/></div></div>"
  ] ;
