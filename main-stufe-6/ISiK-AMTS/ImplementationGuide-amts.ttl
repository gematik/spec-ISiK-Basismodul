       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://gematik.de/fhir/isik/StructureDefinition/ISiKLaboruntersuchungCRP> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/ISiKLaboruntersuchungCRP" ]
       ] ;
