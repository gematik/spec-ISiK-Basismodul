       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "ISiK AMTS-Bewertung" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Dieses Profil ermöglicht die Abbildung von Informationen zur Risikobeurteilung im Rahmen der Arzneimitteltherapiesicherheit (AMTS)." ] ;
