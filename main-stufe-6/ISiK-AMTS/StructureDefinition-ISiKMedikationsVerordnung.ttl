       fhir:ElementDefinition.path [ fhir:value "MedicationRequest.dosageInstruction.sequence" ] ;
       fhir:ElementDefinition.short [ fhir:value "The order of the dosage instructions" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Indicates the order in which the dosage instructions should be applied or interpreted." ] ;
       fhir:ElementDefinition.requirements [ fhir:value "If the sequence number of multiple Dosages is the same, then it is implied that the instructions are to be treated as concurrent.  If the sequence number is different, then the Dosages are intended to be sequential." ] ;
