       ]
     ], [
       fhir:index 48 ;
       fhir:Element.id [ fhir:value "MedicationRequest.dosageInstruction.extension.value[x]:valueCodeableConcept.text" ] ;
       fhir:ElementDefinition.path [ fhir:value "MedicationRequest.dosageInstruction.extension.value[x].text" ] ;
       fhir:ElementDefinition.short [ fhir:value "Indikation für die Bedarfsmedikation (Freitext)" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung des Must-Support: Ermöglicht die Angabe einer Indikation für die Bedarfsmedikation in Freitextform, eine Kodierung ist nicht verpflichtend. Es wird jedoch empfohlen, die Indikation zusätzlich in kodierter Form anzugeben, um die Interoperabilität zu erhöhen." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 49 ;
       fhir:Element.id [ fhir:value "MedicationRequest.dosageInstruction.extension:asNeededFor" ] ;
       fhir:ElementDefinition.path [ fhir:value "MedicationRequest.dosageInstruction.extension" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "asNeededFor" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Extension" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "http://hl7.org/fhir/5.0/StructureDefinition/extension-Dosage.asNeededFor" ;
