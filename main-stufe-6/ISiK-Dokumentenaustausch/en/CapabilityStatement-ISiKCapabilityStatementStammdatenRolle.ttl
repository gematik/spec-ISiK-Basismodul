  fhir:CapabilityStatement.date [ fhir:value "2026-07-01"^^xsd:date] ;
  fhir:CapabilityStatement.publisher [ fhir:value "gematik GmbH"] ;
  fhir:CapabilityStatement.contact [
     fhir:index -1 ;
     fhir:ContactDetail.name [ fhir:value "gematik GmbH" ] ;
