       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "EndDate" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "The actual end date of the Encounter (Backport from R5). The parameter cannot repeat or have multiple values." ] ;
