         fhir:Reference.reference [ fhir:value "ValueSet/ISiKEncounterTypeErweiterungVS" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "ISiKEncounterTypeErweiterungVS" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "ISiK vereint hierbei das ValueSet [KontaktArtDe](http://fhir.de/CodeSystem/kontaktart-de) aus dem deutschen Basisprofil und die übergangsweise hinzugefügten Codes für den ambulanten Kontakt im Krankenhaus. Dieses ValueSet ist als Übergangslösung zu verstehen, da die Inhalte beim TC Terminologien von HL7 eingebracht sind und sobald sie dort publiziert sind, wird eine Migration auf die dortigen Codes erfolgen." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
