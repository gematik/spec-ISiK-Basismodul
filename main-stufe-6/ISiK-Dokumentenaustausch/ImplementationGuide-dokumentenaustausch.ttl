       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Vertraulichkeitsstufen" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
