       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://gematik.de/fhir/isik/StructureDefinition/ISiKLaboruntersuchungTSH> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/ISiKLaboruntersuchungTSH" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "ISiKLaboruntersuchungTSH" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Dieses Profil ermöglicht die Abbildung der Laboruntersuchung des Thyreoidea-stimulierenden Hormons (TSH) eines Patienten in ISiK Szenarien." ] ;
