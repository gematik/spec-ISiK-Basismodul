         fhir:link <http://fhir.de/ValueSet/EncounterClassDE>
       ]
     ], [
       fhir:index 1 ;
       fhir:ValueSet.compose.include.system [ fhir:value "http://terminology.hl7.org/CodeSystem/v3-ActCode" ] ;
       fhir:ValueSet.compose.include.version [ fhir:value "11.0.0" ] ;
       fhir:ValueSet.compose.include.concept [
         fhir:index 0 ;
         fhir:ValueSet.compose.include.concept.code [ fhir:value "ACUTE" ] ;
         fhir:ValueSet.compose.include.concept.display [ fhir:value "inpatient acute" ]
       ], [
         fhir:index 1 ;
         fhir:ValueSet.compose.include.concept.code [ fhir:value "NONAC" ] ;
         fhir:ValueSet.compose.include.concept.display [ fhir:value "inpatient non-acute" ]
       ], [
