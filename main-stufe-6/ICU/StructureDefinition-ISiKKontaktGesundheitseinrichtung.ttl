       fhir:ElementDefinition.path [ fhir:value "Encounter.location.physicalType" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Die Kodierung in diesem Slice entstammt folgendem Valueset - gelistet unter .location.(All slices.)physicalType: https://gematik.de/fhir/isik/ValueSet/ISiKLocationPhysicalType" ] ;
