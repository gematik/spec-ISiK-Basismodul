       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 19 ;
       fhir:Element.id [ fhir:value "Encounter.identifier:Aufnahmenummer.system" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.identifier.system" ] ;
       fhir:ElementDefinition.short [ fhir:value "Namensraum des Identifiers" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hier ist stets der eindeutige Name (URL) des Namensraums anzugeben, \n    aus dem der Identifier stammt. \n    Hinweise zur Festlegung der URLs für lokale Namensräume sind in den \n    [Deutschen Basisprofilen](https://simplifier.net/guide/leitfaden-de-basis-r4/ig-markdown-Terminologie-Namensraeume?version=current) beschrieben.  \n    **Begründung Pflichtfeld:** `system` stellt in Kombination mit `value` die Eindeutigkeit eines Identifiers sicher." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 20 ;
       fhir:Element.id [ fhir:value "Encounter.identifier:Aufnahmenummer.value" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.identifier.value" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Enthält den eigentlichen Wert des Identifiers.  \n    **Begründung Pflichtfeld:** Ist der Wert nicht bekannt, sollte der gesamte Slice weggelassen werden." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 21 ;
       fhir:Element.id [ fhir:value "Encounter.status" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.status" ] ;
       fhir:ElementDefinition.short [ fhir:value "Status" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Zeigt den aktuellen Status der Ressource an.     \n  **WICHTIGER Hinweis für Implementierer:**    \n  * Alle server-seitigen Implementierungen MÜSSEN in der Lage sein, \n  die systemintern möglichen Statuswerte korrekt in FHIR abzubilden, mindestens jedoch die Werte `in-progress`, `finished` und `cancelled`.\n  * Alle client-seitigen Implementierungen MÜSSEN in der Lage sein, sämtliche Status-Codes zu interpretieren und dem Anwender in angemessener Form darstellen zu können, \n  beispielsweise durch Ausblenden/Durchstreichen von Ressourcen mit dem status `entered-in-error` und Ausgrauen von Ressourcen, die einen Plan- oder Entwurfs-Status haben.  \n  **Historie:** Die Reduktion der zulässigen Status-Werte im Vergleich zur FHIR-Kernspezifikation \n  erfolgt im Vorgriff auf eine entsprechende Anpassung in FHIR R5." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.description [ fhir:value "Eingeschränkter Status vgl. FHIR R5" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "http://fhir.de/ValueSet/EncounterStatusDe" ;
           fhir:link <http://fhir.de/ValueSet/EncounterStatusDe>
         ]
       ]
     ], [
       fhir:index 22 ;
       fhir:Element.id [ fhir:value "Encounter.class" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.class" ] ;
       fhir:ElementDefinition.short [ fhir:value "Fallart" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Die Klassifikation von Encountern nach Fallarten folgt den internationalen Vorgaben und \n  dient der groben Unterscheidung von Besuchen mit und ohne Bettendisposition (ambulant/stationär). \n  Die in Deutschland übliche Fallklassifikation anhand von unterschiedlichen \n  regulatorischen und abrechnungrelevanten Rahmenbedingungen, erfolgt in `type`.  \n  Für ein korrektes Mapping der in Deutschland gebräuchlichen Fallarten auf `class` siehe [Deutsche Basisprofile](https://simplifier.net/guide/leitfaden-de-basis-r4/ig-markdown-Ressourcen-AmbulanterStationaererFall?version=current)" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "https://gematik.de/fhir/isik/ValueSet/ISiKEncounterClassDE" ;
           fhir:link <https://gematik.de/fhir/isik/ValueSet/ISiKEncounterClassDE>
         ]
       ]
     ], [
       fhir:index 23 ;
       fhir:Element.id [ fhir:value "Encounter.type" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.type" ] ;
       fhir:ElementDefinition.slicing [
         fhir:ElementDefinition.slicing.discriminator [
           fhir:index 0 ;
           fhir:ElementDefinition.slicing.discriminator.type [ fhir:value "pattern" ] ;
           fhir:ElementDefinition.slicing.discriminator.path [ fhir:value "$this" ]
         ] ;
         fhir:ElementDefinition.slicing.rules [ fhir:value "open" ]
       ] ;
       fhir:ElementDefinition.comment [ fhir:value "Typ des Encounter" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 24 ;
       fhir:Element.id [ fhir:value "Encounter.type:Kontaktebene" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.type" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "Kontaktebene" ] ;
       fhir:ElementDefinition.short [ fhir:value "Kontaktebene" ] ;
       fhir:ElementDefinition.comment [ fhir:value "  **Begründung Pflichtfeld:** Die Abteilungsebene muss aus Kompatibilitätsgründen angegeben werden.\n\n  **Hinweis bei Abbildung von Versorgungsstellenkontakten:**\n  Es ist ein üblicher Fall, dass die Dauer eines Versorgungsstellenkontaktes in der Versorgung die eines Abteilungskontaktes übersteigt. Ein Beispiel hierfür: Ein Patient bleibt im Bett (Versorgungsstellenkontakt), aber ein Fachabteilungswechsel geschieht, da die Diagnose über eine Fachabteilung (Onkologie) läuft, dann aber der Wechsel zur Fachabteilung Chirurgie (neuer Abteilungskontakt) notwendig wird.\n  Für einen solchen Fall gilt auf Ebene der FHIR-Instanzen (z.B. entgegen des tatsächliche Aufenthaltes im gleichen Bett): Im Falle eines Fachabteilungswechsels legt ein System einen neuen Abteilungskontakt an. Bestehende Versorgungsstellenkontakt SOLLEN NICHT in ihrer Relation (.partOf) zum Abteilungskontakt modifiziert werden. Hingegen SOLL das System einen oder mehrere Versorgungsstellenkontakte erzeugen und mit dem neu angelegten Abteilungskontakt in Verbindung setzen.\n\n  Hintergrund: Das Konzept der 'Kontaktebene' stammt aus dem Fallmodell der Medizininformatik-Initiative,\n  das bei Encountern zwischen 'Einrichtungskontakten', 'Fachabteilungskontakten' und 'Versorgungsstellenkontakten' unterscheidet.\n  Im Kontext dieses Moduls werden lediglich Encounter der Ebene 'Fachabteilungskontakt' abgebildet.\n  " ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.patternCodeableConcept [
         fhir:CodeableConcept.coding [
           fhir:index 0 ;
           fhir:Coding.system [ fhir:value "http://fhir.de/CodeSystem/Kontaktebene" ] ;
           fhir:Coding.code [ fhir:value "abteilungskontakt" ]
         ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.description [ fhir:value "Kontaktebene" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "http://fhir.de/ValueSet/kontaktebene-de" ;
           fhir:link <http://fhir.de/ValueSet/kontaktebene-de>
         ]
       ]
     ], [
       fhir:index 25 ;
       fhir:Element.id [ fhir:value "Encounter.type:Kontaktebene.coding" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.type.coding" ] ;
       fhir:ElementDefinition.short [ fhir:value "Codierte Darstellung der Kontaktebene" ]
     ], [
       fhir:index 26 ;
       fhir:Element.id [ fhir:value "Encounter.type:Kontaktebene.coding.system" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.type.coding.system" ] ;
       fhir:ElementDefinition.short [ fhir:value "Codier-Schema" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hier ist stets der Wert `http://fhir.de/CodeSystem/Kontaktebene` anzugeben." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 27 ;
       fhir:Element.id [ fhir:value "Encounter.type:Kontaktebene.coding.code" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.type.coding.code" ] ;
       fhir:ElementDefinition.short [ fhir:value "Code" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hier ist stets der Wert `abteilungskontakt` anzugeben." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 28 ;
       fhir:Element.id [ fhir:value "Encounter.type:KontaktArt" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.type" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "KontaktArt" ] ;
       fhir:ElementDefinition.short [ fhir:value "Kontaktart" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Die Kontaktart dient der feingranularen Differenzierung unterschiedlicher stationärer \n  und ambulanter Fallarten gemäß der in Deutschland üblichen regulatorischen \n  und abrechnungsrelevanten Rahmenbedingungen.  \n  Für ein korrektes Mapping der in Deutschland gebräuchlichen Fallarten auf `type` siehe [Deutsche Basisprofile](https://simplifier.net/guide/leitfaden-de-basis-r4/ig-markdown-Ressourcen-AmbulanterStationaererFall?version=current)" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "https://gematik.de/fhir/isik/ValueSet/ISiKEncounterTypeErweiterungVS" ;
           fhir:link <https://gematik.de/fhir/isik/ValueSet/ISiKEncounterTypeErweiterungVS>
         ]
       ]
     ], [
       fhir:index 29 ;
       fhir:Element.id [ fhir:value "Encounter.type:KontaktArt.coding" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.type.coding" ] ;
       fhir:ElementDefinition.short [ fhir:value "Codierte Darstellung der Kontaktart" ]
     ], [
       fhir:index 30 ;
       fhir:Element.id [ fhir:value "Encounter.type:KontaktArt.coding.system" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.type.coding.system" ] ;
       fhir:ElementDefinition.short [ fhir:value "Codier-Schema" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 31 ;
       fhir:Element.id [ fhir:value "Encounter.type:KontaktArt.coding.code" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.type.coding.code" ] ;
       fhir:ElementDefinition.short [ fhir:value "Code" ] ;
       fhir:ElementDefinition.comment [ fhir:value "vorstationaer | nachstationaer | begleitperson | tagesklinik | +" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 32 ;
       fhir:Element.id [ fhir:value "Encounter.serviceType" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.serviceType" ] ;
       fhir:ElementDefinition.short [ fhir:value "Fachabteilungsschlüssel" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung MS:** Der Fachabteilungsschlüssel ist ein häufig verwendetes Suchkriterium und sollte daher als logische Referenz (`serviceType`) hinterlegt werden." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 33 ;
       fhir:Element.id [ fhir:value "Encounter.serviceType.coding" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.serviceType.coding" ] ;
       fhir:ElementDefinition.slicing [
         fhir:ElementDefinition.slicing.discriminator [
           fhir:index 0 ;
           fhir:ElementDefinition.slicing.discriminator.type [ fhir:value "pattern" ] ;
           fhir:ElementDefinition.slicing.discriminator.path [ fhir:value "$this" ]
         ] ;
         fhir:ElementDefinition.slicing.rules [ fhir:value "open" ]
       ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
