       fhir:ElementDefinition.path [ fhir:value "Encounter.hospitalization.dischargeDisposition.extension" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "RehaEntlassung" ] ;
       fhir:ElementDefinition.short [ fhir:value "Entlassungsgrund Reha" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Entlassungsgrund nach §301 (Abs. 4 und 4a) SGB V  \n      **Einschränkung MS:** Der Entlassungsgrund Reha muss nur implementiert werden,\n        wenn das bestätigungsrelevante System in der Reha-Versorgung eingesetzt wird" ] ;
