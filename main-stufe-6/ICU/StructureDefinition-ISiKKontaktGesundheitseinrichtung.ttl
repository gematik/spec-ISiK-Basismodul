       fhir:ElementDefinition.comment [ fhir:value "**Begründung MS:** Die Verlinkung auf eine Location-Ressource dient der technischen Zuordnung des Besuchs zu einem Aufenthaltsort \n    und ermöglicht wichtige API-Funktionen wie verkettete Suche, (Reverse-)Include etc." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
