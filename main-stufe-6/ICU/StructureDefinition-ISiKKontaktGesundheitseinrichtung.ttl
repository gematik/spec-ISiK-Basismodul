       fhir:Element.id [ fhir:value "Encounter.serviceType.coding:Fachabteilungsschluessel" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.serviceType.coding" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "Fachabteilungsschluessel" ] ;
       fhir:ElementDefinition.short [ fhir:value "Fachabteilungsschlüssel" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Fachabteilungen gemäß Anhang 1 der BPflV" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.patternCoding [
         fhir:Coding.system [ fhir:value "http://fhir.de/CodeSystem/dkgev/Fachabteilungsschluessel" ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "http://fhir.de/ValueSet/dkgev/Fachabteilungsschluessel" ;
           fhir:link <http://fhir.de/ValueSet/dkgev/Fachabteilungsschluessel>
         ]
       ]
     ], [
       fhir:index 35 ;
       fhir:Element.id [ fhir:value "Encounter.serviceType.coding:ErweiterterFachabteilungsschluessel" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.serviceType.coding" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "ErweiterterFachabteilungsschluessel" ] ;
       fhir:ElementDefinition.short [ fhir:value "Fachabteilungsschlüssel" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Fachabteilungen gemäß Anhang 1 der BPflV inkl. Spezialisierungen" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.patternCoding [
         fhir:Coding.system [ fhir:value "http://fhir.de/CodeSystem/dkgev/Fachabteilungsschluessel-erweitert" ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "http://fhir.de/ValueSet/dkgev/Fachabteilungsschluessel-erweitert" ;
           fhir:link <http://fhir.de/ValueSet/dkgev/Fachabteilungsschluessel-erweitert>
         ]
       ]
     ], [
       fhir:index 36 ;
       fhir:Element.id [ fhir:value "Encounter.priority" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.priority" ] ;
       fhir:ElementDefinition.short [ fhir:value "Aufnahmepriorität" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung MS:** Harmonisierung mit dem HL7 Europe Hospital Discharge Report (HDR)." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 37 ;
       fhir:Element.id [ fhir:value "Encounter.subject" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.subject" ] ;
       fhir:ElementDefinition.short [ fhir:value "Patientenbezug" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung Must-Support:** Ein Patientenbezug des Kontakt MUSS stets zum Zwecke der Nachvollziehbarkeit und Datenintegrität vorliegen." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 38 ;
       fhir:Element.id [ fhir:value "Encounter.subject.reference" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.subject.reference" ] ;
       fhir:ElementDefinition.short [ fhir:value "Patienten-Link" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung Pflichtfeld:** Die Verlinkung auf eine Patienten-Ressource dient der technischen Zuordnung der Dokumentation zu einem Patienten \n      und ermöglicht wichtige API-Funktionen wie verkettete Suche, (Reverse-)Include etc." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 39 ;
       fhir:Element.id [ fhir:value "Encounter.appointment" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.appointment" ] ;
       fhir:ElementDefinition.short [ fhir:value "Verknüpfung mit einem Termin" ] ;
       fhir:ElementDefinition.comment [ fhir:value "\n  \n**Begründung und Einschränkung des Must Support**: Dieses Element dient der Verknüpfung mit einem Termin (Appointment) aus dem entsprechenden ISiK Modul und - darauf aufbauend - der Dokumentenkommunikation. Das Element 'appointment' SOLL für den im Folgenden geschilderten Fall implementiert werden. Andernfalls KANN es entfallen. \n\nDie Anforderung einer Verknüpfung mit einem Appointment stammt aus dem Szenario der Dokumentenübertragung zwischen Patientenportal und krankenhaus-internem Primärsystem (z.B. KIS) im Kontext einer Terminbuchung: Dokumente liegen bei Terminbuchung erst im Patientenportal (im Appointment) vor und werden erst mit Anlage des Encounters in das KIS (etc.) übermittelt. Dazu SOLL ein Primärsystem zu Beginn des Termins das Appointment mit dem neu angelegten Encounter verknüpfen, um die Dokumente aus dem Patientenportal darüber vermittelt zuordnen zu können (ausgenommen hiervon sind Termine, die nicht stattfinden, da für diese in der Regel keine Encounter angelegt werden).\n\nÜber die Referenz auf Appointment KÖNNEN Patientenportale den Fallbezug aus dem Termin ermitteln und Dokumente an ein KIS senden.\n\nHieraus folgt, dass das Element nur relevant ist, falls das bestätigungsrelevante System zusätzlich zum vorliegenden Profil (Encounter) das Profil ISiKTermin (Appointment) implementiert.\n\n**Hinweis:**  Zur Umsetzung der Funktionalität zum Dokumentenaustausch gemäß ISiK ist der entsprechende [Implementation Guide zum Modul Dokumentenaustausch](https://gemspec.gematik.de/ig/fhir/isik/dokumentenaustausch/6.0.0-rc1/index.html) zu beachten." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 40 ;
       fhir:Element.id [ fhir:value "Encounter.period" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.period" ] ;
       fhir:ElementDefinition.short [ fhir:value "Aufenthaltszeitraum" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**WICHTIGER Hinweis für Implementierer:** \n  * Das Aufnahmedatum  MUSS angegeben werden, \n  wenn der `status` des Encounters impliziert, dass dieser bereits begonnen hat.\n  * Das Entlassdatum MUSS angegeben werden, \n  wenn der `status` des Encounters impliziert, dass dieser beendet ist.  \n  Siehe hierzu die Übersicht der Invarianten in diesem Profil. " ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 41 ;
       fhir:Element.id [ fhir:value "Encounter.period.start" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter.period.start" ] ;
       fhir:ElementDefinition.short [ fhir:value "Aufnahmedatum" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hier ist stets das *tatsächliche* Aufnahmedatum anzugeben.\n    *Geplante* Aufnahmedaten müssen über die Extension `plannedStartDate` erfasst werden." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 42 ;
       fhir:Element.id [ fhir:value "Encounter.period.end" ] ;
