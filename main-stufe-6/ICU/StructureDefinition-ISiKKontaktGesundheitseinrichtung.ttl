       fhir:ElementDefinition.path [ fhir:value "Encounter.account.identifier" ] ;
       fhir:ElementDefinition.short [ fhir:value "(Abrechnungs-)Fallnummer" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 55 ;
