       fhir:ElementDefinition.short [ fhir:value "Condition/Procedure-Link" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung Pflichtfeld:** Die Verlinkung auf die Condition/Procedure-Ressource dient der technischen Zuordnung des Encounters zur Condition/Precedure \n  und ermöglicht wichtige API-Funktionen wie verkettete Suche, (Reverse-)Include etc." ] ;
