  fhir:Questionnaire.description [ fhir:value "### Beispiel-Questionnaire mit automatischer Vorbelegung von demografischen Patientendaten \nDer Patientenkontext wird mittels der [SDC-LaunchContexts](https://build.fhir.org/ig/HL7/sdc/StructureDefinition-sdc-questionnaire-launchContext.html)-Extension hergestellt.  \nDie Vorbelegung erfolgt über die [SDC-InitialExpression](https://build.fhir.org/ig/HL7/sdc/StructureDefinition-sdc-questionnaire-initialExpression.html)-Extension"] ;
  fhir:Questionnaire.item [
     fhir:index -1 ;
     fhir:Questionnaire.item.linkId [ fhir:value "1" ] ;
     fhir:Questionnaire.item.text [ fhir:value "Demografische Patientendaten" ] ;
     fhir:Questionnaire.item.type [ fhir:value "group" ] ;
     fhir:Questionnaire.item.required [ fhir:value "true"^^xsd:boolean ] ;
     fhir:Questionnaire.item.item [
       fhir:index -1 ;
       fhir:Element.extension [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaire-initialExpression" ] ;
         fhir:Extension.valueExpression [
           fhir:Expression.description [ fhir:value "Selektion des ersten Vornamens des Patienten. Präferiert aus dem offiziellem Namen, alternativ erster gefundener Name" ] ;
           fhir:Expression.language [ fhir:value "text/fhirpath" ] ;
           fhir:Expression.expression [ fhir:value "(%patient.name.where(use = 'official').given[0] | %patient.name[0].given[0]).first()" ]
         ]
       ] ;
       fhir:Questionnaire.item.linkId [ fhir:value "1.1" ] ;
       fhir:Questionnaire.item.text [ fhir:value "Vorname:" ] ;
       fhir:Questionnaire.item.type [ fhir:value "string" ]
     ], [
       fhir:index -1 ;
       fhir:Element.extension [
