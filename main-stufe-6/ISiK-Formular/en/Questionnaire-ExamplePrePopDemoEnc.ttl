         fhir:Extension.valueExpression [
           fhir:Expression.description [ fhir:value "Selektion des Nachnamens des Patienten. Präferiert aus dem offiziellem Namen, alternativ erster gefundener Name" ] ;
           fhir:Expression.language [ fhir:value "text/fhirpath" ] ;
           fhir:Expression.expression [ fhir:value "(%patient.name.where(use = 'official').family | %patient.name[0].family).first()" ]
         ]
       ] ;
       fhir:Questionnaire.item.linkId [ fhir:value "1.2" ] ;
       fhir:Questionnaire.item.text [ fhir:value "Nachname:" ] ;
       fhir:Questionnaire.item.type [ fhir:value "string" ]
