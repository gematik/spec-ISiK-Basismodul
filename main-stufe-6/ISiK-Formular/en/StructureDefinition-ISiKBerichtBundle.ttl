       fhir:Element.id [ fhir:value "Bundle.identifier" ] ;
       fhir:ElementDefinition.path [ fhir:value "Bundle.identifier" ] ;
       fhir:ElementDefinition.short [ fhir:value "Identifier des Berichtsbundles" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Motivation MS:** Zur Identifikation des Berichtbundles muss ein Identifier vom Subsystem mit angegeben werden." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Bundle.type" ] ;
       fhir:ElementDefinition.path [ fhir:value "Bundle.type" ] ;
       fhir:ElementDefinition.short [ fhir:value "Typ des Bundles" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung MS:** Damit das Bundle ein Document-Bundle nach FHIR-Core Spec ist, muss der type auf `document` gesetzt werden." ] ;
       fhir:ElementDefinition.fixedCode [ fhir:value "document" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
