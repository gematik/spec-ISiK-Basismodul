       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Bundle.id" ] ;
       fhir:ElementDefinition.path [ fhir:value "Bundle.id" ] ;
       fhir:ElementDefinition.short [ fhir:value "serverseitige, interne ID des Datensatzes" ] ;
       fhir:ElementDefinition.definition [ fhir:value "The logical id of the resource, as used in the URL for the resource. Once assigned, this value never changes." ] ;
       fhir:ElementDefinition.comment [ fhir:value "**bedingtes Pflichtfeld/bedingtes MS:** Alle von einem Server bereitgestellten Ressourcen MÜSSEN über eine `id` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `id`verfügen. " ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
