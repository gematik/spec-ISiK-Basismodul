           fhir:Expression.language [ fhir:value "text/fhirpath" ] ;
           fhir:Expression.expression [ fhir:value "%patient.identifier.where(system='http://fhir.de/sid/gkv/kvid-10').value" ]
         ]
       ] ;
       fhir:Questionnaire.item.linkId [ fhir:value "1.4" ] ;
       fhir:Questionnaire.item.text [ fhir:value "Versichertennummer:" ] ;
       fhir:Questionnaire.item.type [ fhir:value "string" ]
     ]
  ] .

