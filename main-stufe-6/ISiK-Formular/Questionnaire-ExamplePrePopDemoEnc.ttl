           fhir:Expression.expression [ fhir:value "%encounter.location.where(physicalType.coding.first().code = 'wa' and status = 'active').location.display" ]
         ]
       ] ;
       fhir:Questionnaire.item.linkId [ fhir:value "2.7" ] ;
       fhir:Questionnaire.item.text [ fhir:value "Aktuelle Station:" ] ;
