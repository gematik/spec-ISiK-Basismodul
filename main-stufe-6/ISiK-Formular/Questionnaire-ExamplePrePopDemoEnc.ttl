           fhir:Expression.expression [ fhir:value "%encounter.account.identifier.first().value" ]
         ]
       ] ;
       fhir:Questionnaire.item.linkId [ fhir:value "2.1" ] ;
       fhir:Questionnaire.item.text [ fhir:value "Fallnummer:" ] ;
       fhir:Questionnaire.item.type [ fhir:value "string" ]
     ], [
