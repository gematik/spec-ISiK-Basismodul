       fhir:ImplementationGuide.definition.resource.name [ fhir:value "ISiKMpFormularExtension" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Mit dieser Extension besteht die Möglichkeit anzugeben, dass das Formular innerhalb eines Medizinproduktes eingesetzt wird und eine Zweckbestimmung anzugeben ist. Die Interpretation der Zweckbestimmung und der daraus folgenden Konsequenzen für die eingesetzte Software liegt im Verantwortungsbereich des Software-Hersteller!" ] ;
