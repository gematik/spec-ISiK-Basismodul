       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Extension" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://gematik.de/fhir/isik/StructureDefinition/ISiKMpFormularExtension" ;
           fhir:index 0 ;
           fhir:link <https://gematik.de/fhir/isik/StructureDefinition/ISiKMpFormularExtension>
         ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 8 ;
       fhir:Element.id [ fhir:value "Questionnaire.url" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.url" ] ;
       fhir:ElementDefinition.short [ fhir:value "CanoncialURL des Formulars" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Weltweit eindeutiger Name des Formulars.\n  **Begründung Pflichtfeld:**\n  Wird für eindeutige Bezugnahme von FormularDaten auf FormularDefinition benötigt." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 9 ;
       fhir:Element.id [ fhir:value "Questionnaire.version" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.version" ] ;
       fhir:ElementDefinition.short [ fhir:value "Version" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Versionsnummer des Formulars. Sollte gem. semVer-Regeln inkrementiert werden, je nach Schweregrad der Änderungen.\n  **Begründung MS:**  \n  Wird benötigt, um FormularDefinitionen in unterschiedlichen Versionen zu differenzieren. " ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 10 ;
       fhir:Element.id [ fhir:value "Questionnaire.title" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.title" ] ;
       fhir:ElementDefinition.short [ fhir:value "Titel/Überschrift" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Dem Anwender angezeigter Titel des Formulars.  \n  **Begründung MS:**  \n  Wird für die Darstellung und Auffindbarkeit der FormularDefinition benötigt." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 11 ;
       fhir:Element.id [ fhir:value "Questionnaire.derivedFrom" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.derivedFrom" ] ;
       fhir:ElementDefinition.short [ fhir:value "Abgeleitet von" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Verweis auf ein Questionnaire, von dem abgeleitet wurde, welches erweitert wurde oder welches als Grundlage diente." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 12 ;
       fhir:Element.id [ fhir:value "Questionnaire.status" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.status" ] ;
       fhir:ElementDefinition.short [ fhir:value "active | retired" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Die im ISiK-Kontext bereitgestellten Formulare sollten final ausspezifiziert sein und daher den Status 'active' haben. \n  Formulare, die zurückgezogen oder durch neuere Versionen ersetzt wurden, können mit 'retired' gekennzeichnet werden." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 13 ;
       fhir:Element.id [ fhir:value "Questionnaire.subjectType" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.subjectType" ] ;
       fhir:ElementDefinition.short [ fhir:value "Subject, über das in diesem Formular berichtet wird." ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung Pflichtfeld:** Die in diesem Modul beschriebenen Funktionen und Interaktionen beziehen sich auf den subjectType `Patient`. Ist hier ein anderer subjectType angegeben, so unterliegt das Formular nicht den Einschränkungen und Anforderungen, die in diesem IG für ISiK-Formulare definiert sind. Um dennoch eine Validität zum Profil herzustellen, wurde das Pattern entfernt.\n  \n  **Hinweis:** Ist der subjectType `Patient` gesetzt, ist stets davon auszugehen, dass der Patient, für den dieses Formular ausgefüllt wird, identisch ist, mit dem Patient, der im Launch-Kontext übergeben wird." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 14 ;
       fhir:Element.id [ fhir:value "Questionnaire.description" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.description" ] ;
       fhir:ElementDefinition.short [ fhir:value "Formularbeschreibung" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung Pflichtfeld:**  \n  Ausführliche Beschreibung des Formulars zur Verbesserung der Auffindbarkeit und Interpretation der Nutzung" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 15 ;
       fhir:Element.id [ fhir:value "Questionnaire.item" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.item" ] ;
       fhir:ElementDefinition.short [ fhir:value "Formularfeld" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Formularfeld oder Einstiegspunkt für eine Gruppe von Formularfeldern" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 16 ;
       fhir:Element.id [ fhir:value "Questionnaire.item.linkId" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.item.linkId" ] ;
       fhir:ElementDefinition.short [ fhir:value "innerhalb dieses Formulars eindeutige ID dieses Feldes" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung Pflichtfeld:**  \n    Erforderlich für die Verlinkung der Antworten in der QuestionnaireRespons mit der Definition des Formularfeldes." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 17 ;
       fhir:Element.id [ fhir:value "Questionnaire.item.code" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.item.code" ] ;
       fhir:ElementDefinition.short [ fhir:value "Code für dieses Formularfeld" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung MS:**  \n    Zur eindeutigen Identifikation des Formularfeldes. Ohne Code ist Observation-based-extraction nicht möglich.\n    Wenn kein Code zur Verfügung steht, besteht weiterhin die Möglichkeit ein Item ohne Code zu definieren." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 18 ;
       fhir:Element.id [ fhir:value "Questionnaire.item.prefix" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.item.prefix" ] ;
       fhir:ElementDefinition.short [ fhir:value "Feld für bspw. Nummerierung von Elementen" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung MS:**\n    Falls bspw. eine Gruppierung oder Nummerierung nicht über die Verschachtelung von Items erfolgt, kann über das Prefix eine solche erfolgen. Aus dem Grund MUSS es in der Darstellung beim Rendern mit verarbeitet werden." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 19 ;
       fhir:Element.id [ fhir:value "Questionnaire.item.text" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.item.text" ] ;
       fhir:ElementDefinition.short [ fhir:value "Fragestellung, Anzeigetext oder Gruppenname" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung MS:**  \n    Je nach 'type' des items: Fragestellung, Anzeigetext oder Gruppenname" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 20 ;
       fhir:Element.id [ fhir:value "Questionnaire.item.type" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.item.type" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Time is handled using \"string\".  File is handled using Attachment.  (Content can be sent as a contained binary)." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 21 ;
       fhir:Element.id [ fhir:value "Questionnaire.item.enableWhen" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.item.enableWhen" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung MS:** Bedingungen, die erfüllt sein müssen, damit das Item dargestellt wird. Dieses Feld ist ein modifier-Element, weshalb MS obligatorisch ist, es muss interpretiert werden." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 22 ;
       fhir:Element.id [ fhir:value "Questionnaire.item.enableWhen.question" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.item.enableWhen.question" ] ;
       fhir:ElementDefinition.comment [ fhir:value "LinkId der Frage, bei der die Bedingung zu erfüllen ist." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 23 ;
       fhir:Element.id [ fhir:value "Questionnaire.item.enableWhen.operator" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.item.enableWhen.operator" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Operator, mittels dem die Value der .question mit dem in answer[x] angegeben Element vergleichen wird." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 24 ;
       fhir:Element.id [ fhir:value "Questionnaire.item.enableWhen.answer[x]" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.item.enableWhen.answer[x]" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Rechter Wert des Bedingungsvergleich" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 25 ;
       fhir:Element.id [ fhir:value "Questionnaire.item.required" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.item.required" ] ;
       fhir:ElementDefinition.short [ fhir:value "Pflichtfeld?" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung MS:**  \n    FormularRenderer sollen sicherstellen können, dass Formulare vom Anwender vollständig ausgefüllt werden." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 26 ;
       fhir:Element.id [ fhir:value "Questionnaire.item.repeats" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.item.repeats" ] ;
       fhir:ElementDefinition.short [ fhir:value "Mehrfachangaben erlaubt?" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung MS:**  FormularRenderer sollen in der Lage sein zwischen Einfach- und Mehrfachangaben unterscheiden zu können." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 27 ;
       fhir:Element.id [ fhir:value "Questionnaire.item.readOnly" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.item.readOnly" ] ;
       fhir:ElementDefinition.short [ fhir:value "Keine Eingabe erlaubt?" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Antwort wird automatisch vorbelegt/berechnet und darf nicht vom Anwender editiert/überschrieben werden.\n    **Begründung MS:** Automatisch vorbelegte Items sollen gegen Veränderung durch den Benutzer geschützt werden können (z.B. für Patientenstammdaten)." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 28 ;
       fhir:Element.id [ fhir:value "Questionnaire.item.maxLength" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.item.maxLength" ] ;
       fhir:ElementDefinition.short [ fhir:value "Längenbegrenzung" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Maximale Anzahl zulässiger Zeichen für die Beantwortung der Frage." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 29 ;
       fhir:Element.id [ fhir:value "Questionnaire.item.answerValueSet" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.item.answerValueSet" ] ;
       fhir:ElementDefinition.short [ fhir:value "Festlegung der Antwortmöglichkeiten durch Verweis auf ValueSet" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung MS:**  Wo geeignete ValueSets vorhanden sind, die die Antwortmöglichkeiten hinreichend repräsentieren, sollte auf diese verwiesen werden." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 30 ;
       fhir:Element.id [ fhir:value "Questionnaire.item.answerOption" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.item.answerOption" ] ;
       fhir:ElementDefinition.short [ fhir:value "Festlegung der Antwortmöglichkeiten durch Aufzählung" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung MS:**  Wo *keine* geeignete ValueSets vorhanden sind, die die Antwortmöglichkeiten hinreichen repräsentieren, \n    können Antworten alternativ in der FormularDefinition explizit aufgezählt werden.." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 31 ;
       fhir:Element.id [ fhir:value "Questionnaire.item.item" ] ;
       fhir:ElementDefinition.path [ fhir:value "Questionnaire.item.item" ] ;
       fhir:ElementDefinition.short [ fhir:value "Untergeordnetes Item" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung MS:**  \n   Items können beliebig verschachtelt und zu Gruppen zusammengefasst werden, um komplexere und umfangreichere Formulare zu strukturieren." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ]
  ] .

