  fhir:CapabilityStatement.name [ fhir:value "ISiKCapabilityStatementOrganspendeerkennungSourceAkteur"] ;
  fhir:CapabilityStatement.title [ fhir:value "ISiK CapabilityStatement Organspendeerkennung Server"] ;
  fhir:CapabilityStatement.status [ fhir:value "active"] ;
  fhir:CapabilityStatement.experimental [ fhir:value "false"^^xsd:boolean] ;
  fhir:CapabilityStatement.date [ fhir:value "2026-07-01"^^xsd:date] ;
