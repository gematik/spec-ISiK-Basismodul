         fhir:Reference.reference [ fhir:value "CodeSystem/ISiKEntlassformRehaCS" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "ISiKEntlassformReha" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "ISiK Entlassform Reha. Beschreibt Form und ggf. Weiterbehandlung der Entlassung eines Versicherten/Berechtigten aus verwaltungs- und medizinischer Sicht. Vgl. Schlüsseltabelle 2.107 Entlassungsform." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 63 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "ValueSet" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://gematik.de/fhir/isik/ValueSet/ISiKEntlassformReha> ;
         fhir:Reference.reference [ fhir:value "ValueSet/ISiKEntlassformReha" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "ISiKEntlassformRehaVS" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "ISiK Entlassform Reha. Beschreibt Form und ggf. Weiterbehandlung der Entlassung eines Versicherten/Berechtigten aus verwaltungs- und medizinischer Sicht. Vgl. Schlüsseltabelle 2.107 Entlassungsform." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
       fhir:index 64 ;
       fhir:Element.extension [
         fhir:index 0 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/resource-information" ] ;
         fhir:Extension.valueString [ fhir:value "StructureDefinition:resource" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.reference [
         fhir:link <https://gematik.de/fhir/isik/StructureDefinition/ISiKGCS> ;
         fhir:Reference.reference [ fhir:value "StructureDefinition/ISiKGCS" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "ISiKGCS" ] ;
       fhir:ImplementationGuide.definition.resource.description [ fhir:value "Dieses Profil spezifiziert die Minimalanforderungen für die Bereitstellung von Informationen über den Glasgow Coma Scale (GCS) Score eines Patienten im Rahmen der interoperablen Kommunikation gemäß den Vorgaben der ISiK.\n\n**Motivation**\n\nDie Erfassung und Überwachung des Bewusstseinszustands anhand des GCS ist essenziell für die Beurteilung neurologischer Funktionen, die Überwachung von Patienten mit Schädel-Hirn-Trauma oder anderen neurologischen Erkrankungen sowie die Unterstützung klinischer Entscheidungen.\n\nIn FHIR wird der GCS-Score mit der Observation-Ressource repräsentiert, wobei die einzelnen Komponenten der Skala - Augenöffnung, verbale Reaktion und motorische Reaktion - als Component-Elemente abgebildet werden.\n\n**Kompatibilität**\n\nDas Profil ISiKGCS ist vom Profil [ScoreDE_GCS](http://fhir.de/StructureDefinition/observation-de-score-gcs) aus den deutschen Basisprofilen abgeleitet." ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
