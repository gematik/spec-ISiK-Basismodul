         fhir:Reference.reference [ fhir:value "Observation/ISiKKopfumfangExample" ]
       ] ;
       fhir:ImplementationGuide.definition.resource.name [ fhir:value "ISiKKopfumfangExample" ] ;
       fhir:ImplementationGuide.definition.resource.exampleBoolean [ fhir:value "false"^^xsd:boolean ]
     ], [
