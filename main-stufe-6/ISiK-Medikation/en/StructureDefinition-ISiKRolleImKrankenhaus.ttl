       fhir:ElementDefinition.short [ fhir:value "Organisation" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Motivation MS: Ein System muss die Informationen über die Organisation, der der Leistungserbringer angehört, bereitstellen können." ] ;
