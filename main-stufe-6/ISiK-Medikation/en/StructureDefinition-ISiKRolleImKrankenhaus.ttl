       fhir:ElementDefinition.short [ fhir:value "Leistungserbringer" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Motivation MS: Ein System muss die Informationen über den Leistungserbringer, der die Rolle innehat, bereitstellen können." ] ;
