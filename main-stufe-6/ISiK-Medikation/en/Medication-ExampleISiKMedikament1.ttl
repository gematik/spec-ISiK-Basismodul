  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "ExampleISiKMedikament1"] ;
  fhir:Resource.meta [
     fhir:Meta.profile [
       fhir:value "https://gematik.de/fhir/isik/StructureDefinition/ISiKMedikament" ;
