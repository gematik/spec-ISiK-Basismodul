       fhir:Element.id [ fhir:value "List.status" ] ;
       fhir:ElementDefinition.path [ fhir:value "List.status" ] ;
       fhir:ElementDefinition.short [ fhir:value "(Aktualitäts-)Status der Liste" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung des Must-Support: Erforderliche Angabe im FHIR-Standard" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 6 ;
       fhir:Element.id [ fhir:value "List.mode" ] ;
       fhir:ElementDefinition.path [ fhir:value "List.mode" ] ;
       fhir:ElementDefinition.short [ fhir:value "Listenmodus zur fachlichen Einordnung des Charakters der Medikationsliste." ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung des Must-Support: Erforderliche Angabe im FHIR-Standard\n  Die `ISiKMedikationsListe` stellt eine fachliche Zusammenführung von Medikationsinformationen dar. Die Wahl von `List.mode` hängt davon ab, ob ein definierter Zustand dokumentiert oder eine fortschreibbare Liste geführt wird.\n  Beispiel: eingelesene Medikationspläne werden als snapshot repräsentiert. Kontinuierlich fortgeschriebene Listen, z.B. im Rahmen der hausinternen Behandlung, sind als 'working' codiert." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "https://gematik.de/fhir/isik/ValueSet/MedikationsListeListModeVS" ;
           fhir:link <https://gematik.de/fhir/isik/ValueSet/MedikationsListeListModeVS>
         ]
       ]
     ], [
       fhir:index 7 ;
       fhir:Element.id [ fhir:value "List.code" ] ;
       fhir:ElementDefinition.path [ fhir:value "List.code" ] ;
       fhir:ElementDefinition.short [ fhir:value "Art der Liste." ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung des Must-Support: Dient der Differenzierung zu anderen Listen.\n\n  Hinweis: Es ist mindestens ein Coding mit dem Code 'medications' anzugeben. Weitere Codes, z.B. im Kontext anderer Spezifikationen oder Hauscodierungen sind zulässig." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
