         ]
       ], [
         fhir:index 6 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "lst-2" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "The deleted flag can only be used if the mode of the list is \"changes\"" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "mode = 'changes' or entry.deleted.empty()" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "(f:mode/@value = 'changes') or not(exists(f:entry/f:deleted))" ] ;
         fhir:ElementDefinition.constraint.source [
