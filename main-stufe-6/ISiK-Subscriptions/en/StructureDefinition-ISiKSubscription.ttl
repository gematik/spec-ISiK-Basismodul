       fhir:Element.id [ fhir:value "Subscription.channel.type" ] ;
       fhir:ElementDefinition.path [ fhir:value "Subscription.channel.type" ] ;
       fhir:ElementDefinition.short [ fhir:value "Typ des Kommunikationskanals" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Bedeutung:** Der Typ des Kommunikationskanals, über den Subscription-Benachrichtigungen gesendet werden sollen.  \n    In ISiK MUSS der Wert `rest-hook` unterstützt werden, weitere Werte KÖNNEN unterstützt werden." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
