       fhir:ElementDefinition.short [ fhir:value "Filterkriterium." ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Bedeutung:** Filterkriterium für die Subscription. Dieses Feld ist optional und kann genutzt werden, um die Subscription auf bestimmte Events zu filtern." ]
