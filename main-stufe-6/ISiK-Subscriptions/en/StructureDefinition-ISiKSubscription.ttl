       fhir:ElementDefinition.short [ fhir:value "Custom Channel Type" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Bedeutung:** Custom Channel Type welcher in ISiK aktuell nicht unterstützt wird." ] ;
       fhir:ElementDefinition.max [ fhir:value "0" ]
