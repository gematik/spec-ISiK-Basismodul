       fhir:ElementDefinition.short [ fhir:value "Heartbeat-Intervall" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Bedeutung:** Intervall in dem der Server prüft, ob der Kommunikationskanal noch aktiv ist." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
