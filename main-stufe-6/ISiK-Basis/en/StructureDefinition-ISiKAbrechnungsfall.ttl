       fhir:ElementDefinition.comment [ fhir:value "Über die mit MS gekennzeichneten Slices hinaus können weitere Identifier vorkommen, ohne, dass eine ISiK Inkompatibilität besteht. Verarbeitet werden müssen aber nur die folgenden Slices." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Account.identifier:Abrechnungsnummer" ] ;
       fhir:ElementDefinition.path [ fhir:value "Account.identifier" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "Abrechnungsnummer" ] ;
       fhir:ElementDefinition.short [ fhir:value "Abrechnungsfallnummer" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Im DRG-Kontext werden häufig sämtliche Besuche (`Encounter`), die unter einen gemeinsamen Abrechnungskontext zusammengefasst werden, \n  unter einer 'Fallnummer' geführt. In dieser Konstellation sind die Begriffe 'Fallnummer' und 'Abrechnungsfallnummer' gleichbedeutend.  \n  Dies ist insbesondere im Kontext des Mappings zwischen HL7 V2 und HL7 FHIR zu beachten, da es in V2 Usus ist, \n  die Fallnummer (eigentlich Identifier des Abrechnungsfalles) im `PV1`-Segment (Patient Visit) zu übermitteln. \n  Es handelt sich dabei jedoch *nicht* um den Identifier des Besuchs (`Encounter`) sondern den des Abrechnungsfalles (`Account`), \n  da der Identifier oft für die Gruppierung mehrerer Besuche (z.B. vorstationär + stationär + nachstationär) mit gemeinsamem (DRG)-Kontext verwendet wird.  \n  Die Abrechnungsfallnummer in `Account.identifier` muss identisch sein mit dem Identifier, \n  der bei den Encountern, die unter diesem Account gruppiert werden, unter `Encounter.account.identifier` angegeben ist." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "Identifier" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "http://fhir.de/StructureDefinition/identifier-abrechnungsnummer" ;
           fhir:index -1 ;
           fhir:link <http://fhir.de/StructureDefinition/identifier-abrechnungsnummer>
         ]
       ] ;
       fhir:ElementDefinition.patternIdentifier [
         fhir:Identifier.type [
           fhir:CodeableConcept.coding [
             fhir:index -1 ;
             fhir:Coding.system [ fhir:value "http://terminology.hl7.org/CodeSystem/v2-0203" ] ;
             fhir:Coding.code [ fhir:value "AN" ]
           ]
         ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Account.identifier:Abrechnungsnummer.type" ] ;
       fhir:ElementDefinition.path [ fhir:value "Account.identifier.type" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Account.identifier:Abrechnungsnummer.type.coding" ] ;
       fhir:ElementDefinition.path [ fhir:value "Account.identifier.type.coding" ] ;
       fhir:ElementDefinition.short [ fhir:value "Codierte Darstellung des Identifier-Typs" ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Account.identifier:Abrechnungsnummer.type.coding.system" ] ;
       fhir:ElementDefinition.path [ fhir:value "Account.identifier.type.coding.system" ] ;
       fhir:ElementDefinition.short [ fhir:value "Codier-Schema" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hier ist stets der Wert `http://terminology.hl7.org/CodeSystem/v2-0203` anzugeben." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Account.identifier:Abrechnungsnummer.type.coding.code" ] ;
       fhir:ElementDefinition.path [ fhir:value "Account.identifier.type.coding.code" ] ;
       fhir:ElementDefinition.short [ fhir:value "Code" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hier ist stets der Wert `AN` anzugeben." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Account.identifier:Abrechnungsnummer.system" ] ;
       fhir:ElementDefinition.path [ fhir:value "Account.identifier.system" ] ;
       fhir:ElementDefinition.short [ fhir:value "Namensraum des Identifiers" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hier ist stets der eindeutige Name (URL) des Namensraums anzugeben, \n    aus dem der Identifier stammt. \n    Hinweise zur Festlegung der URLs für lokale Namensräume sind in den \n    [Deutschen Basisprofilen](https://simplifier.net/guide/leitfaden-de-basis-r4/ig-markdown-Terminologie-Namensraeume?version=current) beschrieben.  \n    **Begründung Pflichtfeld:** `system` stellt in Kombination mit `value` die Eindeutigkeit eines Identifiers sicher." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Account.identifier:Abrechnungsnummer.value" ] ;
       fhir:ElementDefinition.path [ fhir:value "Account.identifier.value" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Enthält den eigentlichen Wert des Identifiers.  \n    **Begründung Pflichtfeld:** Ist der Wert nicht bekannt, sollte der gesamte Slice weggelassen werden." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Account.status" ] ;
       fhir:ElementDefinition.path [ fhir:value "Account.status" ] ;
       fhir:ElementDefinition.short [ fhir:value "Status" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Zeigt den aktuellen Status der Ressource an.     \n  **WICHTIGER Hinweis für Implementierer:**    \n  * Alle server-seitigen Implementierungen MÜSSEN in der Lage sein, \n  die systemintern möglichen Statuswerte korrekt in FHIR abzubilden, mindestens jedoch `active` und `inactive`.\n  * Alle client-seitigen Implementierungen MÜSSEN in der Lage sein, sämtliche Status-Codes zu interpretieren und dem Anwender in angemessener Form darstellen zu können, \n  beispielsweise durch Ausblenden/Durchstreichen von Ressourcen mit dem status `entered-in-error` und Ausgrauen von Ressourcen, die einen Plan- oder Entwurfs-Status haben." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Account.subject" ] ;
       fhir:ElementDefinition.path [ fhir:value "Account.subject" ] ;
       fhir:ElementDefinition.short [ fhir:value "Patientenbezug" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung Pflichtfeld:** Ein Patientenbezug des Falls muss stets zum Zwecke der Nachvollziehbarkeit und Datenintegrität vorliegen." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "Reference" ] ;
         fhir:ElementDefinition.type.targetProfile [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Patient" ;
           fhir:index -1 ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Patient>
         ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Account.subject.reference" ] ;
       fhir:ElementDefinition.path [ fhir:value "Account.subject.reference" ] ;
       fhir:ElementDefinition.short [ fhir:value "Patienten-Link" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung Pflichtfeld:** Die Verlinkung auf eine Patienten-Ressource dient der technischen Zuordnung der Dokumentation zu einem Patienten und ermöglicht wichtige API-Funktionen wie verkettete Suche, (Reverse-)Include etc.\nIm ISik Kontext MUSS die referenzierte Ressource konform zu [ISiKPatient](https://gematik.de/fhir/isik/StructureDefinition/ISiKPatient) sein.\nJenseits von ISiK KÖNNEN weitere Instanzen mit anderen Profilen referenziert werden." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Account.coverage" ] ;
       fhir:ElementDefinition.path [ fhir:value "Account.coverage" ] ;
       fhir:ElementDefinition.short [ fhir:value "Versicherungs-/Zahlungsverhältnis" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Auflistung aller Versicherungs- und oder (Selbst-/Fremd-)zahlerverhältnisse, die zur Abrechnung der in diesem Kontext erbrachten Leistungen herangezogen werden können." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Account.coverage.extension" ] ;
       fhir:ElementDefinition.path [ fhir:value "Account.coverage.extension" ] ;
       fhir:ElementDefinition.slicing [
         fhir:ElementDefinition.slicing.discriminator [
           fhir:index -1 ;
           fhir:ElementDefinition.slicing.discriminator.type [ fhir:value "value" ] ;
           fhir:ElementDefinition.slicing.discriminator.path [ fhir:value "url" ]
         ] ;
         fhir:ElementDefinition.slicing.ordered [ fhir:value "false"^^xsd:boolean ] ;
         fhir:ElementDefinition.slicing.rules [ fhir:value "open" ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Account.coverage.extension:Abrechnungsart" ] ;
       fhir:ElementDefinition.path [ fhir:value "Account.coverage.extension" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "Abrechnungsart" ] ;
       fhir:ElementDefinition.short [ fhir:value "Abrechnungsart" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Art der Abrechnung, für die das Versicherungsverhältnis herangezogen wird. Die Abrechnungsart bezieht sich auf die Hauptversicherung über die der Fall abgerechnet wird. Bei initialen Fallanlage kann es vorkommen, dass die Abrechnungsart noch nicht bekannt ist (z.B. Unklare Versicherungszugehörigkeit, Rückfragen an den Kostenträger, Ungeklärte Zusatzleistungen). Sobald bekannt, SOLL angegeben werden, in welcher Abrechnungsart die Abrechnung erfolgt." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "Extension" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "http://fhir.de/StructureDefinition/ExtensionAbrechnungsart" ;
           fhir:index -1 ;
           fhir:link <http://fhir.de/StructureDefinition/ExtensionAbrechnungsart>
         ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Account.coverage.coverage" ] ;
       fhir:ElementDefinition.path [ fhir:value "Account.coverage.coverage" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Account.coverage.coverage.reference" ] ;
       fhir:ElementDefinition.path [ fhir:value "Account.coverage.coverage.reference" ] ;
       fhir:ElementDefinition.short [ fhir:value "Coverage-Link" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung Pflichtfeld:** Die Verlinkung auf eine Coverage-Ressource dient der technischen Zuordnung zwischen Abrechnungsfall und Versicherungsverhältnis\n    und ermöglicht wichtige API-Funktionen wie verkettete Suche, (Reverse-)Include etc." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Account.coverage.priority" ] ;
       fhir:ElementDefinition.path [ fhir:value "Account.coverage.priority" ] ;
       fhir:ElementDefinition.short [ fhir:value "Priorität" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung des MS:** Wenn ein Primärsystem mehrere Kostenträger angibt, \n    sollte für lesende Systeme ersichtlich sein, welches der Hauptkostenträger ist. Hierbei ist die Priorisierung aufsteigend zu interpretieren. Demnach hat der Kostenträger mit der priority 1 die höchste Priorität, der mit priority 2 die zweithöchste Priorität etc.      \n    **Historie:**  \n    Diskussionstand der ISIK-Arbeitsgruppe vom 28.5.: Die Abbildung über einen Integer ist wünschenswert. \n    Eine binäre Einteilung in Hauptkostenträger (1) und alle anderen (2) wird der Komplexität der Priorisierung zur Kostenträgerschaft nicht gerecht. \n    Eine Ausdifferenzierung ist wünschenswert und sollte angestrebt werden." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ]
  ] .

# - ontology header ------------------------------------------------------------

<https://gematik.de/fhir/isik/StructureDefinition/ISiKAbrechnungsfall.ttl> a owl:Ontology ;
  owl:imports fhir:fhir.ttl .

