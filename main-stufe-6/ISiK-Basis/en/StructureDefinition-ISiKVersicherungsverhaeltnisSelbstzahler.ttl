       fhir:ElementDefinition.comment [ fhir:value "Periodically the member number is constructed from the subscriberId and the dependant number." ] ;
       fhir:ElementDefinition.requirements [ fhir:value "For some coverages a single identifier is issued to the Subscriber and then a unique dependent number is issued to each beneficiary." ] ;
