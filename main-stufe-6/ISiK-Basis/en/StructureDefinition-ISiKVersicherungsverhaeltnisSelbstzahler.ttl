       fhir:ElementDefinition.short [ fhir:value "Codierte Darstellung der Versicherungsart" ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Coverage.type.coding:VersicherungsArtDeBasis.system" ] ;
