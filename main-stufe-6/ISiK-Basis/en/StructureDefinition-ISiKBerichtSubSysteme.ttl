       fhir:ElementDefinition.path [ fhir:value "Composition.text.div" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Composition.identifier" ] ;
       fhir:ElementDefinition.path [ fhir:value "Composition.identifier" ] ;
       fhir:ElementDefinition.short [ fhir:value "Eindeutige Dokumenten-ID" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Eine vom erzeugenden Subsystem vergebene, eindeutige DokumentenID.  \n  Wenn es sich bei dem verwendeten Identifier um eine OID oder UUID handelt, so ist hier der Wert `urn:ietf:rfc:3986` anzugeben und in `Identifier.value` das jeweilige Präfix `urn:uuid:` bzw. `urn:oid:` zu verwenden.  \n  Beispiel:\n```xml  \n<identifier> \n    <system value=\"urn:ietf:rfc:3986\">  \n    <value value=\"urn:oid:2.16.840.1.113883.6.96\"> \n</identifier>\n```" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Composition.identifier.system" ] ;
       fhir:ElementDefinition.path [ fhir:value "Composition.identifier.system" ] ;
       fhir:ElementDefinition.short [ fhir:value "Namensraum des Identifiers" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hier ist stets der eindeutige Name (URL) des Namensraums anzugeben, \n    aus dem der Identifier stammt. \n    Hinweise zur Festlegung der URLs für lokale Namensräume sind in den \n    [Deutschen Basisprofilen](https://simplifier.net/guide/leitfaden-de-basis-r4/ig-markdown-Terminologie-Namensraeume?version=current) beschrieben.  \n    **Begründung Pflichtfeld:** `system` stellt in Kombination mit `value` die Eindeutigkeit eines Identifiers sicher." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Composition.identifier.value" ] ;
       fhir:ElementDefinition.path [ fhir:value "Composition.identifier.value" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Enthält den eigentlichen Wert des Identifiers.  \n    **Begründung Pflichtfeld:** Ist der Wert nicht bekannt, sollte der gesamte Slice weggelassen werden." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Composition.status" ] ;
       fhir:ElementDefinition.path [ fhir:value "Composition.status" ] ;
       fhir:ElementDefinition.short [ fhir:value "Status des Dokumentes" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Im Kontext diese Moduls ist nur der Austausch finaler Berichte vorgesehen. \n  Ein Mechanismus zur Änderung oder Ersetzung bereits übermittelter Daten ist derzeit nicht spezifiziert. \n  Hier ist stets der Wert `final` anzugeben." ] ;
