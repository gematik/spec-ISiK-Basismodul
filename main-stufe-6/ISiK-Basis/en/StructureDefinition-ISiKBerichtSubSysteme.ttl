       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Composition.subject" ] ;
       fhir:ElementDefinition.path [ fhir:value "Composition.subject" ] ;
       fhir:ElementDefinition.short [ fhir:value "Patientenbezug" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung Must-Support:** Ein Patientenbezug des Dokument MUSS stets zum Zwecke der Nachvollziehbarkeit und Datenintegrität vorliegen." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Composition.subject.reference" ] ;
       fhir:ElementDefinition.path [ fhir:value "Composition.subject.reference" ] ;
       fhir:ElementDefinition.short [ fhir:value "Patienten-Link" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung Pflichtfeld:** Die Verlinkung auf eine Patienten-Ressource dient der technischen Zuordnung der Dokumentation zu einem Patienten und ermöglicht wichtige API-Funktionen wie verkettete Suche, (Reverse-)Include etc.\nIm ISik Kontext MUSS die referenzierte Ressource konform zu [ISiKPatient](https://gematik.de/fhir/isik/StructureDefinition/ISiKPatient) sein.\nJenseits von ISiK KÖNNEN weitere Instanzen mit anderen Profilen referenziert werden." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Composition.encounter" ] ;
       fhir:ElementDefinition.path [ fhir:value "Composition.encounter" ] ;
       fhir:ElementDefinition.short [ fhir:value "Aufenthaltsbezug" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung Must-Support:** Ein Aufenthaltsbezug des Dokument MUSS stets zum Zwecke der Nachvollziehbarkeit und Datenintegrität vorliegen." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Composition.encounter.reference" ] ;
       fhir:ElementDefinition.path [ fhir:value "Composition.encounter.reference" ] ;
       fhir:ElementDefinition.short [ fhir:value "Encounter-Link" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung Pflichtfeld:** Die Verlinkung auf eine Encounter-Ressource dient der technischen Zuordnung der Dokumentation zu einem Aufenthalt und ermöglicht wichtige API-Funktionen wie verkettete Suche, (Reverse-)Include etc.\n**WICHTIGER Hinweis für Implementierer:** Die Zuordnung MUSS auf einen Encounter der Ebene \"Abteilungskontakt\" (siehe hierzu Basismodul > UseCases > Abbildung des Konstruktes \"Fall\") erfolgen.  \nBei der Auswahl des Encounters ist zu beachten, dass unter einer (Abrechnungs-)\"Fallnummer\" (hier: `Encounter.account`) unter Umständen mehrere Encounter gruppiert sein können (z.B. stationärer Besuch mit mehreren vor- und nachstationären Aufenthalten.)\nIm ISik Kontext MUSS die referenzierte Ressource konform zu [ISiKKontaktGesundheitseinrichtung](https://gematik.de/fhir/isik/StructureDefinition/ISiKKontaktGesundheitseinrichtung) sein.\nJenseits von ISiK KÖNNEN weitere Instanzen mit anderen Profilen referenziert werden." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Composition.date" ] ;
       fhir:ElementDefinition.path [ fhir:value "Composition.date" ] ;
       fhir:ElementDefinition.short [ fhir:value "Dokumentendatum" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Datum der letzten Änderung des Dokumentes" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Composition.author" ] ;
       fhir:ElementDefinition.path [ fhir:value "Composition.author" ] ;
       fhir:ElementDefinition.short [ fhir:value "Verfasser/Ersteller des Dokumentes (Person oder Subsystem/Gerät)" ] ;
       fhir:ElementDefinition.comment [ fhir:value "In der aktuellen Ausbaustufe von ISiK ist die Verwendung der textuellen Repräsentation (display) \n  von Autor und Subsystem ausreichend. \n  Die darüber hinausgehende Verlinkung auf Practitioner bzw. Device-Ressourcen \n  KANN implementiert werden." ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "Reference" ] ;
         fhir:ElementDefinition.type.targetProfile [
           fhir:value "http://hl7.org/fhir/StructureDefinition/PractitionerRole" ;
           fhir:index -1 ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/PractitionerRole>
         ], [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Device" ;
           fhir:index -1 ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Device>
         ], [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Organization" ;
           fhir:index -1 ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Organization>
         ], [
           fhir:value "http://hl7.org/fhir/StructureDefinition/RelatedPerson" ;
           fhir:index -1 ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/RelatedPerson>
         ], [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Patient" ;
           fhir:index -1 ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Patient>
         ], [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Practitioner" ;
           fhir:index -1 ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Practitioner>
         ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Composition.author.display" ] ;
       fhir:ElementDefinition.path [ fhir:value "Composition.author.display" ] ;
       fhir:ElementDefinition.short [ fhir:value "Bezeichnung des Verfassers (Freitext)" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Freitextliche Bezeichnung des Verfassers (Person oder Subsystem/Gerät)" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Composition.title" ] ;
       fhir:ElementDefinition.path [ fhir:value "Composition.title" ] ;
       fhir:ElementDefinition.short [ fhir:value "Dokumentenbezeichnung" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Die Dokumentenbezeichnung dient der Darstellung des Dokumentes in einer Übersicht, \n  z.B. in einer Patientenakte, und KANN der schnellen Auffindbarkeit \n  eines gesuchten Dokumentes dienen. \n  Geeignete Bezeichnungen sind zum Beispiel:  \n* 'Kleines Blutbild vom 13.10.2020'\n* 'Pathologiebefund (Abstrich) vom 13.10.2020'\n* 'Blutgasmessung vom 13.10.2020 14:14h'" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Composition.section" ] ;
       fhir:ElementDefinition.path [ fhir:value "Composition.section" ] ;
       fhir:ElementDefinition.short [ fhir:value "Kapitel" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Das Dokument kann in mehrere Kapitel und Unterkapitel gegliedert werden." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Composition.section.title" ] ;
       fhir:ElementDefinition.path [ fhir:value "Composition.section.title" ] ;
       fhir:ElementDefinition.short [ fhir:value "Kapitelbezeichnung" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Composition.section.text" ] ;
       fhir:ElementDefinition.path [ fhir:value "Composition.section.text" ] ;
       fhir:ElementDefinition.short [ fhir:value "Narrativ" ] ;
       fhir:ElementDefinition.comment [ fhir:value "menschenlesbare HTML-Repräsentation des Inhalts dieses Kapitels.  \n    Hinweise: Für Aggregation einer vollständigen menschenlesbaren Repräsentation \n    MÜSSEN die Repräsentationen der einzelnen Kapitel an die Repräsentation \n    der Metadaten (Composition.text) angehängt werden. \n    Für die Separierung KÖNNEN einfache <div>-Tags verwendet werden. \n    Es ist zu beachten, dass Kapitel auch Unterkapitel enthalten KÖNNEN \n    (Composition.section.section), die bei der Aggregation entsprechend \n    berücksichtigt werden MÜSSEN.  \nDie Mindestanforderungen an den Inhalt der menschenlesbaren Repräsentation umfasst folgende Informationen:\n* `section.title` + Freitext oder\n* `section.title` + `Resource.text` der referenzierten Ressource oder\n* `section.title` + eine aggregierte Repräsentation von `Resource.text`,\n    wenn in einer Section mehrere Ressourcen referenziert werden \n    (z.B. eine tabellarische Auflistung mehrere Blutdruckmesswerte, Diagnosen oder Allergien)." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Composition.section.section" ] ;
       fhir:ElementDefinition.path [ fhir:value "Composition.section.section" ] ;
       fhir:ElementDefinition.short [ fhir:value "Unterkapitel" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ]
  ] .

