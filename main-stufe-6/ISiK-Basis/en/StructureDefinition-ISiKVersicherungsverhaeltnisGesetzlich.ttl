       fhir:ElementDefinition.short [ fhir:value "Codier-Schema" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hier ist stets der Wert `http://fhir.de/CodeSystem/versicherungsart-de-basis` anzugeben." ] ;
