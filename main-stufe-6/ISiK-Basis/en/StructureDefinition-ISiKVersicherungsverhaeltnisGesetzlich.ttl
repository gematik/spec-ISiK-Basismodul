       fhir:ElementDefinition.path [ fhir:value "Coverage.type.coding" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "VersicherungsArtDeBasis" ] ;
       fhir:ElementDefinition.short [ fhir:value "Codierte Darstellung der Versicherungsart" ] ;
