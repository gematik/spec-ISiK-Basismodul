       fhir:ElementDefinition.path [ fhir:value "Coverage.type.coding.code" ] ;
       fhir:ElementDefinition.short [ fhir:value "Code" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hier ist stets der Code `GKV` anzugeben." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Coverage.subscriber" ] ;
       fhir:ElementDefinition.path [ fhir:value "Coverage.subscriber" ] ;
       fhir:ElementDefinition.short [ fhir:value "Hauptversicherte Person" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Die hauptversicherte Person kann der Patient selbst sein, oder (z.B. im Falle einer Familienversicherung) auch ein Angehöriger (`RelatedPerson`)\n  **Begründung MS: Die Information über die hauptversicherte Person ist insbesondere im Kontext der Korrespondenz von Bedeutung, \n  da z.B. bei familienversicherten Kindern i.d.R. über die hauptversicherte Person korrespondiert wird.  \n\n  **Hinweis:** Die Angabe der VersichertenID des Hauptversicherten in `subscriber.identifier` ist verpflichtend. \n  Weitere Angaben zum Versicherten (Name, Adresse) können in einer `RelatedPerson`-Resource hinterlegt werden, auf die hier referenziert wird." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Coverage.subscriber.reference" ] ;
       fhir:ElementDefinition.path [ fhir:value "Coverage.subscriber.reference" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Die Verlinkung auf eine Patienten- oder RelatedPerson-Ressource dient der technischen Zuordnung der Dokumentation zu einem Patienten/Angehörigen \n    und ermöglicht wichtige API-Funktionen wie verkettete Suche, (Reverse-)Include etc." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Coverage.subscriber.identifier" ] ;
       fhir:ElementDefinition.path [ fhir:value "Coverage.subscriber.identifier" ] ;
       fhir:ElementDefinition.short [ fhir:value "Lebenslange Krankenversichertennummer der Hauptversicherten" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Die als 'KVZ10' kodierte Versichertennummer ist der 10-stellige, \n      unveränderbare Teil der Versichertennummer, \n      der lesbar auf die Elektronische Gesundheitskarte aufgedruckt ist.\n      Er gilt für alle Krankenversichertennummern, \n      unabhängig davon, ob es sich um GKV, PKV oder Sonderkostenträger handelt.  \n      **Weitere Hinweise:** siehe [Deutschen Basisprofile](https://simplifier.net/guide/leitfaden-de-basis-r4/ig-markdown-LebenslangeKrankenversichertennummer10-stelligeKVID-Identifier?version=current)" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "Identifier" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "http://fhir.de/StructureDefinition/identifier-kvid-10" ;
           fhir:index -1 ;
           fhir:link <http://fhir.de/StructureDefinition/identifier-kvid-10>
         ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Coverage.subscriber.identifier.system" ] ;
       fhir:ElementDefinition.path [ fhir:value "Coverage.subscriber.identifier.system" ] ;
       fhir:ElementDefinition.short [ fhir:value "Namensraum der Versichertennummer" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hier ist stets der Wert `http://fhir.de/sid/gkv/kvid-10` anzugeben.  \n      **Begründung Pflichtfeld:** `system` stellt in Kombination mit `value` die Eindeutigkeit eines Identifiers sicher." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Coverage.subscriber.identifier.value" ] ;
       fhir:ElementDefinition.path [ fhir:value "Coverage.subscriber.identifier.value" ] ;
       fhir:ElementDefinition.short [ fhir:value "Lebenslange Krankenversichertennummer" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Der 10-stellige, unveränderbare Teil der Versichertennummer." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Coverage.subscriber.display" ] ;
       fhir:ElementDefinition.path [ fhir:value "Coverage.subscriber.display" ] ;
       fhir:ElementDefinition.short [ fhir:value "Name des Hauptversicherten" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung MS:** Da das die Versichertennummer nicht zur Darstellung für den Anwender geeignet ist, \n    sollte ergänzend der Name des Versicherten angegeben werden." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Coverage.beneficiary" ] ;
       fhir:ElementDefinition.path [ fhir:value "Coverage.beneficiary" ] ;
       fhir:ElementDefinition.short [ fhir:value "Versicherte Person" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hier handelt es ich konkret um den Patienten, der unter diesem Versicherungsverhältnis behandelt wird." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Coverage.beneficiary.reference" ] ;
       fhir:ElementDefinition.path [ fhir:value "Coverage.beneficiary.reference" ] ;
       fhir:ElementDefinition.short [ fhir:value "Patienten-Link" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Die Verlinkung auf eine Patienten-Ressource dient der technischen Zuordnung der Dokumentation zu einem Patienten \n    und ermöglicht wichtige API-Funktionen wie verkettete Suche, (Reverse-)Include etc." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Coverage.payor" ] ;
       fhir:ElementDefinition.path [ fhir:value "Coverage.payor" ] ;
       fhir:ElementDefinition.short [ fhir:value "Kostenträger (Haupt- sowie ggf. abrechnender Kostenträger)" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Die Angabe der IK-Nummer in `payor.identifier` sowie des Namens der Versicherung in `payor.display` ist zwingend erforderlich.  \n  Die Referenz auf eine Resource vom Typ `Organization` in `payor.reference`, die weitere Details zur Versicherung enthalten kann (z.B. Adresse, Kontaktdaten) ist optional.  \n\n  Die Angabe der IK-Nummer des Versicherers in payor.identifier ist verpflichtend. \n  Weitere Angaben zum Versicherer (Name, Adresse) können in einer Organization-Resource hinterlegt werden, auf die hier referenziert wird.  \n**Historie:** Erhöhung der Kardinalität von `payor` auf ..2 zur Harmonisierung mit dem GKV-Coverage-Profil der TI-Anwendung `VSDM 2.0`. Dort *kann* als zweiter payor ein *abrechnender Kostenträger* übermittelt werden.\nDieser soll nicht aus einer Coverage-Instanz entfernt werden müssen, um ISIK-Konformität herzustellen. Die Unterstützung von abrechnenden Kostenträgern ist jedoch in ISiK NICHT gefordert.\n" ] ;
       fhir:ElementDefinition.max [ fhir:value "2" ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "Reference" ] ;
         fhir:ElementDefinition.type.targetProfile [
           fhir:value "http://hl7.org/fhir/StructureDefinition/Organization" ;
           fhir:index -1 ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/Organization>
         ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Coverage.payor.identifier" ] ;
       fhir:ElementDefinition.path [ fhir:value "Coverage.payor.identifier" ] ;
       fhir:ElementDefinition.short [ fhir:value "Institutskennzeichern der Versicherung" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung Pflichtfeld:** Als eindeutiger Identifikator der Versicherung ist in vielen Fällen das Institutskennzeichen ausreichend." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "Identifier" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "http://fhir.de/StructureDefinition/identifier-iknr" ;
           fhir:index -1 ;
           fhir:link <http://fhir.de/StructureDefinition/identifier-iknr>
         ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Coverage.payor.identifier.system" ] ;
       fhir:ElementDefinition.path [ fhir:value "Coverage.payor.identifier.system" ] ;
       fhir:ElementDefinition.short [ fhir:value "Namensraum der IK-Nummer" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Hier ist stets der Wert `http://fhir.de/sid/arge-ik/iknr` anzugeben.  \n      **Begründung Pflichtfeld:** `system` stellt in Kombination mit `value` die Eindeutigkeit eines Identifiers sicher." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Coverage.payor.identifier.value" ] ;
       fhir:ElementDefinition.path [ fhir:value "Coverage.payor.identifier.value" ] ;
       fhir:ElementDefinition.short [ fhir:value "IK-Nummer" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Das Institutskennzeichen der Versicherung" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Coverage.payor.display" ] ;
       fhir:ElementDefinition.path [ fhir:value "Coverage.payor.display" ] ;
       fhir:ElementDefinition.short [ fhir:value "Name der Versicherung" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung Pflichtfeld:** Da das Institutskennzeichen nicht zur Darstellung für den Anwender geeignet ist, \n    muss ergänzend der Name der Versicherung angegeben werden." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ]
  ] .

