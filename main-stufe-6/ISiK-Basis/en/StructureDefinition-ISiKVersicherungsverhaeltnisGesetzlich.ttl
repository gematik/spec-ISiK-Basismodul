       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.patternCoding [
         fhir:Coding.system [ fhir:value "http://fhir.de/CodeSystem/versicherungsart-de-basis" ] ;
         fhir:Coding.code [ fhir:value "GKV" ]
