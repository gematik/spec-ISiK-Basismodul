       fhir:ElementDefinition.short [ fhir:value "Aufenthaltsbezug" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung Must-Support:** Ein Aufenthaltsbezug der Diagnose MUSS zum Zwecke der Nachvollziehbarkeit und Datenintegrität exponiert und empfangen werden können." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
