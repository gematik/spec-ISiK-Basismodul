       fhir:ElementDefinition.comment [ fhir:value "Alle von einem Server bereitgestellten Ressourcen SOLLEN über eine `versionID` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `versionID`verfügen. " ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Condition.meta.lastUpdated" ] ;
       fhir:ElementDefinition.path [ fhir:value "Condition.meta.lastUpdated" ] ;
       fhir:ElementDefinition.short [ fhir:value "Zeitpunkt der letzten Änderung" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Alle von einem Server bereitgestellten Ressourcen SOLLEN über ein `lastUpdate` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über ein `lastUpdate`verfügen. " ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Condition.implicitRules" ] ;
       fhir:ElementDefinition.path [ fhir:value "Condition.implicitRules" ] ;
       fhir:ElementDefinition.short [ fhir:value "Verweis auf die Regeln, nach denen die Ressource erstellt wurde" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung Constraint: In ISiK existiert kein Use-Case für dieses Element. Da es sich um ein Modifying Element handelt, wird es daher ausgeschlossen.\n  Darüber hinaus werden die Regeln als URI vorgehalten. Dies führt dazu, dass sich hinter der URI eine beliebige Menge an Regeln befinden kann; wodurch  nicht sichergestellt werden kann, dass alle Clients die Regeln korrekt interpretieren können." ] ;
       fhir:ElementDefinition.max [ fhir:value "0" ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Condition.extension" ] ;
       fhir:ElementDefinition.path [ fhir:value "Condition.extension" ] ;
       fhir:ElementDefinition.slicing [
         fhir:ElementDefinition.slicing.discriminator [
           fhir:index -1 ;
           fhir:ElementDefinition.slicing.discriminator.type [ fhir:value "value" ] ;
           fhir:ElementDefinition.slicing.discriminator.path [ fhir:value "url" ]
         ] ;
         fhir:ElementDefinition.slicing.rules [ fhir:value "open" ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Condition.extension:related" ] ;
       fhir:ElementDefinition.path [ fhir:value "Condition.extension" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "related" ] ;
       fhir:ElementDefinition.short [ fhir:value "Verknüpfte Diagnose" ] ;
       fhir:ElementDefinition.comment [ fhir:value " Die Deutschen Kodierrichtlinien und die 'German Modification' ermöglichen es teilweise, \n  ICD-10-Codierte Diagnosen miteinander zu verknüpfen ('Kreuz-Stern-Ausrufezeichen-Notation'), \n  diese aber dennoch wie eigenständige Diagnosen (mit jeweils eigener Diagnosesicherheit oder -Lokalisation) zu kommunizieren.\n  Daher ist es in Deutschland nicht möglich, dem internationalen Usus zu folgen und verknüpfte Diagnosen als postkoordinierten Code *einer* Condition-Ressource aufzufassen.\n  Statt dessen müssen sie zwei eigenständige Condition-Ressourcen abgebildet werden, die mit Hilfe der `related`-Extension miteinander verknüpft werden.  \n  Die Sekundärdiagnose verweist jeweils auf die Primärdiagnose." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "Extension" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "http://hl7.org/fhir/StructureDefinition/condition-related" ;
           fhir:index -1 ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/condition-related>
         ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Condition.clinicalStatus" ] ;
       fhir:ElementDefinition.path [ fhir:value "Condition.clinicalStatus" ] ;
       fhir:ElementDefinition.short [ fhir:value "klinischer Status" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung MS:** Auch in Stufe 4 sind keine (client-seitigen) schreibenden Operationen für das Erstellen einer Condition-Ressource vorgesehen \n  (siehe CapabilityStatement). Das heißt, entweder führen KISe entsprechende Informationen und exponieren diese, \n  oder es gibt keinen pragmatischen Mechanismus (im ISIK-Kontext), um den Use Case einer zusätzlichen Annotation mittels Client zu erfüllen. \n  Da alle KIS-Hersteller, die sich zu Wort gemeldet haben, eine Befüllung von Condition.clinicalStatus NICHT unterstützen, \n  erscheint das MS nach übergreifender Definition und ein verpflichtender Testfall nicht angemessen.  \n  **Einschränkung der übergreifenden MS-Definition:** Verfügt ein bestätigungsrelevantes System nicht über die Datenstruktur \n  zur Hinterlegung des Status einer Diagnose, so MUSS dieses System die Information NICHT abbilden. \n  Das System MUSS jedoch `clinicalStatus` befüllen, sofern die entsprechende Information verfügbar ist.  \n  **Hinweis:** Für Diagnosen aus der *ambulanten* Versorgung können die Werte für `clinicalStatus` und `verificationStatus` aus dem \n  [ICD-10-Zusatzkennzeichen für die Diagnosesicherheit](https://www.bfarm.de/DE/Kodiersysteme/Services/Kodierfragen/ICD-10-GM/Allgemeine-Kodierfragen/icd-10-gm-1010.html) abgeleitet werden.\n  Das entsprechende Mapping kann den [Deutschen Basisprofilen](https://simplifier.net/guide/leitfaden-de-basis-r4/ig-markdown-Ressourcen-DiagnosenCondition?version=current) entnommen werden." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Condition.verificationStatus" ] ;
       fhir:ElementDefinition.path [ fhir:value "Condition.verificationStatus" ] ;
       fhir:ElementDefinition.short [ fhir:value "Bestätigungsstatus" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Einschränkung der übergreifenden MS-Definition:** Die Implementierung dieses Elements ist für Server optional. Die Kennzeichnung als Must-Support erfolgt, da es sich um ein als Modifier-Element markiertes Feld in der Kernspezifikation handelt. Clients, die eine ISiKPatient-Instanz verarbeiten, SOLLEN den Wert dieses Elements vor der weiteren Verarbeitung prüfen.\n\n**WICHTIGER Hinweis für Implementierer:**  \n- Alle server-seitigen Implementierungen SOLLEN in der Lage sein, die systemintern möglichen Statuswerte korrekt in FHIR abzubilden, mindestens aber den Status 'confirmed'.\n- Alle client-seitigen Implementierungen SOLLEN in der Lage sein, sämtliche Status-Codes zu interpretieren und dem Anwender in angemessener Form darstellen zu können." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Condition.category" ] ;
       fhir:ElementDefinition.path [ fhir:value "Condition.category" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Hinweis EHDS:** Im Kontext des Alignments mit dem EHDS und den damit verbundenen Spezifikationen von HL7 Europe, weisen wir darauf hin, dass in der EPS das Element `category` mittels Obligation gefordert wird. Da Obligations im EU Kontext noch nicht final und stabil definiert sind, ergänzen wir kein MS in ISiK Stufe 6." ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Condition.severity" ] ;
       fhir:ElementDefinition.path [ fhir:value "Condition.severity" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Hinweis EHDS:** Im Kontext des Alignments mit dem EHDS und den damit verbundenen Spezifikationen von HL7 Europe, weisen wir darauf hin, dass in der EPS das Element `severity` mittels Obligation gefordert wird. Da Obligations im EU Kontext noch nicht final und stabil definiert sind, ergänzen wir kein MS in ISiK Stufe 6." ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Condition.code" ] ;
       fhir:ElementDefinition.path [ fhir:value "Condition.code" ] ;
       fhir:ElementDefinition.short [ fhir:value "Diagnose-Code" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Diagnosen SOLLEN mindestens entweder mit einem der angebenen standardisierten Codier-Verfahren codiert werden. \n  Ist keine Codierung möglich, MUSS statt dessen eine textuelle Beschreibung der Prozedur angegeben werden.  \n   **Begründung Pflichtfeld:** Ist *weder* eine Codierung *noch* eine textuelle Beschreibung vorhanden, besitzt diese Ressource keine medizinische Aussagefähigkeit." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.constraint [
         fhir:index -1 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "icd-text-1" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Entweder MUSS eine kodierte Diagnose vorliegen oder eine textuelle Beschreibung. Stattdessen nur Extensions hinzuzufügen (vgl. https://www.hl7.org/fhir/element.html - ele-1), ist explizit nicht erlaubt." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "coding.exists().not() implies text.exists()" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "https://gematik.de/fhir/isik/StructureDefinition/ISiKDiagnose" ;
           fhir:link <https://gematik.de/fhir/isik/StructureDefinition/ISiKDiagnose>
         ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Condition.code.coding" ] ;
       fhir:ElementDefinition.path [ fhir:value "Condition.code.coding" ] ;
       fhir:ElementDefinition.slicing [
         fhir:ElementDefinition.slicing.discriminator [
           fhir:index -1 ;
           fhir:ElementDefinition.slicing.discriminator.type [ fhir:value "pattern" ] ;
           fhir:ElementDefinition.slicing.discriminator.path [ fhir:value "$this" ]
         ] ;
         fhir:ElementDefinition.slicing.rules [ fhir:value "open" ]
       ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Hinweis EHDS:** In der HL7 Europe EPS und HDR Spezifikation ist ein Binding von Snomed-CT mit der Stärke preferred gesetzt. Dies schließt sich nicht mit der hier vorgenommenen Profilierung aus, und auch eine reine ICD-10 Abbildung spricht nicht gegen diese Anforderung. Allerdings möchten wir darauf hinweisen, dass es in Zukunft möglicherweise sinnvoll sein könnte, die Nutzung von SNOMED-CT Kodierung zur Darstellung einer Diagnose zu nutzen, um die Interoperabilität mit der EPS zu erhöhen." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Condition.code.coding:ICD-10-GM" ] ;
       fhir:ElementDefinition.path [ fhir:value "Condition.code.coding" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "ICD-10-GM" ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
