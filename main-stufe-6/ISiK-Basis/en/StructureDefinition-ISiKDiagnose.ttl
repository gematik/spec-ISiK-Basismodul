       fhir:ElementDefinition.path [ fhir:value "Condition.subject" ] ;
       fhir:ElementDefinition.short [ fhir:value "Patientenbezug" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung Must-Support:** Ein Patientenbezug der Diagnose MUSS stets zum Zwecke der Nachvollziehbarkeit und Datenintegrität vorliegen." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Condition.subject.reference" ] ;
       fhir:ElementDefinition.path [ fhir:value "Condition.subject.reference" ] ;
       fhir:ElementDefinition.short [ fhir:value "Patienten-Link" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung MS:** Die Verlinkung auf eine Patienten-Ressource dient der technischen Zuordnung der Dokumentation zu einem Patienten und ermöglicht wichtige API-Funktionen wie verkettete Suche, (Reverse-)Include etc.\nIm ISik Kontext MUSS die referenzierte Ressource konform zu [ISiKPatient](https://gematik.de/fhir/isik/StructureDefinition/ISiKPatient) sein.\nJenseits von ISiK KÖNNEN weitere Instanzen mit anderen Profilen referenziert werden." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
