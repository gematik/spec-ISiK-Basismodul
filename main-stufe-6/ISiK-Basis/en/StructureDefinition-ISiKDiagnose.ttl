         ]
       ] ;
       fhir:ElementDefinition.patternCoding [
         fhir:Coding.system [ fhir:value "http://fhir.de/CodeSystem/bfarm/icd-10-gm" ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Condition.code.coding:ICD-10-GM.extension:Mehrfachcodierungs-Kennzeichen" ] ;
       fhir:ElementDefinition.path [ fhir:value "Condition.code.coding.extension" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "Mehrfachcodierungs-Kennzeichen" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Condition.code.coding:ICD-10-GM.extension:Seitenlokalisation" ] ;
       fhir:ElementDefinition.path [ fhir:value "Condition.code.coding.extension" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "Seitenlokalisation" ] ;
       fhir:ElementDefinition.short [ fhir:value "Seitenlokalisation" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Begründung MS:** Bei ICD-10-codierten Diagnosen an paarigen Organen oder Körperteilen müssen die Zusatzkennzeichen für die Seitigkeit (R, L oder B) angeben werden.\n\n  **Hinweis EHDS:** Im Kontext des Alignments mit dem EHDS und den damit verbundenen Spezifikationen von HL7 Europe, wird für die Kodierung der Lateralität aktuell die Nutzung einer BodyStructure-Ressource inkl. einer Snomet-CT Kodierung diskutiert. Siehe [bodyStructure-eu-core](https://hl7.eu/fhir/base/StructureDefinition-bodyStructure-eu-core.html)." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "Condition.code.coding:ICD-10-GM.extension:Diagnosesicherheit" ] ;
       fhir:ElementDefinition.path [ fhir:value "Condition.code.coding.extension" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "Diagnosesicherheit" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
