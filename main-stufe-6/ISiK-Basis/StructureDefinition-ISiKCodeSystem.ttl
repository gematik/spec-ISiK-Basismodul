  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "CodeSystem" ] ;
       fhir:ElementDefinition.path [ fhir:value "CodeSystem" ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "CodeSystem.id" ] ;
       fhir:ElementDefinition.path [ fhir:value "CodeSystem.id" ] ;
       fhir:ElementDefinition.short [ fhir:value "serverseitige, interne ID des Datensatzes" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**bedingtes Pflichtfeld/bedingtes MS:** Alle von einem Server bereitgestellten Ressourcen MÜSSEN über eine `id` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `id`verfügen. " ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "CodeSystem.meta.versionId" ] ;
       fhir:ElementDefinition.path [ fhir:value "CodeSystem.meta.versionId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Eindeutiger Name der serverseitigen Version des Datensatzes" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Alle von einem Server bereitgestellten Ressourcen SOLLEN über eine `versionID` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `versionID`verfügen. " ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "CodeSystem.meta.lastUpdated" ] ;
       fhir:ElementDefinition.path [ fhir:value "CodeSystem.meta.lastUpdated" ] ;
       fhir:ElementDefinition.short [ fhir:value "Zeitpunkt der letzten Änderung" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Alle von einem Server bereitgestellten Ressourcen SOLLEN über ein `lastUpdate` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über ein `lastUpdate`verfügen. " ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "CodeSystem.implicitRules" ] ;
       fhir:ElementDefinition.path [ fhir:value "CodeSystem.implicitRules" ] ;
       fhir:ElementDefinition.short [ fhir:value "Verweis auf die Regeln, nach denen die Ressource erstellt wurde" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung Constraint: In ISiK existiert kein Use-Case für dieses Element. Da es sich um ein Modifying Element handelt, wird es daher ausgeschlossen.\n  Darüber hinaus werden die Regeln als URI vorgehalten. Dies führt dazu, dass sich hinter der URI eine beliebige Menge an Regeln befinden kann; wodurch  nicht sichergestellt werden kann, dass alle Clients die Regeln korrekt interpretieren können." ] ;
       fhir:ElementDefinition.max [ fhir:value "0" ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "CodeSystem.url" ] ;
       fhir:ElementDefinition.path [ fhir:value "CodeSystem.url" ] ;
       fhir:ElementDefinition.short [ fhir:value "Kanonische URL" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Bedeutung:** Eindeutige Url zur Identifizierung des CodeSystems. Absolute Url sind zu bevorzugen.  \n    **Hinweise:** OIDs SOLLTEN als weitere Identifier des CodeSystems verwendet werden. In jedem Fall SOLLTE eine Canonical Url vergeben werden." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 6 ;
       fhir:Element.id [ fhir:value "CodeSystem.version" ] ;
       fhir:ElementDefinition.path [ fhir:value "CodeSystem.version" ] ;
       fhir:ElementDefinition.short [ fhir:value "Version" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Bedeutung:** Version des CodeSystems  \n    **Hinweise:** Jede Änderung des CodeSystems MUSS eine Änderung in der Version des CodeSystems und gebundenen ValueSets nach sich ziehen. Die Versionierung SOLLTE auf dem Konzept von [Semantic Versioning](https://semver.org) basieren." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 7 ;
       fhir:Element.id [ fhir:value "CodeSystem.name" ] ;
       fhir:ElementDefinition.path [ fhir:value "CodeSystem.name" ] ;
       fhir:ElementDefinition.short [ fhir:value "Name des Codesystems" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Bedeutung:** Maschinenlesbarer Name des CodeSystems  \n    **Hinweise:** Der Constraint [cps-0](https://www.hl7.org/fhir/R4/codesystem.html#invs) ist hierbei zu beachten." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 8 ;
       fhir:Element.id [ fhir:value "CodeSystem.status" ] ;
       fhir:ElementDefinition.path [ fhir:value "CodeSystem.status" ] ;
       fhir:ElementDefinition.short [ fhir:value "Status" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Zeigt den aktuellen Status der Ressource an.     \n  **WICHTIGER Hinweis für Implementierer:**    \n  * Alle server-seitigen Implementierungen MÜSSEN in der Lage sein, \n  die systemintern möglichen Statuswerte korrekt in FHIR abzubilden, mindestens jedoch 'active' und 'retired''.\n  * Alle client-seitigen Implementierungen MÜSSEN in der Lage sein, sämtliche Status-Codes zu interpretieren und dem Anwender in angemessener Form darstellen zu können, \n  beispielsweise durch Ausblenden/Durchstreichen von Ressourcen mit dem status `entered-in-error` und Ausgrauen von Ressourcen, die einen Plan- oder Entwurfs-Status haben." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 9 ;
       fhir:Element.id [ fhir:value "CodeSystem.content" ] ;
       fhir:ElementDefinition.path [ fhir:value "CodeSystem.content" ] ;
       fhir:ElementDefinition.short [ fhir:value "Vollständigkeit der Repräsentation" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Bedeutung:** Angabe, ob es sich um eine vollständige Repräsentation des CodeSystems oder nur um einen Auszug handelt.\n    **Hinweise:** Alle in einem System möglichen Status-Werte müssen über FHIR korrekt repräsentiert werden können, mindestens jedoch die Status-Werte `fragment` und `complete`. Deren korrekte Abbildung wird im Rahmen des Bestätigungsverfahrens überprüft." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 10 ;
       fhir:Element.id [ fhir:value "CodeSystem.concept" ] ;
       fhir:ElementDefinition.path [ fhir:value "CodeSystem.concept" ] ;
       fhir:ElementDefinition.short [ fhir:value "Konzept" ] ;
       fhir:ElementDefinition.comment [ fhir:value "**Bedeutung:** Angabe der Konzepte, aus denen sich das CodeSystem zusammensetzt.  \n     **Hinweise:** Es MUSS mindestens ein Code und ein Anzeigetext spezifiziert werden." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 11 ;
       fhir:Element.id [ fhir:value "CodeSystem.concept.code" ] ;
       fhir:ElementDefinition.path [ fhir:value "CodeSystem.concept.code" ] ;
       fhir:ElementDefinition.short [ fhir:value "Code" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Der eindeutige Code, der das Konzept im CodeSystem identifiziert." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
