       fhir:ElementDefinition.path [ fhir:value "Device.meta.versionId" ] ;
       fhir:ElementDefinition.short [ fhir:value "Eindeutiger Name der serverseitigen Version des Datensatzes" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Alle von einem Server bereitgestellten Ressourcen SOLLEN über eine `versionID` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über eine `versionID`verfügen. " ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "Device.meta.lastUpdated" ] ;
       fhir:ElementDefinition.path [ fhir:value "Device.meta.lastUpdated" ] ;
       fhir:ElementDefinition.short [ fhir:value "Zeitpunkt der letzten Änderung" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Alle von einem Server bereitgestellten Ressourcen SOLLEN über ein `lastUpdate` verfügen.\n  Von Clients erzeugte Ressourcen, die im Kontext einer CREATE-Interaktion übermittelt werden, MÜSSEN NICHT über ein `lastUpdate`verfügen. " ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "Device.implicitRules" ] ;
       fhir:ElementDefinition.path [ fhir:value "Device.implicitRules" ] ;
       fhir:ElementDefinition.short [ fhir:value "Verweis auf die Regeln, nach denen die Ressource erstellt wurde" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung Constraint: In ISiK existiert kein Use-Case für dieses Element. Da es sich um ein Modifying Element handelt, wird es daher ausgeschlossen.\n  Darüber hinaus werden die Regeln als URI vorgehalten. Dies führt dazu, dass sich hinter der URI eine beliebige Menge an Regeln befinden kann; wodurch  nicht sichergestellt werden kann, dass alle Clients die Regeln korrekt interpretieren können." ] ;
       fhir:ElementDefinition.max [ fhir:value "0" ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "Device.status" ] ;
       fhir:ElementDefinition.path [ fhir:value "Device.status" ] ;
       fhir:ElementDefinition.short [ fhir:value "Status des Implantats" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung MS: Der Status gibt an, ob das Implantat aktuell im Körper des Patienten vorhanden ist oder nicht \n  und stellt somit eine überaus wichtige medizinische Information dar, die unmittelbar Einfluss auf Diagnostik, Therapieentscheidungen und zukünftige Behandlungsmaßnahmen haben kann. \n  Daher ist die Angabe des Status zwingend erforderlich." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 6 ;
       fhir:Element.id [ fhir:value "Device.type" ] ;
       fhir:ElementDefinition.path [ fhir:value "Device.type" ] ;
       fhir:ElementDefinition.short [ fhir:value "Art des Implantats" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung MS: Die Angabe der Art des Implantats ermöglicht eine eindeutige Identifikation und Klassifizierung des implantierten Medizinprodukts, \n  was für die Berücksichtigung implantatspezifischer Besonderheiten bei weiteren diagnostischen oder therapeutischen Maßnahmen von entscheidender Bedeutung ist. \n  Daher ist die Angabe der Art des Implantats zwingend erforderlich." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 7 ;
       fhir:Element.id [ fhir:value "Device.patient" ] ;
       fhir:ElementDefinition.path [ fhir:value "Device.patient" ] ;
       fhir:ElementDefinition.short [ fhir:value "Patient mit Implantat" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Begründung MS: Die Zuordnung zu einem Patient ist für den Datenaustausch im Rahmen von ISiK-Szenarien unerlässlich." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ]
  ] .

