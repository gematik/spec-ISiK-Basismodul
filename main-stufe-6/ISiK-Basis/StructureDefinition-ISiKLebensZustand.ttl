       fhir:Element.id [ fhir:value "Observation.category" ] ;
       fhir:ElementDefinition.path [ fhir:value "Observation.category" ] ;
       fhir:ElementDefinition.short [ fhir:value "Kategorie" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Bedeutung: Kategorie-Code, der die Untersuchung kategorisiert." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
