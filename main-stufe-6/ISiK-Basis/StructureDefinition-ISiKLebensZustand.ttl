       fhir:ElementDefinition.path [ fhir:value "Observation.code" ] ;
       fhir:ElementDefinition.short [ fhir:value "Code" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Bedeutung: Code, der die Untersuchung repräsentiert und kodiert." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
