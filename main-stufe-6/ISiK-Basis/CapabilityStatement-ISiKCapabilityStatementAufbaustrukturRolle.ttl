         ] ;
         fhir:CapabilityStatement.rest.resource.interaction.code [ fhir:value "read" ] ;
         fhir:CapabilityStatement.rest.resource.interaction.documentation [ fhir:value "Die Ressource `Organization` MUSS unterstützt werden, da sie notwendig ist zur Abbildung der Aufbaustruktur und insbesondere zur Ausgabe von Angaben zu Fachbereichen." ]
       ], [
