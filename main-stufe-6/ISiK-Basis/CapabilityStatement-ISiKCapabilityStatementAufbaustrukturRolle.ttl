           fhir:Extension.valueCode [ fhir:value "SHALL" ]
         ] ;
         fhir:CapabilityStatement.rest.resource.interaction.code [ fhir:value "search-type" ] ;
         fhir:CapabilityStatement.rest.resource.interaction.documentation [ fhir:value "Die REST-Interaktion `search` MUSS implementiert werden, um die Suche nach Organisationseinheiten, Fachbereichen und Stationen zu ermöglichen." ]
