     fhir:security [
       fhir:cors [ fhir:v true ] ;
       fhir:description [ fhir:v "Uses standard FHIR security" ]
     ] ;
     fhir:resource ( [
       fhir:type [ fhir:v "Patient" ] ;
       fhir:profile [
         fhir:v "http://example.org/fhir/test/StructureDefinition/test-patient"^^xsd:anyURI ;
         fhir:link <http://example.org/fhir/test/StructureDefinition/test-patient>
       ] ;
       fhir:documentation [ fhir:v "Patient resource with basic CRUD operations" ] ;
       fhir:interaction ( [
         fhir:code [ fhir:v "read" ] ;
         fhir:documentation [ fhir:v "Read a Patient resource" ]
       ] [
         fhir:code [ fhir:v "create" ] ;
         fhir:documentation [ fhir:v "Create a Patient resource" ]
       ] [
         fhir:code [ fhir:v "update" ] ;
         fhir:documentation [ fhir:v "Update a Patient resource" ]
       ] [
         fhir:code [ fhir:v "delete" ] ;
         fhir:documentation [ fhir:v "Delete a Patient resource" ]
       ] [
         fhir:code [ fhir:v "search-type" ] ;
         fhir:documentation [ fhir:v "Search for Patient resources" ]
       ] ) ;
       fhir:searchParam ( [
         fhir:name [ fhir:v "identifier" ] ;
         fhir:type [ fhir:v "token" ] ;
         fhir:documentation [ fhir:v "Search by patient identifier" ]
       ] [
         fhir:name [ fhir:v "name" ] ;
         fhir:type [ fhir:v "string" ] ;
         fhir:documentation [ fhir:v "Search by patient name" ]
       ] [
         fhir:name [ fhir:v "family" ] ;
         fhir:type [ fhir:v "string" ] ;
         fhir:documentation [ fhir:v "Search by patient family name" ]
       ] [
         fhir:name [ fhir:v "given" ] ;
         fhir:type [ fhir:v "string" ] ;
         fhir:documentation [ fhir:v "Search by patient given name" ]
       ] )
     ] )
  ] ) . # 

