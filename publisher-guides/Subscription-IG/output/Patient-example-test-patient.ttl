# - resource -------------------------------------------------------------------

<http://example.org/fhir/test-subscription-ig/Patient/example-test-patient> a fhir:Patient ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:id [ fhir:v "example-test-patient"] ; # 
  fhir:meta [
     fhir:profile ( [
       fhir:v "http://example.org/fhir/test-subscription-ig/StructureDefinition/test-patient"^^xsd:anyURI ;
       fhir:link <http://example.org/fhir/test-subscription-ig/StructureDefinition/test-patient>
     ] )
  ] ; # 
  fhir:text [
     fhir:status [ fhir:v "generated" ] ;
     fhir:div "<div xmlns=\"http://www.w3.org/1999/xhtml\"><p class=\"res-header-id\"><b>Generated Narrative: Patient example-test-patient</b></p><a name=\"example-test-patient\"> </a><a name=\"hcexample-test-patient\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\"/><p style=\"margin-bottom: 0px\">Profile: <a href=\"StructureDefinition-test-patient.html\">Test Patient Profile</a></p></div><p style=\"border: 1px #661aff solid; background-color: #e6e6ff; padding: 10px;\">TestGiven TestFamily  Unknown, DoB Unknown ( http://example.org/patient-ids#TEST-001)</p><hr/></div>"^^rdf:XMLLiteral
  ] ; # 
  fhir:identifier ( [
     fhir:system [ fhir:v "http://example.org/patient-ids"^^xsd:anyURI ] ;
     fhir:value [ fhir:v "TEST-001" ]
  ] ) ; # 
  fhir:name ( [
     fhir:family [ fhir:v "TestFamily" ] ;
     fhir:given ( [ fhir:v "TestGiven" ] )
  ] ) ; # 
  fhir:gender [ fhir:v "unknown"] . # 

